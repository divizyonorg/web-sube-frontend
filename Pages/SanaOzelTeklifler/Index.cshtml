@page
@model IndexModel
@{
    ViewData["Title"] = "Sana Özel Teklifler";
    ViewData["ActivePage"] = "Sana Özel Teklifler";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;700&display=swap" rel="stylesheet">
}

<div class="flex flex-col gap-6 text-[#101828] font-['Source_Sans_3',sans-serif]">


    <!-- Section header -->
    <header>
        <h1 class="m-0 font-bold text-[30px] leading-9 text-[#101828] font-['Manrope',sans-serif]">@Model.PageTitle</h1>
        <p class="mt-1 text-base leading-6 text-[#4A5565]">@Model.PageSubtitle</p>
    </header>

    <!-- Info banner -->
    <section class="flex gap-3 p-5 px-6 border border-[#FEE685] rounded-[14px] bg-gradient-to-r from-[#FFFBEB] to-[#FFF7ED]"
             aria-label="Bilgilendirme">
        <span class="flex-none mt-0.5" aria-hidden="true">
            <img src="/icons/orange/Vector.svg" width="24" height="24" alt="">
        </span>
        <div>
            <h3 class="m-0 mb-1 text-lg leading-7 font-semibold text-[#7B3306] font-['Manrope',sans-serif]">@Model.BannerTitle</h3>
            <p class="m-0 text-base leading-6 text-[#BB4D00]">@Model.BannerText</p>
        </div>
    </section>

    <!-- Offers -->
    <section class="flex flex-col gap-6" aria-label="Kredi teklifleri">

        @foreach (var offer in Model.Offers)
        {
            <article class="bg-white border-2 border-[#E5E7EB] rounded-2xl overflow-hidden transition-all duration-[250ms] hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-16px_rgba(16,24,40,0.18)]">
                <div class="@offer.GradientClass p-6 text-white">
                    <div class="flex justify-between items-start gap-6 mb-6">
                        <div>
                            <span class="inline-block px-3 py-1 rounded-full text-xs leading-4 font-medium bg-white/20">@offer.Badge</span>
                            <h3 class="mt-3.5 mb-1 font-bold text-2xl leading-8 font-['Manrope',sans-serif]">@offer.Title</h3>
                            <p class="m-0 text-base leading-6 text-white/90">@offer.Subtitle</p>
                        </div>
                        <img src="@offer.IconPath" width="32" height="32" class="opacity-80" alt="" aria-hidden="true">
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <div class="text-sm leading-5 mb-1 text-white/70">Kredi Tutarı</div>
                            <div class="text-xl leading-7 font-bold">@offer.Amount</div>
                        </div>
                        <div>
                            <div class="text-sm leading-5 mb-1 text-white/70">Faiz Oranı</div>
                            <div class="text-xl leading-7 font-bold">@offer.InterestRate</div>
                        </div>
                        <div>
                            <div class="text-sm leading-5 mb-1 text-white/70">Vade</div>
                            <div class="text-xl leading-7 font-bold">@offer.Term</div>
                        </div>
                    </div>
                </div>
                <div class="p-6 bg-[#F9FAFB] flex justify-between items-center gap-4 flex-wrap">
                    <span class="inline-flex items-center gap-2 text-[#4A5565] text-sm leading-5">
                        <img src="/icons/slate/clock.svg" width="16" height="16" alt="" aria-hidden="true">
                        @offer.Validity
                    </span>
                    <button type="button" asp-page="/Apply" asp-route-offerId="@offer.Id"
                        class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#0056B3] text-white rounded-[10px] text-base leading-6 font-medium border-0 cursor-pointer transition-[background-color,transform] duration-200 hover:bg-[#004794] active:scale-[.98]">
                        Başvur
                        <img src="/icons/white/arrow-right.svg" width="16" height="16" alt="" aria-hidden="true">
                    </button>
                </div>
            </article>
        }

    </section>
</div>
