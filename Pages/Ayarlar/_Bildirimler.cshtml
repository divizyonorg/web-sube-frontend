@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<div class="bg-white border border-[#DCE3FB] rounded-[14px] pt-7 px-[33px] pb-[33px] font-[Poppins]">

    <p class="font-[Manrope] font-bold text-[20px] text-[#101828] mb-6">Bildirim Tercihleri</p>

    <div class="flex flex-col gap-3">

        @* E-posta Bildirimleri *@
        <div class="bg-[#F9FAFB] rounded-[10px] min-h-[80px] flex items-center justify-between px-6 gap-4 max-sm:px-4">
            <div>
                <p class="font-[Manrope] font-semibold text-[14px] text-[#1A1A2E] mb-1">E-posta Bildirimleri</p>
                <p class="font-[Source_Sans_3] text-[13px] text-[#7A94B8]">Önemli güncellemeler e-posta ile gönderilir</p>
            </div>
            <button type="button"
                    @@click="emailOn = !emailOn"
                    :class="emailOn ? 'bg-[#0056B3]' : 'bg-[#D1D5DC]'"
                    class="w-12 h-6 rounded-full border-0 cursor-pointer relative transition-colors duration-200 shrink-0 outline-none">
                <span class="absolute top-[4px] w-4 h-4 rounded-full bg-white shadow-sm pointer-events-none transition-all duration-200"
                      :class="emailOn ? 'left-[28px]' : 'left-[4px]'"></span>
            </button>
        </div>

        @* SMS Bildirimleri *@
        <div class="bg-[#F9FAFB] rounded-[10px] min-h-[80px] flex items-center justify-between px-6 gap-4 max-sm:px-4">
            <div>
                <p class="font-[Manrope] font-semibold text-[14px] text-[#1A1A2E] mb-1">SMS Bildirimleri</p>
                <p class="font-[Source_Sans_3] text-[13px] text-[#7A94B8]">Ödeme hatırlatmaları SMS ile gönderilir</p>
            </div>
            <button type="button"
                    @@click="smsOn = !smsOn"
                    :class="smsOn ? 'bg-[#0056B3]' : 'bg-[#D1D5DC]'"
                    class="w-12 h-6 rounded-full border-0 cursor-pointer relative transition-colors duration-200 shrink-0 outline-none">
                <span class="absolute top-[4px] w-4 h-4 rounded-full bg-white shadow-sm pointer-events-none transition-all duration-200"
                      :class="smsOn ? 'left-[28px]' : 'left-[4px]'"></span>
            </button>
        </div>

        @* Mobil Bildirimler *@
        <div class="bg-[#F9FAFB] rounded-[10px] min-h-[80px] flex items-center justify-between px-6 gap-4 max-sm:px-4">
            <div>
                <p class="font-[Manrope] font-semibold text-[14px] text-[#1A1A2E] mb-1">Mobil Bildirimler</p>
                <p class="font-[Source_Sans_3] text-[13px] text-[#7A94B8]">Mobil uygulamadan anlık bildirimler</p>
            </div>
            <button type="button"
                    @@click="mobileOn = !mobileOn"
                    :class="mobileOn ? 'bg-[#0056B3]' : 'bg-[#D1D5DC]'"
                    class="w-12 h-6 rounded-full border-0 cursor-pointer relative transition-colors duration-200 shrink-0 outline-none">
                <span class="absolute top-[4px] w-4 h-4 rounded-full bg-white shadow-sm pointer-events-none transition-all duration-200"
                      :class="mobileOn ? 'left-[28px]' : 'left-[4px]'"></span>
            </button>
        </div>

        @* Pazarlama İletişimi *@
        <div class="bg-[#F9FAFB] rounded-[10px] min-h-[80px] flex items-center justify-between px-6 gap-4 max-sm:px-4">
            <div>
                <p class="font-[Manrope] font-semibold text-[14px] text-[#1A1A2E] mb-1">Pazarlama İletişimi</p>
                <p class="font-[Source_Sans_3] text-[13px] text-[#7A94B8]">Kampanya ve tekliflerden haberdar olun</p>
            </div>
            <button type="button"
                    @@click="pazarlamaOn = !pazarlamaOn"
                    :class="pazarlamaOn ? 'bg-[#0056B3]' : 'bg-[#D1D5DC]'"
                    class="w-12 h-6 rounded-full border-0 cursor-pointer relative transition-colors duration-200 shrink-0 outline-none">
                <span class="absolute top-[4px] w-4 h-4 rounded-full bg-white shadow-sm pointer-events-none transition-all duration-200"
                      :class="pazarlamaOn ? 'left-[28px]' : 'left-[4px]'"></span>
            </button>
        </div>

    </div>

    @* Kaydet *@
    <div class="mt-7">
        <button type="button"
                class="flex items-center gap-2 h-12 bg-[#0056B3] text-white border-0 rounded-[10px] px-5 text-[15px] font-medium cursor-pointer transition-colors hover:bg-[#003F75]">
            <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
            Kaydet
        </button>
    </div>

</div>
