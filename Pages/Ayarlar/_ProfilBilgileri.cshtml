@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[33px] font-[Poppins]"
     x-data="profilBilgileriForm()">

    <p class="font-[Poppins] font-bold text-[20px] text-[#101828] mb-5">Profil Bilgileri</p>

    <form x-ref="form" method="post" asp-page-handler="UpdateContact">
        @Html.AntiForgeryToken()

        <div class="flex flex-col gap-4">

            @* Ad Soyad — salt okunur *@
            <div>
                <label class="block font-[Poppins] font-medium text-[16px] text-[#364153] mb-2">Ad Soyad</label>
                <div class="border border-[#D1D5DC] rounded-[10px] bg-[#F9FAFB] h-[50px] flex items-center gap-3 px-[15px] pr-4">
                    <img src="~/icons/gray/user-01.svg" width="20" height="20" alt="" class="shrink-0">
                    <input type="text"
                           value="@Model.Settings.Profil.FullName"
                           readonly
                           class="flex-1 bg-transparent outline-none border-0 font-[Poppins] text-[16px] text-[#6B7280] cursor-default" />
                </div>
            </div>

            @* E-posta *@
            <div>
                <label class="block font-[Poppins] font-medium text-[16px] text-[#364153] mb-2">E-posta</label>
                <div x-data="{ focused: false }"
                     :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                     class="border rounded-[10px] bg-white transition-colors h-[50px] flex items-center gap-3 px-[15px] pr-4">
                    <img src="~/icons/gray/mail-01.svg" width="20" height="20" alt="" class="shrink-0">
                    <input type="email"
                           name="ProfilEmail"
                           value="@Model.Settings.Profil.Email"
                           @@focus="focused = true" @@blur="focused = false"
                           class="flex-1 bg-transparent outline-none border-0 font-[Poppins] text-[16px] text-[#0A0A0A]" />
                </div>
            </div>

            @* Telefon *@
            <div>
                <label class="block font-[Poppins] font-medium text-[16px] text-[#364153] mb-2">Telefon</label>
                <div x-data="{ focused: false }"
                     :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                     class="border rounded-[10px] bg-white transition-colors h-[50px] flex items-center gap-3 px-[15px] pr-4">
                    <img src="~/icons/gray/phone.svg" width="20" height="20" alt="" class="shrink-0">
                    <input type="tel"
                           id="profilGsmInput"
                           name="ProfilGsm"
                           value="@Model.Settings.Profil.Phone"
                           @@focus="focused = true" @@blur="focused = false"
                           class="flex-1 bg-transparent outline-none border-0 font-[Poppins] text-[16px] text-[#0A0A0A]" />
                </div>
            </div>

        </div>

        @* Kaydet *@
        <div class="mt-5">
            <button type="button"
                    :disabled="submitting"
                    x-on:click="submit()"
                    class="flex items-center gap-2 h-12 bg-[#0056B3] text-white border-0 rounded-[10px] px-5 font-[Poppins] font-medium text-[16px] cursor-pointer transition-colors hover:bg-[#003F75] disabled:opacity-60 disabled:cursor-not-allowed">
                <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
                Kaydet
            </button>
        </div>

    </form>

</div>

<script>
    function profilBilgileriForm() {
        return {
            submitting: false,

            init() {
                var el = document.getElementById('profilGsmInput');
                if (!el) return;
                var digits = el.value.replace(/\D/g, '');
                if (digits.length === 10) digits = '0' + digits;
                var mask = IMask(el, { mask: '0000 000 00 00' });
                mask.unmaskedValue = digits;
            },

            async submit() {
                this.submitting = true;
                try {
                    const form = this.$refs.form;
                    const resp = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form)
                    });
                    const result = await resp.json();
                    if (result.success) toast.success('Profil bilgileri güncellendi.');
                    else toast.error('Güncelleme başarısız, lütfen tekrar deneyin.');
                } catch {
                    toast.error('Bir hata oluştu, lütfen tekrar deneyin.');
                } finally {
                    this.submitting = false;
                }
            }
        };
    }
</script>
