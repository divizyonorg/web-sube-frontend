@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<style>
    @@media (max-width: 480px) {
        .profil-card { padding: 16px !important; }
    }
</style>

<div class="profil-card bg-white border border-gray-200 rounded-2xl p-6">

    <p class="text-[18px] text-[#1A1A2E]" style="font-family:'Poppins'; font-weight:700; margin-bottom:20px;">Profil Bilgileri</p>

    <div style="display:flex; flex-direction:column; gap:16px;">

        @* Ad Soyad *@
        <div>
            <label style="display:block; font-size:13px; font-weight:500; color:#374151; margin-bottom:8px; font-family:'Poppins';">Ad Soyad</label>
            <div x-data="{ focused: false }"
                 :class="focused ? 'border-[#0056B3]' : 'border-gray-200'"
                 class="border rounded-[10px] bg-white transition-colors"
                 style="height:50px; display:flex; align-items:center; gap:12px; padding-left:15px; padding-right:16px;">
                <img src="~/icons/gray/user-01.svg" width="20" height="20" alt="" style="flex-shrink:0;">
                <input type="text"
                       @@focus="focused = true" @@blur="focused = false"
                       style="flex:1; background:transparent; outline:none; border:none; font-family:'Poppins'; font-size:14px; color:#1F2937;" />
            </div>
        </div>

        @* E-posta *@
        <div>
            <label style="display:block; font-size:13px; font-weight:500; color:#374151; margin-bottom:8px; font-family:'Poppins';">E-posta</label>
            <div x-data="{ focused: false }"
                 :class="focused ? 'border-[#0056B3]' : 'border-gray-200'"
                 class="border rounded-[10px] bg-white transition-colors"
                 style="height:50px; display:flex; align-items:center; gap:12px; padding-left:15px; padding-right:16px;">
                <img src="~/icons/gray/mail-01.svg" width="20" height="20" alt="" style="flex-shrink:0;">
                <input type="email"
                       @@focus="focused = true" @@blur="focused = false"
                       style="flex:1; background:transparent; outline:none; border:none; font-family:'Poppins'; font-size:14px; color:#1F2937;" />
            </div>
        </div>

        @* Telefon *@
        <div>
            <label style="display:block; font-size:13px; font-weight:500; color:#374151; margin-bottom:8px; font-family:'Poppins';">Telefon</label>
            <div x-data="{ focused: false }"
                 :class="focused ? 'border-[#0056B3]' : 'border-gray-200'"
                 class="border rounded-[10px] bg-white transition-colors"
                 style="height:50px; display:flex; align-items:center; gap:12px; padding-left:15px; padding-right:16px;">
                <img src="~/icons/gray/phone.svg" width="20" height="20" alt="" style="flex-shrink:0;">
                <input type="tel"
                       @@focus="focused = true" @@blur="focused = false"
                       style="flex:1; background:transparent; outline:none; border:none; font-family:'Poppins'; font-size:14px; color:#1F2937;" />
            </div>
        </div>

    </div>

    @* Kaydet butonu *@
    <div style="margin-top:20px;">
        <button type="button"
                style="display:flex; align-items:center; gap:8px; height:44px; background:#0056B3; color:white; border:none; border-radius:10px; padding:0 20px; font-family:'Poppins'; font-size:15px; font-weight:500; cursor:pointer;"
                onmouseover="this.style.background='#003F75'" onmouseout="this.style.background='#0056B3'">
            <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
            Kaydet
        </button>
    </div>

</div>
