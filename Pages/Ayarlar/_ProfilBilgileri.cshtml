@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[33px] font-[Poppins]">

    <p class="font-[Manrope] font-bold text-[20px] text-[#101828] mb-5">Profil Bilgileri</p>

    <form id="profil-form" method="post" asp-page-handler="UpdateContact">
        @Html.AntiForgeryToken()

        <div class="flex flex-col gap-4">

            @* Ad Soyad — salt okunur *@
            <div>
                <label class="block font-[Source_Sans_3] font-medium text-[16px] text-[#364153] mb-2">Ad Soyad</label>
                <div class="border border-[#D1D5DC] rounded-[10px] bg-[#F9FAFB] h-[50px] flex items-center gap-3 px-[15px] pr-4">
                    <img src="~/icons/gray/user-01.svg" width="20" height="20" alt="" class="shrink-0">
                    <input type="text"
                           value="@Model.Settings.Profil.FullName"
                           readonly
                           class="flex-1 bg-transparent outline-none border-0 font-[Source_Sans_3] text-[16px] text-[#6B7280] cursor-default" />
                </div>
            </div>

            @* E-posta *@
            <div>
                <label class="block font-[Source_Sans_3] font-medium text-[16px] text-[#364153] mb-2">E-posta</label>
                <div x-data="{ focused: false }"
                     :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                     class="border rounded-[10px] bg-white transition-colors h-[50px] flex items-center gap-3 px-[15px] pr-4">
                    <img src="~/icons/gray/mail-01.svg" width="20" height="20" alt="" class="shrink-0">
                    <input type="email"
                           name="ProfilEmail"
                           value="@Model.Settings.Profil.Email"
                           @@focus="focused = true" @@blur="focused = false"
                           class="flex-1 bg-transparent outline-none border-0 font-[Source_Sans_3] text-[16px] text-[#0A0A0A]" />
                </div>
            </div>

            @* Telefon *@
            <div>
                <label class="block font-[Source_Sans_3] font-medium text-[16px] text-[#364153] mb-2">Telefon</label>
                <div x-data="{ focused: false }"
                     :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                     class="border rounded-[10px] bg-white transition-colors h-[50px] flex items-center gap-3 px-[15px] pr-4">
                    <img src="~/icons/gray/phone.svg" width="20" height="20" alt="" class="shrink-0">
                    <input type="tel"
                           name="ProfilGsm"
                           value="@Model.Settings.Profil.Phone"
                           @@focus="focused = true" @@blur="focused = false"
                           class="flex-1 bg-transparent outline-none border-0 font-[Source_Sans_3] text-[16px] text-[#0A0A0A]" />
                </div>
            </div>

        </div>

        @* Kaydet *@
        <div class="mt-5">
            <button type="submit"
                    id="profil-kaydet-btn"
                    class="flex items-center gap-2 h-12 bg-[#0056B3] text-white border-0 rounded-[10px] px-5 font-[Source_Sans_3] font-medium text-[16px] cursor-pointer transition-colors hover:bg-[#003F75] disabled:opacity-60 disabled:cursor-not-allowed">
                <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
                Kaydet
            </button>
        </div>

    </form>

</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<script src="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.js"></script>

<script>
    document.getElementById('profil-form').addEventListener('submit', async function (e) {
        e.preventDefault();

        const btn = document.getElementById('profil-kaydet-btn');
        btn.disabled = true;

        try {
            const resp = await fetch(e.target.action, {
                method: 'POST',
                body: new FormData(e.target)
            });

            const result = await resp.json();

            if (result.success) {
                Toastify({
                    text: "Profil bilgileri güncellendi.",
                    duration: 3000,
                    gravity: "top",
                    position: "right",
                    style: { background: "#22c55e" }
                }).showToast();
            } else {
                Toastify({
                    text: "Güncelleme başarısız, lütfen tekrar deneyin.",
                    duration: 3000,
                    gravity: "top",
                    position: "right",
                    style: { background: "#ef4444" }
                }).showToast();
            }
        } catch {
            Toastify({
                text: "Bir hata oluştu, lütfen tekrar deneyin.",
                duration: 3000,
                gravity: "top",
                position: "right",
                style: { background: "#ef4444" }
            }).showToast();
        } finally {
            btn.disabled = false;
        }
    });
</script>
