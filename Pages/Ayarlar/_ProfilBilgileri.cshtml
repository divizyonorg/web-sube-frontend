@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[33px] font-[Poppins]">

    <p class="font-[Manrope] font-bold text-[20px] text-[#101828] mb-5">Profil Bilgileri</p>

    <div class="flex flex-col gap-4">

        @* Ad Soyad *@
        <div>
            <label class="block font-[Source_Sans_3] font-medium text-[16px] text-[#364153] mb-2">Ad Soyad</label>
            <div x-data="{ focused: false }"
                 :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                 class="border rounded-[10px] bg-white transition-colors h-[50px] flex items-center gap-3 px-[15px] pr-4">
                <img src="~/icons/gray/user-01.svg" width="20" height="20" alt="" class="shrink-0">
                <input type="text"
                       @@focus="focused = true" @@blur="focused = false"
                       class="flex-1 bg-transparent outline-none border-0 font-[Source_Sans_3] text-[16px] text-[#0A0A0A]" />
            </div>
        </div>

        @* E-posta *@
        <div>
            <label class="block font-[Source_Sans_3] font-medium text-[16px] text-[#364153] mb-2">E-posta</label>
            <div x-data="{ focused: false }"
                 :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                 class="border rounded-[10px] bg-white transition-colors h-[50px] flex items-center gap-3 px-[15px] pr-4">
                <img src="~/icons/gray/mail-01.svg" width="20" height="20" alt="" class="shrink-0">
                <input type="email"
                       @@focus="focused = true" @@blur="focused = false"
                       class="flex-1 bg-transparent outline-none border-0 font-[Source_Sans_3] text-[16px] text-[#0A0A0A]" />
            </div>
        </div>

        @* Telefon *@
        <div>
            <label class="block font-[Source_Sans_3] font-medium text-[16px] text-[#364153] mb-2">Telefon</label>
            <div x-data="{ focused: false }"
                 :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                 class="border rounded-[10px] bg-white transition-colors h-[50px] flex items-center gap-3 px-[15px] pr-4">
                <img src="~/icons/gray/phone.svg" width="20" height="20" alt="" class="shrink-0">
                <input type="tel"
                       @@focus="focused = true" @@blur="focused = false"
                       class="flex-1 bg-transparent outline-none border-0 font-[Source_Sans_3] text-[16px] text-[#0A0A0A]" />
            </div>
        </div>

    </div>

    @* Kaydet *@
    <div class="mt-5">
        <button type="button"
                class="flex items-center gap-2 h-12 bg-[#0056B3] text-white border-0 rounded-[10px] px-5 font-[Source_Sans_3] font-medium text-[16px] cursor-pointer transition-colors hover:bg-[#003F75]">
            <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
            Kaydet
        </button>
    </div>

</div>
