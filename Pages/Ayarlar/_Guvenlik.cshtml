@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@* ── Dış beyaz card ──────────────────────────────────────────── *@
<div class="bg-white border border-[#E5E7EB] rounded-[14px] pt-[33px] px-[33px] pb-[1px] flex flex-col gap-6 font-[Poppins]">

    <p class="font-[Manrope] font-bold text-[20px] text-[#101828]">Güvenlik Ayarları</p>

    @* ── SMS OTP Kartı ───────────────────────────────────────────── *@
    <div class="bg-gradient-to-br from-[#E6F7FF] to-[#F0F8FF] border border-[#DCE3FB] rounded-[14px] p-5 flex items-center gap-4 min-h-[110px]">

        <div class="w-14 h-14 shrink-0 rounded-full bg-gradient-to-br from-[#2E6DF8] to-[#0056B3] flex items-center justify-center">
            <img src="~/icons/white/phone-01.svg" width="26" height="26" alt="">
        </div>

        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2.5 flex-wrap mb-1.5">
                <span class="font-[Poppins] font-semibold text-[16px] text-[#003F75]">SMS OTP ile Giriş Aktif</span>
                <span class="bg-[#0056B3] text-white text-[12px] font-semibold px-3 py-[3px] rounded-full">Aktif</span>
            </div>
            <p class="font-[Poppins] text-[14px] text-[#4A5565] leading-[1.6]">
                Hesabınıza her girişte kayıtlı cep telefonunuza
                (<strong>@Model.Settings.OtpPhone</strong>) tek kullanımlık doğrulama kodu gönderilmektedir.
            </p>
        </div>
    </div>

    @* ── İki Bilgi Kartı ─────────────────────────────────────────── *@
    <div class="grid grid-cols-2 gap-4 max-sm:grid-cols-1">

        @* Güvenli Doğrulama *@
        <div class="bg-[#F0FDF4] border border-[#B9F8CF] rounded-[14px] p-[18px] min-h-[90px] flex flex-col justify-center">
            <div class="flex items-center gap-2.5 mb-1.5">
                <img src="~/icons/green/check-circle.svg" width="22" height="22" alt="" class="shrink-0">
                <span class="font-[Source_Sans_3] font-semibold text-[14px] text-[#0D542B]">Güvenli Doğrulama</span>
            </div>
            <p class="font-[Source_Sans_3] text-[12px] text-[#008236] leading-[1.5] pl-8">
                Her giriş benzersiz bir OTP kodu ile doğrulanır.
            </p>
        </div>

        @* Şifresiz Erişim *@
        <div class="bg-[#EFF6FF] border border-[#BEDBFF] rounded-[14px] p-[18px] min-h-[90px] flex flex-col justify-center">
            <div class="flex items-center gap-2.5 mb-1.5">
                <img src="~/icons/blue/lock-02.svg" width="22" height="22" alt="" class="shrink-0">
                <span class="font-[Source_Sans_3] font-semibold text-[14px] text-[#1C398E]">Şifresiz Erişim</span>
            </div>
            <p class="font-[Source_Sans_3] text-[12px] text-[#1447E6] leading-[1.5] pl-8">
                Sisteminizde şifre tutulmaz, oltalama saldırılarına karşı maksimum koruma.
            </p>
        </div>

    </div>

    @* ── OTP Numarasını Güncelle ─────────────────────────────────── *@
    <div class="bg-white border border-[#E5E7EB] rounded-[14px] p-6 min-h-[159px]">

        <p class="font-[Poppins] font-semibold text-[18px] text-[#101828] mb-4">OTP Numarasını Güncelle</p>

        <div class="flex gap-3 items-center max-sm:flex-col max-sm:items-stretch">

            <div x-data="{ focused: false }"
                 :class="focused ? 'border-[#0056B3]' : 'border-[#D1D5DC]'"
                 class="border rounded-[10px] bg-white transition-colors flex-1 h-[50px] flex items-center gap-3 pl-[15px] pr-4">
                <img src="~/icons/gray/phone.svg" width="20" height="20" alt="" class="shrink-0">
                <input id="otpPhoneInput"
                       type="text"
                       value="@Model.Settings.OtpPhone"
                       @@focus="focused = true" @@blur="focused = false"
                       class="flex-1 bg-transparent outline-none border-0 font-[Poppins] text-[14px] text-[#1F2937]" />
            </div>

            <button type="button"
                    onclick="guncelleTelefonuOnayla()"
                    class="flex items-center gap-2 h-[50px] whitespace-nowrap bg-gradient-to-r from-[#0056B3] to-[#2E6DF8] text-white border-0 rounded-[10px] px-[22px] font-[Poppins] text-[14px] font-medium cursor-pointer transition-opacity hover:opacity-90 max-sm:w-full max-sm:justify-center">
                <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
                Güncelle
            </button>

        </div>

        <p class="font-[Source_Sans_3] text-[12px] text-[#6A7282] mt-2.5 leading-[1.5]">
            Numara değişikliği için mevcut telefondan doğrulama kodu gönderilecektir.
        </p>

    </div>

</div>

<script>
    IMask(document.getElementById('otpPhoneInput'), {
        mask: '0(000) 000 00 00'
    });

    function guncelleTelefonuOnayla() {
        const yeniNo = document.getElementById('otpPhoneInput').value;
        if (!yeniNo || yeniNo.replace(/\D/g, '').length < 10) {
            Swal.fire({ icon: 'warning', title: 'Geçersiz numara', text: 'Lütfen geçerli bir telefon numarası giriniz.', confirmButtonColor: '#0056B3' });
            return;
        }

        Swal.fire({
            title: 'SMS Doğrulama',
            html: `
                <p style="font-family:'Poppins'; font-size:13px; color:#374151; margin-bottom:14px;">
                    Mevcut telefonunuza doğrulama kodu gönderildi.<br>Kodu aşağıya giriniz.
                </p>
                <input id="swalOtpInput" maxlength="6" placeholder="- - - - - -"
                       style="width:100%; text-align:center; font-family:'Poppins'; font-size:22px;
                              letter-spacing:10px; border:1.5px solid #E5E7EB; border-radius:10px;
                              padding:10px 0; outline:none;"
                       oninput="this.value=this.value.replace(/\D/g,'').slice(0,6)"
                       onfocus="this.style.borderColor='#0056B3'" onblur="this.style.borderColor='#E5E7EB'"/>`,
            confirmButtonText: 'Doğrula',
            confirmButtonColor: '#0056B3',
            cancelButtonText: 'İptal',
            showCancelButton: true,
            focusConfirm: false,
            preConfirm: () => {
                const kod = document.getElementById('swalOtpInput').value;
                if (!kod || kod.length < 6) {
                    Swal.showValidationMessage('6 haneli kodu eksiksiz giriniz.');
                    return false;
                }
                return kod;
            }
        }).then(result => {
            if (!result.isConfirmed) return;
            Swal.fire({
                icon: 'success',
                title: 'Numara güncellendi',
                text: 'OTP telefon numaranız başarıyla güncellendi.',
                confirmButtonColor: '#0056B3',
                timer: 3000,
                timerProgressBar: true
            });
        });
    }
</script>
