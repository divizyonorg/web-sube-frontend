@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<script src="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.js"></script>

<div x-data='finansalProfilForm(
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Settings.MaritalStatus)),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        calisma  = Model.CalismaDurumu.SelectedValue  ?? "",
        sektor   = Model.CalismaSektoru.SelectedValue ?? "",
        meslekId = Model.Meslek.SelectedValue         ?? "",
        suresi   = Model.CalismaSuresi.SelectedValue  ?? ""
    }))
)'>

@Html.AntiForgeryToken()

@* Panel başlığı + Düzey göstergeleri *@
<div class="flex justify-between items-start mb-5 max-[480px]:flex-col max-[480px]:gap-2.5">
    <div>
        <h2 class="font-[Poppins] font-bold text-[20px] text-[#101828] mb-1">Finansal Profil</h2>
        <p class="font-[Poppins] text-[14px] text-[#6A7282]">
            Mesleki, finansal ve demografik bilgilerinizi güncelleyin.
        </p>
    </div>
    <div class="shrink-0 pt-1 max-[480px]:pt-0">
        <div class="flex items-center gap-3 bg-[#F0F6FF] border border-[#D1DDF5] rounded-[10px] px-3 py-2">
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-[#2E6DF8] shrink-0"></div>
                <span class="font-[Poppins] font-medium text-[10px] leading-[15px] text-[#2E6DF8]">Düzey 1</span>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-[#37B8C7] shrink-0"></div>
                <span class="font-[Poppins] font-medium text-[10px] leading-[15px] text-[#37B8C7]">Düzey 2</span>
            </div>
        </div>
    </div>
</div>

@* İki Kart *@
<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">

    @* Kart 1: Mesleki ve Finansal Durum *@
    <div class="bg-white border border-[#E2EAF5] rounded-[12px] p-5 shadow-[0_2px_12px_rgba(0,86,179,0.07)]">

        <div class="flex items-center gap-3 -mx-5 -mt-5 mb-4 px-5 py-[14px] bg-gradient-to-br from-[#F0F6FF] to-[#FAFCFF] rounded-t-[12px] border-b border-[#E2EAF5]">
            <div class="w-9 h-9 shrink-0 bg-gradient-to-br from-[#0056B3] to-[#2E6DF8] rounded-[8px] flex items-center justify-center">
                <img src="~/icons/white/briefcase-02.svg" width="20" height="20" alt="">
            </div>
            <div>
                <div class="font-[Poppins] font-bold text-[15px] text-[#003F75]">Mesleki ve Finansal Durum</div>
                <div class="font-[Poppins] text-[11px] text-[#739FCC]">Çalışma bilgileri</div>
            </div>
        </div>

        <div class="mb-2.5">
            <partial name="~/Partials/Components/_Select.cshtml" model="Model.CalismaDurumu" />
        </div>

        <div class="flex justify-end mb-2.5">
            <span class="inline-flex items-center gap-1.5 border border-dashed border-[#2E6DF8]/40 rounded-full px-2.5 py-[3px]">
                <div class="w-1.5 h-1.5 rounded-full bg-[#2E6DF8] shrink-0"></div>
                <span class="font-[Poppins] text-[10px] text-[#2E6DF8] italic">Seçime göre alanlar gösterilir</span>
            </span>
        </div>

        <div x-show="calisma === 'calisiyor'" x-cloak
             class="border-l-2 border-[#2E6DF8] flex flex-col gap-3">
            <div class="relative pl-[14px]">
                <div class="absolute left-0 top-[7px] w-2.5 h-0.5 bg-[#2E6DF8]"></div>
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.CalismaSektoru" />
            </div>
            <div class="pl-[14px]">
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.Meslek" />
            </div>
            <div class="pl-[14px]">
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.CalismaSuresi" />
            </div>
            <div class="pl-[14px]">
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.MaasBankasi" />
            </div>
        </div>

    </div>

    @* Kart 2: Demografik Durum *@
    <div class="bg-white border border-[#E2EAF5] rounded-[12px] p-5 shadow-[0_2px_12px_rgba(0,86,179,0.07)]">

        <div class="flex items-center gap-3 -mx-5 -mt-5 mb-4 px-5 py-[14px] bg-gradient-to-br from-[#F0F6FF] to-[#FAFCFF] rounded-t-[12px] border-b border-[#E2EAF5]">
            <div class="w-9 h-9 shrink-0 bg-gradient-to-br from-[#0056B3] to-[#37B8C7] rounded-[8px] flex items-center justify-center">
                <img src="~/icons/white/users-01.svg" width="20" height="20" alt="">
            </div>
            <div>
                <div class="font-[Poppins] font-bold text-[15px] text-[#003F75]">Demografik Durum</div>
                <div class="font-[Poppins] text-[11px] text-[#739FCC]">Medeni hal ve aile bilgileri</div>
            </div>
        </div>

        <div class="mb-2.5">
            <partial name="~/Partials/Components/_Select.cshtml" model="Model.MedeniHal" />
        </div>

        <div class="flex justify-end mb-2.5">
            <span class="inline-flex items-center gap-1.5 border border-dashed border-[#2E6DF8]/40 rounded-full px-2.5 py-[3px]">
                <div class="w-1.5 h-1.5 rounded-full bg-[#2E6DF8] shrink-0"></div>
                <span class="font-[Poppins] text-[10px] text-[#2E6DF8] italic">Seçime göre alanlar gösterilir</span>
            </span>
        </div>

        <div x-show="medeni === 'true'"
             class="border-l-2 border-[#2E6DF8] flex flex-col gap-6">

            <div class="relative pl-[14px] pb-1">
                <div class="absolute left-0 top-[7px] w-2.5 h-0.5 bg-[#2E6DF8]"></div>
                <label class="block font-[Poppins] text-[11px] font-medium text-[#739FCC] uppercase tracking-[0.08em] mb-2.5">
                    EŞ ÇALIŞIYOR MU?
                </label>
                <div @@change="esCalisiyor = $event.target.value">
                    <partial name="~/Partials/Components/_Radio.cshtml" model="Model.EsCalisiyor" />
                </div>
            </div>

            <div x-show="esCalisiyor === 'evet'" class="ml-[50px]">
                <div class="border-l-2 border-[#37B8C7]">
                    <div class="relative pl-[14px]">
                        <div class="absolute left-0 top-[7px] w-2.5 h-0.5 bg-[#37B8C7]"></div>
                        <label class="block font-[Poppins] text-[11px] font-medium text-[#739FCC] uppercase tracking-[0.08em] mb-1.5">
                            EŞİN AYLIK GELİRİ
                        </label>
                        <div class="relative">
                            <input type="number" placeholder="0"
                                   x-model="esGeliri"
                                   class="w-full py-2.5 pl-3 pr-9 border border-[#B0CAED] rounded-[8px] font-[Poppins] font-semibold text-[14px] text-[rgba(0,63,117,0.5)] bg-white outline-none transition-colors focus:border-[#0056B3]" />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 font-[Poppins] text-[13px] text-[#739FCC] pointer-events-none">₺</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@* Progressive Disclosure bilgi kutusu *@
<div class="mt-5 bg-[rgba(46,109,248,0.05)] border border-[rgba(46,109,248,0.15)] rounded-[12px] p-[14px] flex gap-2.5 items-start">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-[1px]">
        <circle cx="8" cy="8" r="7" stroke="#2E6DF8" stroke-width="1.5"/>
        <path d="M8 7V11" stroke="#2E6DF8" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="8" cy="5" r="0.75" fill="#2E6DF8"/>
    </svg>
    <p class="font-[Poppins] font-semibold text-[12px] text-[#4A6FA5] leading-[1.7]">
        <strong>Progressive Disclosure:</strong>
        Mavi çizgiyle bağlı alanlar seçimlerinize göre dinamik olarak gösterilir ya da gizlenir.
        Bağlı alanlar ana seçim değiştiğinde otomatik olarak güncellenir.
    </p>
</div>

@* Kaydet *@
<div class="flex justify-end mt-5">
    <button type="button"
            @@click="!saving && kaydet()"
            :class="saving ? 'opacity-60 cursor-not-allowed' : 'cursor-pointer hover:bg-[#003F75]'"
            class="flex items-center gap-2 h-12 bg-[#0056B3] text-white border-0 rounded-[10px] px-5 font-[Poppins] font-medium text-[16px] transition-colors">
        <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
        Kaydet
    </button>
</div>

</div>@* /x-data *@

<script>
    function finansalProfilForm(marital, work) {
        marital = marital || {};
        work    = work    || {};
        return {
            calisma:     work.calisma  || '',
            sektor:      work.sektor   || '',
            meslekId:    work.meslekId || '',
            suresi:      work.suresi   || '',
            medeni:      marital.IsMarried !== undefined ? String(marital.IsMarried) : '',
            esCalisiyor: marital.IsWorking ? 'evet' : 'hayir',
            esGeliri:    marital.WSalaryAmount || 0,
            saving:      false,

            getBankValue() {
                var el = document.getElementById('maasBankasi');
                if (!el) return '';
                return el.tomselect ? el.tomselect.getValue() : el.value;
            },

            async kaydet() {
                this.saving = true;

                var token = document.querySelector('[name="__RequestVerificationToken"]').value;

                var maritalStatus = this.medeni === 'true';
                var isWorking     = maritalStatus && this.esCalisiyor === 'evet';
                var wSalary       = isWorking ? (parseFloat(this.esGeliri) || 0) : 0;

                var maritalParams = new URLSearchParams();
                maritalParams.append('__RequestVerificationToken', token);
                maritalParams.append('FinansalMaritalStatus',  maritalStatus);
                maritalParams.append('FinansalIsWorking',      isWorking);
                maritalParams.append('FinansalWSalaryAmount',  wSalary);

                var workParams = new URLSearchParams();
                workParams.append('__RequestVerificationToken',  token);
                var calisiyor = this.calisma === 'calisiyor';
                workParams.append('FinansalWorkSector',       calisiyor ? (parseInt(this.sektor)   || 0) : 0);
                workParams.append('FinansalOccupationId',     calisiyor ? (parseInt(this.meslekId) || 0) : 0);
                workParams.append('FinansalTotalWorkingTime', calisiyor ? this.suresi : '');

                var salaryParams = new URLSearchParams();
                salaryParams.append('__RequestVerificationToken', token);
                salaryParams.append('FinansalSalaryBankCode', this.getBankValue());
                salaryParams.append('FinansalSalaryDate',     new Date().toISOString().split('T')[0]);

                try {
                    var [maritalResp, workResp, salaryResp] = await Promise.all([
                        fetch('?handler=UpdateMaritalStatus', {
                            method:  'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body:    maritalParams
                        }),
                        fetch('?handler=UpdateWork', {
                            method:  'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body:    workParams
                        }),
                        fetch('?handler=UpdateSalary', {
                            method:  'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body:    salaryParams
                        })
                    ]);

                    var [maritalJson, workJson, salaryJson] = await Promise.all([
                        maritalResp.json(),
                        workResp.json(),
                        salaryResp.json()
                    ]);

                    var success = maritalJson.success && workJson.success && salaryJson.success;

                    Toastify({
                        text:     success ? 'Finansal profil güncellendi.' : 'Güncelleme başarısız, lütfen tekrar deneyin.',
                        duration: 3000,
                        gravity:  'top',
                        position: 'right',
                        style:    { background: success ? '#22c55e' : '#ef4444' }
                    }).showToast();
                } catch {
                    Toastify({
                        text:     'Bağlantı hatası oluştu.',
                        duration: 3000,
                        gravity:  'top',
                        position: 'right',
                        style:    { background: '#ef4444' }
                    }).showToast();
                } finally {
                    this.saving = false;
                }
            }
        };
    }
</script>
