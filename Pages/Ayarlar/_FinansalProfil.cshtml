@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

@* Panel başlığı + Düzey göstergeleri *@
<div class="flex justify-between items-start mb-5 max-[480px]:flex-col max-[480px]:gap-2.5">
    <div>
        <h2 class="font-[Manrope] font-bold text-[20px] text-[#101828] mb-1">Finansal Profil</h2>
        <p class="font-[Source_Sans_3] text-[16px] text-[#4A5565]">
            Mesleki, finansal ve demografik bilgilerinizi güncelleyin.
        </p>
    </div>
    <div class="flex items-center gap-2 shrink-0 pt-1 max-[480px]:pt-0">
        <div class="flex items-center gap-1.5 bg-[rgba(46,109,248,0.08)] border border-[rgba(46,109,248,0.2)] rounded-full px-2.5 py-1">
            <div class="w-[7px] h-[7px] rounded-full bg-[#2E6DF8] shrink-0"></div>
            <span class="font-[Source_Sans_3] text-[12px] font-medium text-[#2E6DF8]">Düzey 1</span>
        </div>
        <div class="flex items-center gap-1.5 bg-[rgba(55,184,199,0.08)] border border-[rgba(55,184,199,0.2)] rounded-full px-2.5 py-1">
            <div class="w-[7px] h-[7px] rounded-full bg-[#37B8C7] shrink-0"></div>
            <span class="font-[Source_Sans_3] text-[12px] font-medium text-[#37B8C7]">Düzey 2</span>
        </div>
    </div>
</div>

@* İki Kart *@
<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">

    @* Kart 1: Mesleki ve Finansal Durum *@
    <div class="bg-white border border-[#E2EAF5] rounded-[14px] p-5 shadow-[0_2px_12px_rgba(0,86,179,0.07)]">

        <div class="flex items-center gap-3 -mx-5 -mt-5 mb-4 px-5 py-[14px] bg-gradient-to-br from-[#F0F6FF] to-[#FAFCFF] rounded-t-[14px] border-b border-[#E2EAF5]">
            <div class="w-9 h-9 shrink-0 bg-gradient-to-br from-[#0056B3] to-[#2E6DF8] rounded-[8px] flex items-center justify-center">
                <img src="~/icons/white/briefcase-02.svg" width="20" height="20" alt="">
            </div>
            <div>
                <div class="font-[Manrope] font-semibold text-[14px] text-[#1A1A2E]">Mesleki ve Finansal Durum</div>
                <div class="font-[Source_Sans_3] text-[12px] text-[#7A94B8]">Çalışma bilgileri</div>
            </div>
        </div>

        <div class="mb-2.5">
            <partial name="~/Partials/Components/_Select.cshtml" model="Model.CalismaDurumu" />
        </div>

        <div class="flex items-center gap-1.5 mb-2.5">
            <div class="w-1.5 h-1.5 rounded-full bg-[#2E6DF8] shrink-0"></div>
            <span class="text-[11px] text-[#2E6DF8] italic">
                Fields are hidden dynamically based on user selection
            </span>
        </div>

        <div x-show="calisma !== ''"
             class="border-l-2 border-[#2E6DF8] flex flex-col gap-3">
            <div class="relative pl-[14px]">
                <div class="absolute left-0 top-[7px] w-2.5 h-0.5 bg-[#2E6DF8]"></div>
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.CalismaSektoru" />
            </div>
            <div class="pl-[14px]">
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.Meslek" />
            </div>
            <div class="pl-[14px]">
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.CalismaSuresi" />
            </div>
            <div class="pl-[14px]">
                <partial name="~/Partials/Components/_Select.cshtml" model="Model.MaasBankasi" />
            </div>
        </div>

    </div>

    @* Kart 2: Demografik Durum *@
    <div class="bg-white border border-[#E2EAF5] rounded-[14px] p-5 shadow-[0_2px_12px_rgba(0,86,179,0.07)]">

        <div class="flex items-center gap-3 -mx-5 -mt-5 mb-4 px-5 py-[14px] bg-gradient-to-br from-[#F0F6FF] to-[#FAFCFF] rounded-t-[14px] border-b border-[#E2EAF5]">
            <div class="w-9 h-9 shrink-0 bg-gradient-to-br from-[#0056B3] to-[#37B8C7] rounded-[8px] flex items-center justify-center">
                <img src="~/icons/white/users-01.svg" width="20" height="20" alt="">
            </div>
            <div>
                <div class="font-[Manrope] font-semibold text-[14px] text-[#1A1A2E]">Demografik Durum</div>
                <div class="font-[Source_Sans_3] text-[12px] text-[#7A94B8]">Medeni hal ve aile bilgileri</div>
            </div>
        </div>

        <div class="mb-2.5">
            <partial name="~/Partials/Components/_Select.cshtml" model="Model.MedeniHal" />
        </div>

        <div class="flex items-center gap-1.5 mb-2.5">
            <div class="w-1.5 h-1.5 rounded-full bg-[#2E6DF8] shrink-0"></div>
            <span class="text-[11px] text-[#2E6DF8] italic">
                Fields are hidden dynamically based on user selection
            </span>
        </div>

        <div x-show="medeni === 'evli'"
             class="border-l-2 border-[#2E6DF8] flex flex-col gap-6">

            <div class="relative pl-[14px] pb-1">
                <div class="absolute left-0 top-[7px] w-2.5 h-0.5 bg-[#2E6DF8]"></div>
                <label class="block text-[11px] font-medium text-[#7A94B8] uppercase tracking-[0.08em] mb-2.5 font-[Poppins]">
                    EŞ ÇALIŞIYOR MU?
                </label>
                <div @@change="esCalisiyor = $event.target.value">
                    <partial name="~/Partials/Components/_Radio.cshtml" model="Model.EsCalisiyor" />
                </div>
            </div>

            <div x-show="esCalisiyor === 'evet'" class="ml-[50px]">
                <div class="border-l-2 border-[#37B8C7]">
                    <div class="relative pl-[14px]">
                        <div class="absolute left-0 top-[7px] w-2.5 h-0.5 bg-[#37B8C7]"></div>
                        <label class="block text-[11px] font-medium text-[#7A94B8] uppercase tracking-[0.08em] mb-1.5 font-[Poppins]">
                            EŞİN AYLIK GELİRİ
                        </label>
                        <div class="relative">
                            <input type="number" placeholder="0"
                                   class="w-full py-2.5 pl-3 pr-9 border border-[#D1D5DC] rounded-[8px] text-[13px] text-[#1A1A2E] bg-white outline-none transition-colors focus:border-[#0056B3]" />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[13px] text-[#7A94B8] pointer-events-none">₺</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@* Progressive Disclosure bilgi kutusu *@
<div class="mt-5 bg-[#EBF2FF] border border-[#C3D9FF] rounded-[12px] p-[14px] flex gap-2.5 items-start">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-[1px]">
        <circle cx="8" cy="8" r="7" stroke="#2E6DF8" stroke-width="1.5"/>
        <path d="M8 7V11" stroke="#2E6DF8" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="8" cy="5" r="0.75" fill="#2E6DF8"/>
    </svg>
    <p class="font-[Source_Sans_3] text-[12px] text-[#003F75] leading-[1.7]">
        <strong>Progressive Disclosure:</strong>
        Mavi çizgiyle bağlı alanlar seçimlerinize göre dinamik olarak gösterilir ya da gizlenir.
        Bağlı alanlar ana seçim değiştiğinde otomatik olarak güncellenir.
    </p>
</div>

@* Kaydet *@
<div class="flex justify-end mt-5">
    <button type="button"
            class="flex items-center gap-2 h-12 bg-[#0056B3] text-white border-0 rounded-[10px] px-5 text-[15px] font-medium cursor-pointer transition-colors hover:bg-[#003F75]">
        <img src="~/icons/white/save-02.svg" width="16" height="16" alt="">
        Kaydet
    </button>
</div>
