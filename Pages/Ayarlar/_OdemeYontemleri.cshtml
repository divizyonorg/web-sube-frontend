@model MyApp.Web.Pages.Ayarlar.IndexModel
@{ Layout = null; }

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="bg-white border border-[#E5E7EB] rounded-[14px] pt-[33px] px-[33px] pb-[1px] flex flex-col gap-6 font-[Poppins]"
     x-data="odemeYontemleriData()">

    <p class="font-[Manrope] font-bold text-[20px] text-[#101828]">Ödeme Yöntemleri</p>

    <div class="flex flex-col gap-3">

        <template x-for="kart in kartlar" :key="kart.id">
            <div class="flex items-center justify-between border border-[#E5E7EB] rounded-[10px] p-4 min-h-[78px] bg-white transition-colors hover:border-[#C3D9FF] max-sm:p-3">

                @* Sol: logo + kart bilgisi *@
                <div class="flex items-center gap-3.5 min-w-0 flex-1">

                    <div :class="{
                             'bg-gradient-to-r from-[#155DFC] to-[#193CB8]': kart.marka === \'VISA\',
                             'bg-gradient-to-br from-[#EB001B] to-[#F79E1B]': kart.marka === \'MC\',
                             'bg-[#2E77BC]':                              kart.marka === \'AMEX\',
                             'bg-gray-500':                               kart.marka === \'DIGER\'
                         }"
                         class="w-[46px] h-8 rounded-[4px] shrink-0 flex items-center justify-center">
                        <span x-show="kart.marka === 'VISA'"  class="text-white text-[11px] font-extrabold tracking-[0.5px] italic leading-none">VISA</span>
                        <span x-show="kart.marka === 'MC'"    class="text-white text-[9px]  font-bold leading-none">MC</span>
                        <span x-show="kart.marka === 'AMEX'"  class="text-white text-[9px]  font-bold leading-none">AMEX</span>
                        <span x-show="kart.marka === 'DIGER'" class="text-white text-[9px]  font-bold leading-none">KART</span>
                    </div>

                    <div class="min-w-0">
                        <p class="font-[Source_Sans_3] font-medium text-[16px] text-[#101828] mb-[3px] whitespace-nowrap"
                           x-text="'•••• ' + kart.sonDortHane"></p>
                        <p class="font-[Source_Sans_3] text-[14px] text-[#4A5565] whitespace-nowrap overflow-hidden text-ellipsis"
                           x-text="kart.varsayilan ? 'Varsayılan kart' : kart.kartSahibi"></p>
                    </div>
                </div>

                @* Sağ: durum *@
                <div class="flex items-center shrink-0 ml-3">
                    <span x-show="kart.aktif"  class="font-[Source_Sans_3] text-[14px] font-medium text-[#00A63E]">Aktif</span>
                    <span x-show="!kart.aktif" class="font-[Source_Sans_3] text-[14px] font-medium text-[#9CA3AF]">Pasif</span>
                </div>

            </div>
        </template>

        <div x-show="kartlar.length === 0"
             class="text-center py-6 px-4 font-[Source_Sans_3] text-[#9CA3AF] text-[14px]">
            Henüz kayıtlı kart bulunmuyor.
        </div>

        @* Yeni Kart Ekle *@
        <button type="button"
                @@click="yeniKartAc()"
                class="w-full h-[60px] border-2 border-dashed border-[#D1D5DC] rounded-[10px] bg-transparent cursor-pointer flex items-center justify-center gap-2 font-[Source_Sans_3] text-[16px] font-medium text-[#4A5565] transition-all hover:border-[#0056B3] hover:text-[#0056B3] hover:bg-[rgba(0,86,179,0.03)] max-sm:h-[52px] max-sm:text-[14px]">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M9 3.75v10.5M3.75 9h10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            Yeni Kart Ekle
        </button>

    </div>

    <div class="h-2"></div>
</div>

<script>
    function odemeYontemleriData() {
        return {
            kartlar: [
                {
                    id: 1,
                    marka: 'VISA',
                    sonDortHane: '4532',
                    kartSahibi: 'Mustafa Çakır',
                    varsayilan: true,
                    aktif: true
                }
            ],

            yeniKartAc() {
                Swal.fire({
                    title: 'Yeni Kart Ekle',
                    html: `
                        <div style="font-family:'Poppins',sans-serif;text-align:left;display:flex;flex-direction:column;gap:14px;margin-top:4px;">
                            <div>
                                <label style="font-size:12px;font-weight:500;color:#374151;display:block;margin-bottom:6px;">Kart Numarası</label>
                                <input id="sw-kartNo" type="text" placeholder="0000 0000 0000 0000"
                                       style="width:100%;border:1.5px solid #E5E7EB;border-radius:8px;padding:10px 14px;
                                              font-family:'Poppins';font-size:14px;outline:none;box-sizing:border-box;color:#1F2937;"
                                       onfocus="this.style.borderColor='#0056B3'"
                                       onblur="this.style.borderColor='#E5E7EB'">
                            </div>
                            <div>
                                <label style="font-size:12px;font-weight:500;color:#374151;display:block;margin-bottom:6px;">Kart Sahibi</label>
                                <input id="sw-kartSahibi" type="text" placeholder="Ad Soyad"
                                       style="width:100%;border:1.5px solid #E5E7EB;border-radius:8px;padding:10px 14px;
                                              font-family:'Poppins';font-size:14px;outline:none;box-sizing:border-box;color:#1F2937;"
                                       onfocus="this.style.borderColor='#0056B3'"
                                       onblur="this.style.borderColor='#E5E7EB'">
                            </div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                                <div>
                                    <label style="font-size:12px;font-weight:500;color:#374151;display:block;margin-bottom:6px;">Son Kullanma</label>
                                    <input id="sw-sonKullanma" type="text" placeholder="AA/YY"
                                           style="width:100%;border:1.5px solid #E5E7EB;border-radius:8px;padding:10px 14px;
                                                  font-family:'Poppins';font-size:14px;outline:none;box-sizing:border-box;color:#1F2937;"
                                           onfocus="this.style.borderColor='#0056B3'"
                                           onblur="this.style.borderColor='#E5E7EB'">
                                </div>
                                <div>
                                    <label style="font-size:12px;font-weight:500;color:#374151;display:block;margin-bottom:6px;">CVV</label>
                                    <input id="sw-cvv" type="text" placeholder="•••"
                                           style="width:100%;border:1.5px solid #E5E7EB;border-radius:8px;padding:10px 14px;
                                                  font-family:'Poppins';font-size:14px;outline:none;box-sizing:border-box;color:#1F2937;"
                                           onfocus="this.style.borderColor='#0056B3'"
                                           onblur="this.style.borderColor='#E5E7EB'">
                                </div>
                            </div>
                        </div>
                    `,
                    confirmButtonText: 'Kartı Ekle',
                    confirmButtonColor: '#0056B3',
                    cancelButtonText: 'İptal',
                    showCancelButton: true,
                    width: '440px',
                    didOpen: () => {
                        IMask(document.getElementById('sw-kartNo'),      { mask: '0000 0000 0000 0000' });
                        IMask(document.getElementById('sw-sonKullanma'), { mask: '00/00' });
                        IMask(document.getElementById('sw-cvv'),         { mask: '0000' });
                    },
                    preConfirm: () => {
                        const kartNo      = document.getElementById('sw-kartNo').value.replace(/\s/g, '');
                        const kartSahibi  = document.getElementById('sw-kartSahibi').value.trim();
                        const sonKullanma = document.getElementById('sw-sonKullanma').value;
                        const cvv         = document.getElementById('sw-cvv').value;

                        if (kartNo.length < 16) {
                            Swal.showValidationMessage('Geçerli bir kart numarası giriniz (16 hane).');
                            return false;
                        }
                        if (!kartSahibi) {
                            Swal.showValidationMessage('Kart sahibi adını giriniz.');
                            return false;
                        }
                        if (sonKullanma.replace(/\D/g, '').length < 4) {
                            Swal.showValidationMessage('Son kullanma tarihini giriniz (AA/YY).');
                            return false;
                        }
                        if (cvv.length < 3) {
                            Swal.showValidationMessage('CVV kodunu giriniz (min. 3 hane).');
                            return false;
                        }

                        let marka = 'DIGER';
                        if      (kartNo[0] === '4')                          marka = 'VISA';
                        else if (kartNo[0] === '5' || kartNo[0] === '2')     marka = 'MC';
                        else if (kartNo[0] === '3')                          marka = 'AMEX';

                        return { kartNo, kartSahibi, marka };
                    }
                }).then(result => {
                    if (!result.isConfirmed) return;
                    const { kartNo, kartSahibi, marka } = result.value;
                    this.kartlar.push({
                        id: Date.now(),
                        marka,
                        sonDortHane: kartNo.slice(-4),
                        kartSahibi,
                        varsayilan: this.kartlar.length === 0,
                        aktif: true
                    });
                    toast.success('Kart başarıyla eklendi.');
                });
            }
        };
    }
</script>
