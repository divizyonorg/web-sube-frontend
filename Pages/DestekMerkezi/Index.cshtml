@page
@model MyApp.Web.Pages.DestekMerkezi.IndexModel
@{
    ViewData["Title"] = "Destek Merkezi";
    ViewData["ActivePage"] = "Destek Merkezi";
}

<div class="font-[Poppins] flex flex-col gap-8">

    @* ── PageBar ── *@
    <div class="flex justify-between items-center pb-3 border-b border-[#DCE3FB]">
        <a href="javascript:history.back()"
           class="flex items-center gap-1 no-underline text-[#1B4092] text-[14px]">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M12 15L7 10L12 5" stroke="#1B4092" stroke-width="1.667"
                      stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Geri
        </a>
        <div class="text-right leading-[1.4]">
            <div class="text-[14px] text-[#003F75]">İnteraktif Kredi</div>
            <div class="font-light text-[18px] text-[#003F75]">WEB Şube</div>
        </div>
    </div>

    @* ── Sayfa Başlığı ── *@
    <div class="flex flex-col gap-1">
        <h1 class="font-[Manrope] font-bold text-[30px] leading-[36px] text-[#101828] m-0">Destek Merkezi</h1>
        <p class="font-[Source_Sans_3] text-[16px] leading-[24px] text-[#4A5565] m-0">Size nasıl yardımcı olabiliriz?</p>
    </div>

    @* ── Arama Alanı ── *@
    <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[#99A1AF]" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle cx="9" cy="9" r="6.5" stroke="#99A1AF" stroke-width="1.667"/>
            <path d="M14 14L17.5 17.5" stroke="#99A1AF" stroke-width="1.667" stroke-linecap="round"/>
        </svg>
        <input type="text"
               placeholder="Aramak istediğiniz konuyu yazın..."
               class="w-full h-16 pl-12 pr-4 border-2 border-[#E5E7EB] rounded-[14px] font-[Poppins] text-[18px] leading-[27px] text-[rgba(10,10,10,0.5)] outline-none focus:border-[#0056B3] transition-colors bg-white" />
    </div>

    @* ── İletişim Kartları ── *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

        @* Telefon *@
        <div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[25px] flex flex-col gap-0 relative min-h-[205px]">
            <div class="w-12 h-12 rounded-[10px] bg-[#F0FDF4] flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M6.6 10.8C7.8 13.2 9.8 15.2 12.2 16.4L14 14.6C14.2 14.4 14.6 14.3 14.9 14.5C16 14.9 17.2 15.1 18.5 15.1C19 15.1 19.5 15.6 19.5 16.1V18.5C19.5 19 19 19.5 18.5 19.5C10.2 19.5 3.5 12.8 3.5 4.5C3.5 4 4 3.5 4.5 3.5H7C7.5 3.5 8 4 8 4.5C8 5.8 8.2 7 8.6 8.1C8.7 8.4 8.6 8.8 8.4 9L6.6 10.8Z" stroke="#00A63E" stroke-width="2"/>
                </svg>
            </div>
            <h3 class="font-[Manrope] font-semibold text-[18px] leading-[27px] text-[#101828] m-0 mt-4">Telefon</h3>
            <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0 mt-1">0850 123 45 67</p>
            <a href="tel:08501234567"
               class="font-[Poppins] font-medium text-[14px] leading-[20px] text-[#0056B3] no-underline mt-auto pt-6 inline-block">
                Ara →
            </a>
        </div>

        @* E-posta *@
        <div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[25px] flex flex-col gap-0 relative min-h-[205px]">
            <div class="w-12 h-12 rounded-[10px] bg-[#EFF6FF] flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="4" width="20" height="16" rx="2" stroke="#155DFC" stroke-width="2"/>
                    <path d="M2 8L12 13L22 8" stroke="#155DFC" stroke-width="2"/>
                </svg>
            </div>
            <h3 class="font-[Manrope] font-semibold text-[18px] leading-[27px] text-[#101828] m-0 mt-4">E-posta</h3>
            <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0 mt-1">destek@interaktifkredi.com</p>
            <a href="mailto:destek@interaktifkredi.com"
               class="font-[Poppins] font-medium text-[14px] leading-[20px] text-[#0056B3] no-underline mt-auto pt-6 inline-block">
                Mail Gönder →
            </a>
        </div>

        @* Canlı Destek *@
        <div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[25px] flex flex-col gap-0 relative min-h-[205px]">
            <div class="w-12 h-12 rounded-[10px] bg-[#FAF5FF] flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M21 15C21 15.5304 20.7893 16.0391 20.4142 16.4142C20.0391 16.7893 19.5304 17 19 17H7L3 21V5C3 4.46957 3.21071 3.96086 3.58579 3.58579C3.96086 3.21071 4.46957 3 5 3H19C19.5304 3 20.0391 3.21071 20.4142 3.58579C20.7893 3.96086 21 4.46957 21 5V15Z" stroke="#9810FA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h3 class="font-[Manrope] font-semibold text-[18px] leading-[27px] text-[#101828] m-0 mt-4">Canlı Destek</h3>
            <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0 mt-1">Anında yanıt alın</p>
            <a href="/canlidestek"
               class="font-[Poppins] font-medium text-[14px] leading-[20px] text-[#0056B3] no-underline mt-auto pt-6 inline-block">
                Başlat →
            </a>
        </div>

    </div>

    @* ── Sıkça Sorulan Sorular ── *@
    <div class="flex flex-col gap-6">
        <h2 class="font-[Poppins] font-bold text-[24px] leading-[32px] text-[#101828] m-0">Sıkça Sorulan Sorular</h2>

        <div class="flex flex-col gap-6">

            @* Kredi Başvurusu *@
            <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] pt-[25px] pb-[16px] flex flex-col gap-4">
                <div class="flex items-center gap-[7px]">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <circle cx="10" cy="10" r="8.5" stroke="#0056B3" stroke-width="1.667"/>
                        <path d="M10 6V10.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round"/>
                        <circle cx="10" cy="13.5" r="0.75" fill="#0056B3"/>
                    </svg>
                    <h3 class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828] m-0">Kredi Başvurusu</h3>
                </div>

                <div class="flex flex-col gap-2">
                    @{
                        var krediSorulari = new[]
                        {
                            "Kredi başvurusu nasıl yapılır?",
                            "Başvuru sonucu ne kadar sürede belli olur?",
                            "Hangi belgeler gereklidir?"
                        };
                    }
                    @foreach (var (soru, index) in krediSorulari.Select((s, i) => (s, i)))
                    {
                        <div class="border border-[#F3F4F6] rounded-[14px] overflow-hidden">
                            <button type="button"
                                    onclick="toggleAccordion(this)"
                                    class="w-full flex justify-between items-center px-5 py-4 bg-white hover:bg-[#FAFAFA] transition-colors text-left">
                                <span class="font-[Poppins] font-medium text-[16px] leading-[24px] text-[#1E2939]">@soru</span>
                                <svg class="shrink-0 transition-transform duration-200" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <path d="M5 7.5L10 12.5L15 7.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                            <div class="hidden px-5 pb-4">
                                <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0">
                                    Bu konuyla ilgili destek ekibimiz size yardımcı olacaktır. Lütfen yukarıdaki iletişim kanallarından bize ulaşın.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Ödeme İşlemleri *@
            <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] pt-[25px] pb-[16px] flex flex-col gap-4">
                <div class="flex items-center gap-[7px]">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <circle cx="10" cy="10" r="8.5" stroke="#0056B3" stroke-width="1.667"/>
                        <path d="M10 6V10.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round"/>
                        <circle cx="10" cy="13.5" r="0.75" fill="#0056B3"/>
                    </svg>
                    <h3 class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828] m-0">Ödeme İşlemleri</h3>
                </div>

                <div class="flex flex-col gap-2">
                    @{
                        var odemeSorulari = new[]
                        {
                            "Kredi ödememi nasıl yapabilirim?",
                            "Otomatik ödeme talimatı nasıl veririm?",
                            "Erken ödeme yapabilir miyim?"
                        };
                    }
                    @foreach (var soru in odemeSorulari)
                    {
                        <div class="border border-[#F3F4F6] rounded-[14px] overflow-hidden">
                            <button type="button"
                                    onclick="toggleAccordion(this)"
                                    class="w-full flex justify-between items-center px-5 py-4 bg-white hover:bg-[#FAFAFA] transition-colors text-left">
                                <span class="font-[Poppins] font-medium text-[16px] leading-[24px] text-[#1E2939]">@soru</span>
                                <svg class="shrink-0 transition-transform duration-200" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <path d="M5 7.5L10 12.5L15 7.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                            <div class="hidden px-5 pb-4">
                                <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0">
                                    Bu konuyla ilgili destek ekibimiz size yardımcı olacaktır. Lütfen yukarıdaki iletişim kanallarından bize ulaşın.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Hesap Yönetimi *@
            <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] pt-[25px] pb-[16px] flex flex-col gap-4">
                <div class="flex items-center gap-[7px]">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <circle cx="10" cy="10" r="8.5" stroke="#0056B3" stroke-width="1.667"/>
                        <path d="M10 6V10.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round"/>
                        <circle cx="10" cy="13.5" r="0.75" fill="#0056B3"/>
                    </svg>
                    <h3 class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828] m-0">Hesap Yönetimi</h3>
                </div>

                <div class="flex flex-col gap-2">
                    @{
                        var hesapSorulari = new[]
                        {
                            "Sisteme nasıl giriş yapabilirim?",
                            "İletişim bilgilerimi nasıl güncellerim?",
                            "Hesabımı nasıl kapatırım?"
                        };
                    }
                    @foreach (var soru in hesapSorulari)
                    {
                        <div class="border border-[#F3F4F6] rounded-[14px] overflow-hidden">
                            <button type="button"
                                    onclick="toggleAccordion(this)"
                                    class="w-full flex justify-between items-center px-5 py-4 bg-white hover:bg-[#FAFAFA] transition-colors text-left">
                                <span class="font-[Poppins] font-medium text-[16px] leading-[24px] text-[#1E2939]">@soru</span>
                                <svg class="shrink-0 transition-transform duration-200" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <path d="M5 7.5L10 12.5L15 7.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                            <div class="hidden px-5 pb-4">
                                <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0">
                                    Bu konuyla ilgili destek ekibimiz size yardımcı olacaktır. Lütfen yukarıdaki iletişim kanallarından bize ulaşın.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

    @* ── Açık Destek Kayıtları ── *@
    <div class="flex flex-col gap-4">

        @* Başlık + Buton *@
        <div class="flex justify-between items-start">
            <div class="flex flex-col gap-1">
                <h2 class="font-[Poppins] font-bold text-[24px] leading-[32px] text-[#101828] m-0">Açık Destek Kayıtları</h2>
                <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0">Mevcut destek talepleriniz</p>
            </div>
            <button type="button"
                    class="flex items-center gap-2 bg-[#0056B3] text-white font-[Poppins] font-medium text-[16px] leading-[24px] px-5 h-11 rounded-[14px] border-0 cursor-pointer hover:bg-[#00468f] transition-colors shadow-[0px_4px_10px_rgba(0,86,179,0.25)] shrink-0">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M10 4V16M4 10H16" stroke="white" stroke-width="1.667" stroke-linecap="round"/>
                </svg>
                Yeni Destek Talebi Oluştur
            </button>
        </div>

        @* Kayıt Listesi *@
        <div class="flex flex-col gap-3">

            @* Kayıt 1 — Açık *@
            <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] py-[25px] flex justify-between items-start gap-4">
                <div class="flex items-start gap-4 flex-1">
                    <div class="w-[50px] h-[50px] rounded-[10px] bg-[#E6F7FF] border border-[#DCE3FB] flex items-center justify-center shrink-0">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect x="4" y="2" width="14" height="18" rx="2" stroke="#0056B3" stroke-width="2"/>
                            <path d="M10 2V6H14" stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M8 13H16M8 17H13" stroke="#0056B3" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-2 flex-1">
                        <div class="flex items-center gap-3 flex-wrap">
                            <span class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828]">Kredi başvurusu hakkında bilgi</span>
                            <span class="font-[Source_Sans_3] font-medium text-[12px] leading-[16px] text-[#1447E6] bg-[#DBEAFE] px-3 py-[3px] rounded-full">Açık</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">10 Nisan 2026</span>
                            <span class="w-1 h-1 rounded-full bg-[#99A1AF] inline-block"></span>
                            <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">Genel Soru</span>
                        </div>
                    </div>
                </div>
                <button type="button" class="w-9 h-9 rounded-[10px] flex items-center justify-center hover:bg-[#F3F4F6] transition-colors border-0 bg-transparent cursor-pointer shrink-0">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M1.5 10C1.5 10 4.5 4 10 4C15.5 4 18.5 10 18.5 10C18.5 10 15.5 16 10 16C4.5 16 1.5 10 1.5 10Z" stroke="#6A7282" stroke-width="1.667"/>
                        <circle cx="10" cy="10" r="2.5" stroke="#6A7282" stroke-width="1.667"/>
                    </svg>
                </button>
            </div>

            @* Kayıt 2 — İşlemde *@
            <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] py-[25px] flex justify-between items-start gap-4">
                <div class="flex items-start gap-4 flex-1">
                    <div class="w-[50px] h-[50px] rounded-[10px] bg-[#E6F7FF] border border-[#DCE3FB] flex items-center justify-center shrink-0">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect x="4" y="2" width="14" height="18" rx="2" stroke="#0056B3" stroke-width="2"/>
                            <path d="M10 2V6H14" stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M8 13H16M8 17H13" stroke="#0056B3" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-2 flex-1">
                        <div class="flex items-center gap-3 flex-wrap">
                            <span class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828]">Rapor indirme sorunu yaşıyorum</span>
                            <span class="font-[Source_Sans_3] font-medium text-[12px] leading-[16px] text-[#A65F00] bg-[#FEF9C2] px-3 py-[3px] rounded-full">İşlemde</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">05 Nisan 2026</span>
                            <span class="w-1 h-1 rounded-full bg-[#99A1AF] inline-block"></span>
                            <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">Teknik Destek</span>
                        </div>
                    </div>
                </div>
                <button type="button" class="w-9 h-9 rounded-[10px] flex items-center justify-center hover:bg-[#F3F4F6] transition-colors border-0 bg-transparent cursor-pointer shrink-0">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M1.5 10C1.5 10 4.5 4 10 4C15.5 4 18.5 10 18.5 10C18.5 10 15.5 16 10 16C4.5 16 1.5 10 1.5 10Z" stroke="#6A7282" stroke-width="1.667"/>
                        <circle cx="10" cy="10" r="2.5" stroke="#6A7282" stroke-width="1.667"/>
                    </svg>
                </button>
            </div>

            @* Kayıt 3 — Kapatıldı *@
            <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] py-[25px] flex justify-between items-start gap-4">
                <div class="flex items-start gap-4 flex-1">
                    <div class="w-[50px] h-[50px] rounded-[10px] bg-[#E6F7FF] border border-[#DCE3FB] flex items-center justify-center shrink-0">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect x="4" y="2" width="14" height="18" rx="2" stroke="#0056B3" stroke-width="2"/>
                            <path d="M10 2V6H14" stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M8 13H16M8 17H13" stroke="#0056B3" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-2 flex-1">
                        <div class="flex items-center gap-3 flex-wrap">
                            <span class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828]">Ödeme güncelleme talebi</span>
                            <span class="font-[Source_Sans_3] font-medium text-[12px] leading-[16px] text-[#4A5565] bg-[#F3F4F6] px-3 py-[3px] rounded-full">Kapatıldı</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">28 Mart 2026</span>
                            <span class="w-1 h-1 rounded-full bg-[#99A1AF] inline-block"></span>
                            <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">İşlem Talebi</span>
                        </div>
                    </div>
                </div>
                <button type="button" class="w-9 h-9 rounded-[10px] flex items-center justify-center hover:bg-[#F3F4F6] transition-colors border-0 bg-transparent cursor-pointer shrink-0">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M1.5 10C1.5 10 4.5 4 10 4C15.5 4 18.5 10 18.5 10C18.5 10 15.5 16 10 16C4.5 16 1.5 10 1.5 10Z" stroke="#6A7282" stroke-width="1.667"/>
                        <circle cx="10" cy="10" r="2.5" stroke="#6A7282" stroke-width="1.667"/>
                    </svg>
                </button>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        function toggleAccordion(btn) {
            const panel = btn.nextElementSibling;
            const icon  = btn.querySelector('svg');
            const isOpen = !panel.classList.contains('hidden');

            if (isOpen) {
                panel.classList.add('hidden');
                icon.style.transform = '';
            } else {
                panel.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            }
        }
    </script>
}
