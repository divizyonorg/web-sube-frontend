@page
@model MyApp.Web.Pages.DestekMerkezi.IndexModel
@{
    ViewData["Title"] = "Destek Merkezi";
    ViewData["ActivePage"] = "Destek Merkezi";
}

<div class="font-[Poppins] flex flex-col gap-8" x-data="destekMerkezi()">

@Html.AntiForgeryToken()


    @* ── Sayfa Başlığı ── *@
    <div class="flex flex-col gap-1">
        <h1 class="font-[Manrope] font-bold text-[30px] leading-[36px] text-[#101828] m-0">Destek Merkezi</h1>
        <p class="font-[Source_Sans_3] text-[16px] leading-[24px] text-[#4A5565] m-0">Size nasıl yardımcı olabiliriz?</p>
    </div>

    @* ── Arama Alanı ── *@
    <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[#99A1AF]" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle cx="9" cy="9" r="6.5" stroke="#99A1AF" stroke-width="1.667"/>
            <path d="M14 14L17.5 17.5" stroke="#99A1AF" stroke-width="1.667" stroke-linecap="round"/>
        </svg>
        <input type="text"
               placeholder="Aramak istediğiniz konuyu yazın..."
               class="w-full h-16 pl-12 pr-4 border-2 border-[#E5E7EB] rounded-[14px] font-[Poppins] text-[18px] leading-[27px] text-[rgba(10,10,10,0.5)] outline-none focus:border-[#0056B3] transition-colors" />
    </div>

    @* ── İletişim Kartları ── *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

        @* Telefon *@
        <div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[25px] flex flex-col gap-0 relative min-h-[205px]">
            <div class="w-12 h-12 rounded-[10px] bg-[#F0FDF4] flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M6.6 10.8C7.8 13.2 9.8 15.2 12.2 16.4L14 14.6C14.2 14.4 14.6 14.3 14.9 14.5C16 14.9 17.2 15.1 18.5 15.1C19 15.1 19.5 15.6 19.5 16.1V18.5C19.5 19 19 19.5 18.5 19.5C10.2 19.5 3.5 12.8 3.5 4.5C3.5 4 4 3.5 4.5 3.5H7C7.5 3.5 8 4 8 4.5C8 5.8 8.2 7 8.6 8.1C8.7 8.4 8.6 8.8 8.4 9L6.6 10.8Z" stroke="#00A63E" stroke-width="2"/>
                </svg>
            </div>
            <h3 class="font-[Manrope] font-semibold text-[18px] leading-[27px] text-[#101828] m-0 mt-4">Telefon</h3>
            <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0 mt-1">0850 123 45 67</p>
            <a href="tel:08501234567"
               class="font-[Poppins] font-medium text-[14px] leading-[20px] text-[#0056B3] no-underline mt-auto pt-6 inline-block">
                Ara →
            </a>
        </div>

        @* E-posta *@
        <div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[25px] flex flex-col gap-0 relative min-h-[205px]">
            <div class="w-12 h-12 rounded-[10px] bg-[#EFF6FF] flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="4" width="20" height="16" rx="2" stroke="#155DFC" stroke-width="2"/>
                    <path d="M2 8L12 13L22 8" stroke="#155DFC" stroke-width="2"/>
                </svg>
            </div>
            <h3 class="font-[Manrope] font-semibold text-[18px] leading-[27px] text-[#101828] m-0 mt-4">E-posta</h3>
            <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0 mt-1">destek@interaktifkredi.com</p>
            <a href="mailto:destek@interaktifkredi.com"
               class="font-[Poppins] font-medium text-[14px] leading-[20px] text-[#0056B3] no-underline mt-auto pt-6 inline-block">
                Mail Gönder →
            </a>
        </div>

        @* Canlı Destek *@
        <div class="bg-white border border-[#E5E7EB] rounded-[14px] p-[25px] flex flex-col gap-0 relative min-h-[205px]">
            <div class="w-12 h-12 rounded-[10px] bg-[#FAF5FF] flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M21 15C21 15.5304 20.7893 16.0391 20.4142 16.4142C20.0391 16.7893 19.5304 17 19 17H7L3 21V5C3 4.46957 3.21071 3.96086 3.58579 3.58579C3.96086 3.21071 4.46957 3 5 3H19C19.5304 3 20.0391 3.21071 20.4142 3.58579C20.7893 3.96086 21 4.46957 21 5V15Z" stroke="#9810FA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h3 class="font-[Manrope] font-semibold text-[18px] leading-[27px] text-[#101828] m-0 mt-4">Canlı Destek</h3>
            <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0 mt-1">Anında yanıt alın</p>
            <a href="/canlidestek"
               class="font-[Poppins] font-medium text-[14px] leading-[20px] text-[#0056B3] no-underline mt-auto pt-6 inline-block">
                Başlat →
            </a>
        </div>

    </div>

    @* ── Sıkça Sorulan Sorular ── *@
    <div class="flex flex-col gap-6">
        <h2 class="font-[Poppins] font-bold text-[24px] leading-[32px] text-[#101828] m-0">Sıkça Sorulan Sorular</h2>

        @if (Model.SssKategoriler.Count == 0)
        {
            <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">Henüz soru bulunmamaktadır.</p>
        }
        else
        {
            <div class="flex flex-col gap-6">
                @foreach (var kategori in Model.SssKategoriler)
                {
                    <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] pt-[25px] pb-[16px] flex flex-col gap-4" data-topic-id="@kategori.Id">
                        <div class="flex items-center gap-[7px]">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <circle cx="10" cy="10" r="8.5" stroke="#0056B3" stroke-width="1.667"/>
                                <path d="M10 6V10.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round"/>
                                <circle cx="10" cy="13.5" r="0.75" fill="#0056B3"/>
                            </svg>
                            <h3 class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828] m-0">@kategori.Baslik</h3>
                        </div>

                        <div class="flex flex-col gap-2">
                            @foreach (var soru in kategori.Sorular)
                            {
                                <div class="border border-[#F3F4F6] rounded-[14px] overflow-hidden">
                                    <button type="button"
                                            onclick="toggleAccordion(this)"
                                            class="w-full flex justify-between items-center px-5 py-4 bg-white hover:bg-[#FAFAFA] transition-colors text-left">
                                        <span class="font-[Poppins] font-medium text-[16px] leading-[24px] text-[#1E2939]">@soru.Soru</span>
                                        <svg class="shrink-0 transition-transform duration-200" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                            <path d="M5 7.5L10 12.5L15 7.5" stroke="#0056B3" stroke-width="1.667" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <div class="hidden px-5 pb-4">
                                        <div class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">
                                            @Html.Raw(soru.Cevap)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ── Destek Talepleri ── *@
    <div class="flex flex-col gap-4">

        @* Başlık + Buton *@
        <div class="flex justify-between items-start">
            <div class="flex flex-col gap-1">
                <h2 class="font-[Poppins] font-bold text-[24px] leading-[32px] text-[#101828] m-0">Açık Destek Kayıtları</h2>
                <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0">Mevcut destek talepleriniz</p>
            </div>
            <button type="button"
                    @@click="openModal(0)"
                    class="flex items-center gap-2 bg-[#0056B3] text-white font-[Poppins] font-medium text-[16px] leading-[24px] px-5 h-11 rounded-[14px] border-0 cursor-pointer hover:bg-[#00468f] transition-colors shadow-[0px_4px_10px_rgba(0,86,179,0.25)] shrink-0">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M10 4V16M4 10H16" stroke="white" stroke-width="1.667" stroke-linecap="round"/>
                </svg>
                Yeni Destek Talebi Oluştur
            </button>
        </div>

        @* Kayıt Listesi *@
        <div class="flex flex-col gap-3">

            @if (Model.DestekTalepleri.Count == 0)
            {
                <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] py-[30px] flex items-center justify-center">
                    <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0">Henüz destek talebiniz bulunmamaktadır.</p>
                </div>
            }
            else
            {
                @foreach (var talep in Model.DestekTalepleri)
                {
                    <div class="bg-white border border-[#E5E7EB] rounded-[14px] px-[25px] py-[25px] flex justify-between items-start gap-4">
                        <div class="flex items-start gap-4 flex-1">
                            <div class="w-[50px] h-[50px] rounded-[10px] bg-[#E6F7FF] border border-[#DCE3FB] flex items-center justify-center shrink-0">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect x="4" y="2" width="14" height="18" rx="2" stroke="#0056B3" stroke-width="2"/>
                                    <path d="M10 2V6H14" stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M8 13H16M8 17H13" stroke="#0056B3" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="flex flex-col gap-2 flex-1">
                                <div class="flex items-center gap-3 flex-wrap">
                                    <span class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828]">@talep.KonuBasligi</span>
                                    <span class="@talep.DurumBadgeClass">@talep.DurumLabel</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">@talep.Tarih</span>
                                    @if (!string.IsNullOrEmpty(talep.AtananBirim))
                                    {
                                        <span class="w-1 h-1 rounded-full bg-[#99A1AF] inline-block"></span>
                                        <span class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565]">@talep.AtananBirim</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <button type="button"
                                @@click="openDetailModal(@talep.Id)"
                                class="w-9 h-9 rounded-[10px] flex items-center justify-center hover:bg-[#F3F4F6] transition-colors border-0 bg-transparent cursor-pointer shrink-0"
                                title="Detayları Görüntüle">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path d="M1.5 10C1.5 10 4.5 4 10 4C15.5 4 18.5 10 18.5 10C18.5 10 15.5 16 10 16C4.5 16 1.5 10 1.5 10Z" stroke="#6A7282" stroke-width="1.667"/>
                                <circle cx="10" cy="10" r="2.5" stroke="#6A7282" stroke-width="1.667"/>
                            </svg>
                        </button>
                    </div>
                }
            }

        </div>
    </div>

    @* ── Yeni Destek Talebi Modalı ── *@
    <div x-show="modalOpen"
         x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4"
         @@click.self="closeModal()">
        <div class="bg-white w-full max-w-[520px] rounded-[24px] shadow-[0px_20px_60px_rgba(0,86,179,0.18),0px_4px_20px_rgba(0,0,0,0.1)] border border-[#DCE3FB] flex flex-col">

            @* Başlık *@
            <div class="flex items-center justify-between px-8 pt-7 pb-5 border-b border-[#F3F4F6]">
                <div>
                    <h3 class="font-[Poppins] font-semibold text-[20px] leading-[30px] text-[#101828] m-0">Yeni Destek Talebi</h3>
                    <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#4A5565] m-0 mt-1">Talebinizi detaylı şekilde açıklayınız</p>
                </div>
                <button type="button"
                        @@click="closeModal()"
                        class="w-9 h-9 rounded-[10px] flex items-center justify-center hover:bg-[#F3F4F6] transition-colors border-0 bg-transparent cursor-pointer shrink-0">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M15 5L5 15M5 5L15 15" stroke="#6A7282" stroke-width="1.667" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @* Form Alanı *@
            <div class="px-8 py-6">
                <label class="font-[Source_Sans_3] font-semibold text-[14px] leading-[20px] text-[#374151] block mb-2">
                    Talep Detayı
                </label>
                <textarea x-model="detailText"
                          placeholder="Sorununuzu veya talebinizi detaylı şekilde açıklayınız..."
                          rows="5"
                          class="w-full border border-[#D1D5DC] rounded-[10px] px-4 py-3 font-[Source_Sans_3] text-[14px] leading-[20px] text-[#1F2937] outline-none focus:border-[#0056B3] transition-colors resize-none"></textarea>
            </div>

            @* Butonlar *@
            <div class="flex gap-3 px-8 pb-7">
                <button type="button"
                        @@click="closeModal()"
                        class="flex-1 h-11 rounded-[14px] border border-[#D1D5DC] bg-white font-[Poppins] font-medium text-[14px] leading-[20px] text-[#374151] cursor-pointer hover:bg-[#F9FAFB] transition-colors">
                    İptal
                </button>
                <button type="button"
                        @@click="submitTalebi()"
                        :disabled="!detailText.trim() || sending"
                        :class="(!detailText.trim() || sending) ? 'opacity-60 cursor-not-allowed' : 'hover:bg-[#00468f] cursor-pointer'"
                        class="flex-1 h-11 rounded-[14px] bg-[#0056B3] text-white font-[Poppins] font-medium text-[14px] leading-[20px] border-0 transition-colors shadow-[0px_4px_10px_rgba(0,86,179,0.25)]">
                    <span x-show="!sending">Gönder</span>
                    <span x-show="sending" x-cloak>Gönderiliyor...</span>
                </button>
            </div>

        </div>
    </div>

    @* ── Destek Talebi Detay Modalı ── *@
    <div x-show="detailModalOpen"
         x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4"
         @@click.self="closeDetailModal()">
        <div class="bg-white w-full max-w-[560px] rounded-[24px] shadow-[0px_20px_60px_rgba(0,86,179,0.18),0px_4px_20px_rgba(0,0,0,0.1)] border border-[#DCE3FB] flex flex-col max-h-[90vh]">

            @* Başlık *@
            <div class="flex items-start justify-between px-8 pt-7 pb-5 border-b border-[#F3F4F6] shrink-0">
                <div>
                    <div class="font-[Source_Sans_3] text-[12px] leading-[16px] text-[#99A1AF] mb-1" x-text="'Talep #' + selectedTalep?.id"></div>
                    <h3 class="font-[Poppins] font-semibold text-[20px] leading-[30px] text-[#101828] m-0">Destek Talebi Detayı</h3>
                </div>
                <button type="button"
                        @@click="closeDetailModal()"
                        class="w-9 h-9 rounded-[10px] flex items-center justify-center hover:bg-[#F3F4F6] transition-colors border-0 bg-transparent cursor-pointer shrink-0 mt-1">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M15 5L5 15M5 5L15 15" stroke="#6A7282" stroke-width="1.667" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @* Kaydırılabilir İçerik *@
            <div class="px-8 py-6 flex flex-col gap-4 overflow-y-auto flex-1">

                @* Konu Başlığı + Durum *@
                <div class="flex items-start justify-between gap-3 flex-wrap">
                    <span class="font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828]" x-text="selectedTalep?.konuBasligi"></span>
                    <span :class="selectedTalep?.durumBadgeClass" x-text="selectedTalep?.durumLabel"></span>
                </div>

                @* Konu Detayları *@
                <div x-show="selectedTalep?.konuDetaylari" class="bg-[#F8FAFF] rounded-[12px] px-5 py-4 border border-[#E8ECFF]">
                    <div class="font-[Source_Sans_3] font-semibold text-[11px] leading-[16px] text-[#6A7282] uppercase tracking-wider mb-2">Talep Detayı</div>
                    <p class="font-[Source_Sans_3] text-[14px] leading-[22px] text-[#1E2939] m-0" x-text="selectedTalep?.konuDetaylari"></p>
                </div>

                @* Tarihler *@
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-[#F9FAFB] rounded-[10px] px-4 py-3">
                        <div class="font-[Source_Sans_3] text-[11px] text-[#6A7282] uppercase tracking-wider mb-1">Talep Tarihi</div>
                        <div class="font-[Poppins] font-medium text-[14px] text-[#101828]" x-text="selectedTalep?.tarih"></div>
                    </div>
                    <div x-show="selectedTalep?.guncellemeTarihi" class="bg-[#F9FAFB] rounded-[10px] px-4 py-3">
                        <div class="font-[Source_Sans_3] text-[11px] text-[#6A7282] uppercase tracking-wider mb-1">Son Güncelleme</div>
                        <div class="font-[Poppins] font-medium text-[14px] text-[#101828]" x-text="selectedTalep?.guncellemeTarihi"></div>
                    </div>
                </div>

                @* Atanan Birim + Önem Derecesi *@
                <div class="grid grid-cols-2 gap-3">
                    <div x-show="selectedTalep?.atananBirim" class="bg-[#F9FAFB] rounded-[10px] px-4 py-3">
                        <div class="font-[Source_Sans_3] text-[11px] text-[#6A7282] uppercase tracking-wider mb-1">Atanan Birim</div>
                        <div class="font-[Poppins] font-medium text-[14px] text-[#101828]" x-text="selectedTalep?.atananBirim"></div>
                    </div>
                    <div x-show="selectedTalep?.onemDerecesi != null" class="bg-[#F9FAFB] rounded-[10px] px-4 py-3">
                        <div class="font-[Source_Sans_3] text-[11px] text-[#6A7282] uppercase tracking-wider mb-2">Önem Derecesi</div>
                        <div class="flex items-center gap-1.5">
                            <template x-for="n in 5" :key="n">
                                <div :class="n <= (selectedTalep?.onemDerecesi ?? 0) ? 'bg-[#0056B3]' : 'bg-[#E5E7EB]'"
                                     class="w-3 h-3 rounded-full transition-colors"></div>
                            </template>
                            <span class="font-[Source_Sans_3] text-[12px] text-[#6A7282] ml-1" x-text="(selectedTalep?.onemDerecesi ?? 0) + ' / 5'"></span>
                        </div>
                    </div>
                </div>

                @* Atama Sebebi *@
                <div x-show="selectedTalep?.atamaSebebi" class="bg-[#F9FAFB] rounded-[10px] px-4 py-3">
                    <div class="font-[Source_Sans_3] text-[11px] text-[#6A7282] uppercase tracking-wider mb-1">Atama Sebebi</div>
                    <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#1E2939] m-0" x-text="selectedTalep?.atamaSebebi"></p>
                </div>

                @* İşlem Notu *@
                <div x-show="selectedTalep?.statusText" class="bg-[#F9FAFB] rounded-[10px] px-4 py-3">
                    <div class="font-[Source_Sans_3] text-[11px] text-[#6A7282] uppercase tracking-wider mb-1">İşlem Notu</div>
                    <p class="font-[Source_Sans_3] text-[14px] leading-[20px] text-[#1E2939] m-0" x-text="selectedTalep?.statusText"></p>
                </div>

            </div>

            @* Kapat Butonu *@
            <div class="px-8 pb-7 shrink-0">
                <button type="button"
                        @@click="closeDetailModal()"
                        class="w-full h-11 rounded-[14px] border border-[#D1D5DC] bg-white font-[Poppins] font-medium text-[14px] leading-[20px] text-[#374151] cursor-pointer hover:bg-[#F9FAFB] transition-colors">
                    Kapat
                </button>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.js"></script>

    <script>
        window.__destekTalepleri = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.DestekTalepleri,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
        ));

        function toggleAccordion(btn) {
            const panel = btn.nextElementSibling;
            const icon  = btn.querySelector('svg');
            const isOpen = !panel.classList.contains('hidden');

            if (isOpen) {
                panel.classList.add('hidden');
                icon.style.transform = '';
            } else {
                panel.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            }
        }

        function destekMerkezi() {
            return {
                modalOpen:       false,
                parentTopicId:   0,
                detailText:      '',
                sending:         false,
                detailModalOpen: false,
                selectedTalep:   null,

                openModal(topicId) {
                    this.parentTopicId = topicId ?? 0;
                    this.detailText    = '';
                    this.modalOpen     = true;
                },

                closeModal() {
                    this.modalOpen = false;
                },

                openDetailModal(id) {
                    this.selectedTalep   = (window.__destekTalepleri || []).find(t => t.id === id) ?? null;
                    this.detailModalOpen = !!this.selectedTalep;
                },

                closeDetailModal() {
                    this.detailModalOpen = false;
                    this.selectedTalep   = null;
                },

                async submitTalebi() {
                    if (!this.detailText.trim()) return;
                    this.sending = true;

                    const token  = document.querySelector('[name="__RequestVerificationToken"]').value;
                    const params = new URLSearchParams();
                    params.append('__RequestVerificationToken', token);
                    params.append('parentTopicId', this.parentTopicId);
                    params.append('detailText',    this.detailText.trim());

                    try {
                        const resp = await fetch('?handler=CreateTalebi', {
                            method:  'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body:    params
                        });

                        const data = await resp.json();

                        if (data.success) {
                            this.modalOpen = false;
                            toast.success('Destek talebiniz başarıyla oluşturuldu.');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toast.error('Bir hata oluştu, lütfen tekrar deneyin.');
                        }
                    } catch {
                        toast.error('Bağlantı hatası, lütfen tekrar deneyin.');
                    } finally {
                        this.sending = false;
                    }
                }
            };
        }

        // SSS cevabı içindeki "Destek Talebi Oluştur" butonu için event delegation
        document.addEventListener('click', function (e) {
            if (e.target && e.target.id === 'createSupportApply') {
                const topicEl = e.target.closest('[data-topic-id]');
                const topicId = topicEl ? parseInt(topicEl.dataset.topicId) : 0;

                const pageEl = document.querySelector('[x-data]');
                if (pageEl) Alpine.$data(pageEl).openModal(topicId);
            }
        });
    </script>
}
