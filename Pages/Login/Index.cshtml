@page "/login"
@model MyApp.Web.Pages.Login.IndexModel
@{ Layout = null; }

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş — İnteraktif Şube</title>
    <link rel="icon" href="~/icons/logo_transparent.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; font-family: 'Poppins', sans-serif; }
        button { font-family: 'Poppins', sans-serif; }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body>

    <script>
        (function () {
            function isTokenValid() {
                var token = localStorage.getItem('auth_token');
                if (!token) return false;
                try {
                    var payload = JSON.parse(atob(token.split('.')[1]));
                    return typeof payload.exp === 'number' && payload.exp * 1000 > Date.now();
                } catch { return false; }
            }

            if (isTokenValid()) {
                window.location.replace('/anasayfa');
            } else {
                localStorage.removeItem('auth_token');
            }
        })();
    </script>

    <div x-data="loginForm()" class="flex h-screen overflow-hidden">

        @* Sol panel — yalnızca desktop *@
        <div class="hidden lg:block relative w-[57%] shrink-0 overflow-hidden">
            <img src="~/images/login-image.jpg"
                 alt="İnteraktif Kredi"
                 class="block w-full h-full object-cover object-top" />
        </div>

        @* Sağ panel — mobile: tam genişlik, desktop: flex-1 *@
        <div class="flex-1 min-w-0 h-full flex items-center justify-center bg-white overflow-y-auto py-8 px-5 lg:py-10 lg:px-6">
            <div class="w-full max-w-110 lg:max-w-105 flex flex-col items-center">

                <img src="~/images/ik_logo.png"
                     alt="İnteraktif Kredi"
                     class="h-14 w-[220px] object-contain mb-5" />

                <p class="font-light text-base text-[#0056B3] mb-1.5 text-center">
                    Bireysel
                </p>
                <h1 class="font-semibold text-[26px] leading-[1.3] text-[#0056B3] text-center mb-7">
                    İnteraktif Şube Girişi
                </h1>

                <div class="w-full rounded-2xl px-5 py-6 bg-white lg:px-7" style="box-shadow:0 4px 32px 0 rgba(0,86,179,0.10);">
                    <form id="loginForm" method="post" class="flex flex-col gap-4">
                        @Html.AntiForgeryToken()

                        @* GSM *@
                        <div :class="step === 2 ? 'pointer-events-none opacity-55' : ''"
                             class="[&>div]:w-full! [&_input]:w-full! lg:[&>div]:w-91! lg:[&_input]:w-90!">
                            <partial name="~/Partials/Components/_Input.cshtml"
                                     model='new InputViewModel { Label = "GSM", Type = InputFieldType.Phone, Name = "PhoneNumber", ContainerWidth = 364 }' />
                        </div>

                        @* TCKN — sadece 2. adımda *@
                        <div x-show="step === 2" x-cloak
                             class="[&>div]:w-full! [&_input]:w-full! lg:[&>div]:w-91! lg:[&_input]:w-90!">
                            <partial name="~/Partials/Components/_Input.cshtml"
                                     model='new InputViewModel { Label = "TCKN", Type = InputFieldType.Tckn, Name = "Tckn", ContainerWidth = 364 }' />
                        </div>

                        @* Devam Et *@
                        <div x-show="step === 1"
                             @@click="canProceed() && !proceeding ? proceed() : explainWhyDisabled()"
                             :class="!canProceed() || proceeding ? 'cursor-not-allowed opacity-50' : 'cursor-pointer'"
                             class="[&_button]:w-full! lg:[&_button]:w-91!">
                            <partial name="~/Partials/Components/_Button.cshtml"
                                     model='new ButtonViewModel { Label = "Devam Et", Variant = ButtonVariant.Primary, Width = 364 }' />
                        </div>

                        @* Giriş Yap *@
                        <div x-show="step === 2" x-cloak
                             @@click="loginWithTckn()"
                             class="cursor-pointer [&_button]:w-full! lg:[&_button]:w-91!">
                            <partial name="~/Partials/Components/_Button.cshtml"
                                     model='new ButtonViewModel { Label = "Giriş Yap", Variant = ButtonVariant.Primary, Width = 364 }' />
                        </div>

                        @* TCKN validasyon hatası *@
                        <p x-show="step === 2 && tcknError" x-cloak
                           x-text="tcknErrorMsg"
                           class="text-[13px] text-[#DC2626] text-center m-0"></p>

                        @* Beni Hatırla + Parolamı Unuttum *@
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2.5 cursor-pointer" @@click="rememberMe = !rememberMe">
                                <input type="checkbox" name="RememberMe" x-model="rememberMe"
                                       style="position:absolute;opacity:0;width:0;height:0;margin:0;padding:0;" />
                                <div :style="{ backgroundColor: rememberMe ? '#0056B3' : '#FFFFFF' }"
                                     style="box-sizing:border-box;display:flex;justify-content:center;align-items:center;width:24px;min-width:24px;height:24px;min-height:24px;flex-shrink:0;border:2px solid #0056B3;border-radius:5px;overflow:hidden;">
                                    <svg x-show="rememberMe" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;flex-shrink:0;">
                                        <path d="M20 6L9 17L4 12" />
                                    </svg>
                                </div>
                                <span style="font-family:'Poppins';font-weight:300;font-size:12px;line-height:18px;color:#222854;user-select:none;">
                                    Beni Hatırla!
                                </span>
                            </div>
                            <a x-show="step === 2" x-cloak href="/forgot-password"
                               class="text-[14px] font-bold text-[#0056B3] underline">
                                Parolamı unuttum
                            </a>
                        </div>

                        <div class="h-px bg-[#E5E7EB]"></div>

                        <div class="text-center">
                            <a href="/register" class="text-[15px] font-bold text-[#2E6DF8] underline">
                                Henüz üye değil misin?
                            </a>
                        </div>

                        <button type="button"
                                style="background-color:#D4E2F2;"
                                class="flex items-center justify-center gap-2.5 w-full lg:w-91 h-12 border-0 rounded-[40px] text-sm font-medium text-[#374151] cursor-pointer shrink-0">
                            <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                            </svg>
                            Google ile Giriş Yap
                        </button>

                    </form>
                </div>

            </div>
        </div>

        @* OTP Modal *@
        @* Mobile: tam ekran açık mavi arka plan, soluk logo+başlık üstte, beyaz kart altında *@
        @* Desktop: yarı saydam overlay, kart ortada *@
        <div x-show="showOtpModal" x-cloak class="fixed inset-0 z-100 overflow-y-auto lg:overflow-hidden">
            <div class="min-h-full flex flex-col items-center bg-[#E8EDF5] px-5 py-8
                        lg:min-h-0 lg:h-full lg:flex-row lg:justify-center lg:items-center lg:bg-[#DDE3ECBF] lg:px-4 lg:py-4">

                @* Soluk başlık — yalnızca mobile *@
                <div class="w-full flex flex-col items-center mb-5 lg:hidden">
                    <img src="~/images/ik_logo.png"
                         alt="İnteraktif Kredi"
                         class="h-14 w-auto object-contain mb-4 opacity-35" />
                    <p class="font-light text-2xl text-[#7B9CC4] mb-2 text-center">Bireysel</p>
                    <h2 class="font-semibold text-[32px] leading-[1.2] text-[#7B9CC4] text-center">
                        İnteraktif Şube Girişi
                    </h2>
                </div>

                @* Modal kart — her iki tarafta da yuvarlak köşe *@
                <div class="bg-white w-full rounded-[20px] overflow-hidden
                            shadow-[0_4px_24px_rgba(0,0,0,0.08)]
                            lg:max-w-120 lg:shadow-[0_25px_60px_rgba(0,0,0,0.3)]">

                    <div class="relative">
                        <img src="~/images/sms.png"
                             class="w-full h-50 object-cover object-top block" />
                        <button type="button"
                                @@click="showOtpModal = false; clearInterval(timerInterval)"
                                class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full bg-white/80 backdrop-blur-sm border-0 cursor-pointer hover:bg-white transition-colors">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>

                    <div class="px-5 pt-6 pb-8 flex flex-col items-center gap-4 lg:px-9 lg:pt-7 lg:pb-8">

                        <h2 class="font-bold text-xl text-[#0056B3] m-0 text-center">
                            SMS onayı
                        </h2>

                        <p class="text-sm text-[#374151] text-center m-0 leading-[1.7]">
                            Giriş yapmak için lütfen
                            <strong x-text="maskedPhone()" class="text-[#0056B3]"></strong>
                            nolu cep telefonuna gönderdiğimiz şifreyi yazın.
                        </p>

                        <input type="text" id="OtpCode" name="OtpCode"
                               x-model="otpCode"
                               placeholder="SMS Kodunu Girin"
                               maxlength="6"
                               class="w-full h-13 border-[1.5px] border-[#DCE3FB] rounded-xl px-4 text-[15px] outline-none text-[#374151]" />

                        <p class="text-[13px] text-[#374151] m-0 text-center">
                            <span x-text="timerDisplay()" class="font-semibold text-[#0056B3]"></span>
                            saniye sonra yeni kod gönderebilirsin
                        </p>

                        <div @@click="!verifyingOtp && verifyOtp()"
                             :class="verifyingOtp ? 'opacity-60 cursor-not-allowed pointer-events-none' : 'cursor-pointer'"
                             class="w-full [&_button]:w-full!">
                            <partial name="~/Partials/Components/_Button.cshtml"
                                     model='new ButtonViewModel { Label = "Devam Et", Variant = ButtonVariant.Primary, Width = 408 }' />
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <script defer src="~/lib/alpinejs/cdn.min.js"></script>
    <script src="~/lib/imask/imask.min.js"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script>
        function loginForm() {
            return {
                step: 1,
                phone: '',
                tckn: '',
                rememberMe: false,
                showOtpModal: false,
                otpCode: '',
                timer: 180,
                timerInterval: null,
                proceeding: false,
                tcknError: false,
                tcknErrorMsg: '',
                verifyingOtp: false,
                _tcknMask: null,

                init() {
                    var self = this;

                    var saved = JSON.parse(localStorage.getItem('remember_me') || 'null');
                    if (saved) {
                        self.rememberMe = true;
                        self.phone      = saved.phone || '';
                        self.tckn       = saved.tckn  || '';
                    }

                    self.$nextTick(function () {
                        var phoneEl = document.getElementById('PhoneNumber');
                        if (phoneEl) {
                            var phoneMask = null;

                            function initPhoneMask(initial) {
                                // Türk GSM: +90 sonrası daima 5 ile başlar (5XX XXX XX XX)
                                phoneMask = IMask(phoneEl, {
                                    mask: '+9\\0 N00 000 00 00',
                                    definitions: { 'N': /[5]/ }
                                });
                                if (initial) phoneMask.value = initial;
                                phoneMask.on('accept', function () { self.phone = phoneMask.value; });
                            }

                            if (self.phone) {
                                initPhoneMask(self.phone);
                                self.phone = phoneMask.value;
                                phoneEl.dispatchEvent(new Event('input', { bubbles: true }));
                            } else {
                                function onFirstKeyDown(e) {
                                    if (e.key !== '5') return;
                                    e.preventDefault();
                                    phoneEl.removeEventListener('keydown', onFirstKeyDown);
                                    phoneEl.removeEventListener('input', onAutoFill);
                                    initPhoneMask('+90 ' + e.key);
                                    phoneMask.updateCursor(phoneMask.value.length);
                                    self.phone = phoneMask.value;
                                }

                                // Tarayıcı autocomplete veya yapıştırma: keydown tetiklenmez,
                                // input eventi gelir; tam numara varsa mask'i başlat.
                                function onAutoFill() {
                                    if (phoneMask !== null) return;
                                    var raw = phoneEl.value.replace(/\D/g, '');
                                    if (raw.length < 10) return;
                                    if (raw.startsWith('90') && raw.length >= 12) raw = raw.substring(2);
                                    else if (raw.startsWith('0')) raw = raw.substring(1);
                                    phoneEl.removeEventListener('keydown', onFirstKeyDown);
                                    phoneEl.removeEventListener('input', onAutoFill);
                                    initPhoneMask('+90 ' + raw);
                                    phoneMask.updateCursor(phoneMask.value.length);
                                    self.phone = phoneMask.value;
                                }

                                phoneEl.addEventListener('keydown', onFirstKeyDown);
                                phoneEl.addEventListener('input', onAutoFill);
                            }
                        }

                        var tcknEl = document.getElementById('Tckn');
                        if (tcknEl) {
                            var tcknMask = IMask(tcknEl, { mask: '00000000000' });
                            self._tcknMask = tcknMask;
                            if (self.tckn) {
                                tcknMask.value = self.tckn;
                                tcknMask.updateValue();
                                self.tckn = tcknMask.value;
                                tcknEl.dispatchEvent(new Event('input', { bubbles: true }));
                            }
                            tcknMask.on('accept', function () { self.tckn = tcknMask.value; });
                        }
                    });

                },

                validateTckn(tckn) {
                    if (!/^\d{11}$/.test(tckn)) return false;
                    if (tckn[0] === '0') return false;
                    var d = tckn.split('').map(Number);
                    var oddSum  = d[0] + d[2] + d[4] + d[6] + d[8];
                    var evenSum = d[1] + d[3] + d[5] + d[7];
                    if ((oddSum * 7 - evenSum) % 10 !== d[9]) return false;
                    var sum10 = d[0]+d[1]+d[2]+d[3]+d[4]+d[5]+d[6]+d[7]+d[8]+d[9];
                    return sum10 % 10 === d[10];
                },

                canProceed() {
                    return this.phone.replace(/\D/g, '').length >= 12;
                },

                explainWhyDisabled() {
                    if (this.phone.replace(/\D/g, '').length < 12)
                        toast.warning('Telefon numaranızı eksiksiz giriniz.');
                },

                async proceed() {
                    if (!this.canProceed() || this.proceeding) return;

                    this.proceeding = true;

                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    var params = new URLSearchParams();
                    params.append('__RequestVerificationToken', token);
                    params.append('PhoneNumber', this.phone);

                    try {
                        var resp = await fetch('/login?handler=SendOtp', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: params
                        });
                        var json = await resp.json();
                        if (json.success) {
                            if (!json.isCustomer) {
                                window.location.href = '/register';
                                return;
                            }
                            toast.success('SMS kodunuz gönderildi.');
                            this.step = 2;
                            this.startTimer();
                        } else {
                            toast.error(json.message || 'SMS gönderilemedi. Lütfen tekrar deneyin.');
                        }
                    } catch (_) {
                        toast.error('Bağlantı hatası oluştu.');
                    } finally {
                        this.proceeding = false;
                    }
                },

                loginWithTckn() {
                    this.tcknError    = false;
                    this.tcknErrorMsg = '';

                    if (this.tckn.length < 11) {
                        toast.warning('TCKN alanını eksiksiz doldurunuz.');
                        this.tcknError    = true;
                        this.tcknErrorMsg = 'TCKN alanını eksiksiz doldurunuz.';
                        return;
                    }
                    if (!this.validateTckn(this.tckn)) {
                        toast.warning('Geçerli bir TC Kimlik Numarası giriniz.');
                        this.tcknError    = true;
                        this.tcknErrorMsg = 'Geçerli bir TC Kimlik Numarası giriniz.';
                        return;
                    }

                    this.showOtpModal     = true;
                    this.otpVerifyError   = false;
                    this.otpVerifyErrorMsg = '';
                    this.otpCode          = '';
                },

                maskedPhone() {
                    var digits = this.phone.replace(/\D/g, '');
                    if (digits.length < 12) return this.phone;
                    return '+90 ' + digits.substring(2, 5) + ' *** ** ' + digits.substring(10, 12);
                },

                timerDisplay() {
                    var m = Math.floor(this.timer / 60);
                    var s = this.timer % 60;
                    return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
                },

                startTimer() {
                    this.timer = 180;
                    if (this.timerInterval) clearInterval(this.timerInterval);
                    var self = this;
                    this.timerInterval = setInterval(function () {
                        if (self.timer > 0) {
                            self.timer--;
                        } else {
                            clearInterval(self.timerInterval);
                            self.showOtpModal = false;
                            self.step         = 1;
                            self.otpCode      = '';
                            self.tckn         = '';
                            if (self._tcknMask) { self._tcknMask.value = ''; self._tcknMask.updateValue(); }
                            toast.error('SMS doğrulama süresi doldu. Lütfen tekrar deneyin.');
                        }
                    }, 1000);
                },

                async verifyOtp() {
                    this.verifyingOtp = true;

                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    var params = new URLSearchParams();
                    params.append('__RequestVerificationToken', token);
                    params.append('PhoneNumber', this.phone);
                    params.append('OtpCode', this.otpCode);
                    params.append('Tckn', this.tckn);

                    try {
                        var resp = await fetch('/login?handler=VerifyOtp', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: params
                        });
                        var json = await resp.json();
                        if (json.success) {
                            localStorage.setItem('auth_token', json.token);
                            document.cookie = 'auth_token=' + json.token + '; path=/; SameSite=Lax';
                            if (this.rememberMe) {
                                localStorage.setItem('remember_me', JSON.stringify({ phone: this.phone, tckn: this.tckn }));
                            } else {
                                localStorage.removeItem('remember_me');
                            }
                            toast.success('Giriş başarılı, yönlendiriliyorsunuz...');
                            window.location.href = '/anasayfa';
                        } else if (json.tcknMismatch) {
                            clearInterval(this.timerInterval);
                            this.showOtpModal = false;
                            this.step         = 1;
                            this.otpCode      = '';
                            this.tckn         = '';
                            if (this._tcknMask) { this._tcknMask.value = ''; this._tcknMask.updateValue(); }
                            toast.error(json.message || 'TC bilgisi eşleşmemektedir.');
                        } else {
                            toast.error(json.message || 'Kod hatalı. Lütfen tekrar deneyin.');
                        }
                    } catch (_) {
                        toast.error('Bağlantı hatası oluştu.');
                    } finally {
                        this.verifyingOtp = false;
                    }
                }
            };
        }
    </script>

</body>
</html>
