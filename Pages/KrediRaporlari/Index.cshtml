@page
@model MyApp.Web.Pages.KrediRaporlari.IndexModel
@{
    ViewData["Title"]      = "Kredi Raporlarım";
    ViewData["ActivePage"] = "Kredi Raporların";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    @@media (max-width: 767px) {
        .rapor-summary-grid   { grid-template-columns: 1fr !important; }
        .rapor-title-bar      { flex-direction: column !important; align-items: flex-start !important; gap: 12px !important; }
        .rapor-yeni-btn       { width: 100% !important; justify-content: center !important; }
        .rapor-item-wrap      { padding: 16px !important; gap: 12px !important; }
        .rapor-item-right     { display: none !important; }
        .rapor-mobile-actions { display: flex !important; }
        .rapor-badge-mobile   { display: inline-flex !important; }
        .rapor-meta-row       { flex-wrap: wrap; gap: 8px !important; }
        .rapor-icon-box       { width: 44px !important; height: 44px !important; }
        .rapor-title-text     { font-size: 15px !important; }
        .rapor-list-header    { padding: 16px !important; }
    }
    @@media (min-width: 768px) {
        .rapor-mobile-actions { display: none !important; }
        .rapor-badge-mobile   { display: none !important; }
    }
</style>

<div class="flex flex-col gap-6">

    @* ─── PageBar ─── *@
    <div class="flex justify-between items-center pb-3 border-b border-[#DCE3FB]">

        <button class="flex items-center gap-1 font-[Poppins] text-sm font-normal text-[#1B4092]">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M12.5 15L7.5 10L12.5 5" stroke="#1B4092" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Geri
        </button>

        <div class="flex flex-col items-end">
            <span class="font-[Poppins] text-sm font-normal text-[#003F75]">İnteraktif Kredi</span>
            <span class="font-[Poppins] text-lg font-light  text-[#003F75]">WEB Şube</span>
        </div>

    </div>

    @* ─── İçerik ─── *@
    <div class="flex flex-col gap-8">

        @* Başlık + Yeni Rapor Butonu *@
        <div class="rapor-title-bar flex justify-between items-center">
            <div>
                <h1 class="font-[Manrope] text-[30px] font-bold leading-9 text-[#101828]">Kredi Raporların</h1>
                <p class="font-['Source_Sans_3'] text-base text-[#4A5565] mt-1">Tüm kredi raporlarına buradan ulaşabilirsiniz</p>
            </div>
            <a href="/KrediBasvurusu" class="rapor-yeni-btn flex items-center gap-2 bg-[#0056B3] hover:bg-[#004799] text-white font-['Source_Sans_3'] text-base font-medium rounded-[10px] px-5 py-[10px] transition-colors no-underline">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M8 3.33V12.67M3.33 8H12.67" stroke="white" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Yeni Rapor Oluştur
            </a>
        </div>

        @* ─── Özet Kartlar ─── *@
        <div class="rapor-summary-grid grid grid-cols-3 gap-6">

            @* Toplam Rapor *@
            <div class="rounded-[14px] border border-[#BEDBFF] pt-[25px] px-[25px] pb-[1px] h-[110px] flex flex-col gap-2"
                 style="background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);">
                <div class="flex justify-between items-center">
                    <span class="font-['Source_Sans_3'] text-sm font-medium text-[#1447E6]">Toplam Rapor</span>
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M3.33 2.5H11.67L16.67 7.5V17.5H3.33V2.5Z" stroke="#155DFC" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M11.67 2.5V7.5H16.67"                      stroke="#155DFC" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 11.67H13.67"                          stroke="#155DFC" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 14.17H13.67"                          stroke="#155DFC" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 9.17H9.33"                            stroke="#155DFC" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <span class="font-['Source_Sans_3'] text-2xl font-bold text-[#1C398E]">@Model.ViewModel.TotalCount</span>
            </div>

            @* Hazır Rapor *@
            <div class="rounded-[14px] border border-[#B9F8CF] pt-[25px] px-[25px] pb-[1px] h-[110px] flex flex-col gap-2"
                 style="background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);">
                <div class="flex justify-between items-center">
                    <span class="font-['Source_Sans_3'] text-sm font-medium text-[#008236]">Hazır Rapor</span>
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M3.33 2.5H11.67L16.67 7.5V17.5H3.33V2.5Z" stroke="#00A63E" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M11.67 2.5V7.5H16.67"                      stroke="#00A63E" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 11.67H13.67"                          stroke="#00A63E" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 14.17H13.67"                          stroke="#00A63E" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 9.17H9.33"                            stroke="#00A63E" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <span class="font-['Source_Sans_3'] text-2xl font-bold text-[#0D542B]">@Model.ViewModel.ReadyCount</span>
            </div>

            @* İşleniyor *@
            <div class="rounded-[14px] border border-[#FFF085] pt-[25px] px-[25px] pb-[1px] h-[110px] flex flex-col gap-2"
                 style="background: linear-gradient(135deg, #FEFCE8 0%, #FEF9C2 100%);">
                <div class="flex justify-between items-center">
                    <span class="font-['Source_Sans_3'] text-sm font-medium text-[#A65F00]">İşleniyor</span>
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M3.33 2.5H11.67L16.67 7.5V17.5H3.33V2.5Z" stroke="#D08700" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M11.67 2.5V7.5H16.67"                      stroke="#D08700" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 11.67H13.67"                          stroke="#D08700" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 14.17H13.67"                          stroke="#D08700" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.33 9.17H9.33"                            stroke="#D08700" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <span class="font-['Source_Sans_3'] text-2xl font-bold text-[#733E0A]">@Model.ViewModel.ProcessingCount</span>
            </div>

        </div>

        @* ─── Rapor Listesi ─── *@
        <div class="bg-white border border-[#E5E7EB] rounded-2xl overflow-hidden">

            @* Başlık *@
            <div class="rapor-list-header px-6 py-6 border-b border-[#E5E7EB]">
                <h2 class="font-[Manrope] text-xl font-bold text-[#101828]">Kredi Detay Raporu</h2>
            </div>

            @* Rapor Satırları *@
            <div class="divide-y divide-[#E5E7EB]">
                @for (int i = 0; i < Model.ViewModel.Reports.Count; i++)
                {
                    var report  = Model.ViewModel.Reports[i];
                    var isFirst = i == 0;

                    <div class="rapor-item-wrap flex items-start px-6 py-6 gap-4">

                        @* Dosya ikonu *@
                        <div class="rapor-icon-box flex-shrink-0 w-[50px] h-[50px] bg-[#EFF6FF] border border-[#DBEAFE] rounded-[10px] flex items-center justify-center">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M4 3H14L20 9V21H4V3Z" stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 3V9H20"           stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M8 14H16"             stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M8 17H16"             stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M8 11H10"             stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>

                        @* İçerik alanı *@
                        <div class="flex-1 min-w-0">

                            @* Başlık satırı + mobil aksiyon butonları *@
                            <div class="flex items-start justify-between gap-2">
                                <div class="flex flex-col gap-0.5 min-w-0">
                                    <h3 class="rapor-title-text font-[Manrope] text-lg font-semibold text-[#101828] truncate">@report.Title</h3>
                                    <p  class="font-['Source_Sans_3'] text-sm text-[#6A7282]">Rapor No: @report.ReportNo</p>
                                </div>

                                @* Mobil aksiyon butonları (ikon-only) *@
                                @if (report.IsReady)
                                {
                                    <div class="rapor-mobile-actions items-center gap-1 flex-shrink-0">
                                        <a href="@(string.IsNullOrEmpty(report.Rid) ? "/KrediRaporlari/KurDetay" : $"/KrediRaporlari/KurDetay?rid={report.Rid}")"
                                           class="w-9 h-9 flex items-center justify-center rounded-[10px] hover:bg-gray-100 transition-colors">
                                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                                <path d="M1.67 10C1.67 10 5 5.83 10 5.83C15 5.83 18.33 10 18.33 10C18.33 10 15 14.17 10 14.17C5 14.17 1.67 10 1.67 10Z" stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                                <circle cx="10" cy="10" r="2.5" stroke="#6A7282" stroke-width="1.67"/>
                                            </svg>
                                        </a>
                                        <a asp-page-handler="DownloadPdf"
                                           asp-route-reportNo="@report.ReportNo"
                                           class="w-9 h-9 flex items-center justify-center rounded-[10px] hover:bg-gray-100 transition-colors">
                                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                                <path d="M2.5 14.17V16.67H17.5V14.17" stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M10 12.5V3.33"               stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M10 12.5L6.67 9.17"          stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M10 12.5L13.33 9.17"         stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </a>
                                    </div>
                                }
                            </div>

                            @* Durum badge — sadece mobilde burada gösterilir *@
                            <div class="rapor-badge-mobile mt-2">
                                <span class="inline-flex items-center px-3 py-1 rounded-full font-['Source_Sans_3'] text-sm font-medium @report.StatusBgClass">
                                    @report.Status
                                </span>
                            </div>

                            @* Tarih + Tür *@
                            <div class="rapor-meta-row flex items-center gap-6 mt-3">
                                <div class="flex items-center gap-2">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                        <rect x="1.33" y="2.67" width="13.33" height="11.33" rx="1.33" stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M5.33 1.33V4"     stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M10.67 1.33V4"    stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M1.33 6.67H14.67" stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span class="font-['Source_Sans_3'] text-sm text-[#4A5565]">@report.Date</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                        <path d="M2.67 2H9.33L13.33 6V14H2.67V2Z" stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M9.33 2V6H13.33"                  stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M5.33 9.33H10.67"                 stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M5.33 11.67H9.33"                 stroke="#4A5565" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span class="font-['Source_Sans_3'] text-sm text-[#4A5565]">@report.ReportType</span>
                                </div>
                            </div>

                        </div>

                        @* Desktop sağ sütun: durum badge + aksiyon butonları *@
                        <div class="rapor-item-right flex items-center gap-3 flex-shrink-0">

                            <span class="inline-flex items-center px-3 py-1 rounded-full font-['Source_Sans_3'] text-sm font-medium @report.StatusBgClass">
                                @report.Status
                            </span>

                            @if (report.IsReady)
                            {
                                var kurDetayUrl = string.IsNullOrEmpty(report.Rid)
                                    ? "/KrediRaporlari/KurDetay?tab=kisisel"
                                    : $"/KrediRaporlari/KurDetay?rid={report.Rid}&tab=kisisel";
                                @if (isFirst)
                                {
                                    <a href="@kurDetayUrl" class="flex items-center gap-2 bg-[#0056B3] hover:bg-[#004799] text-white font-['Source_Sans_3'] text-sm font-medium rounded-[10px] px-4 py-2 transition-colors">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                            <path d="M1.33 8C1.33 8 4 4.67 8 4.67C12 4.67 14.67 8 14.67 8C14.67 8 12 11.33 8 11.33C4 11.33 1.33 8 1.33 8Z" stroke="white" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                                            <circle cx="8" cy="8" r="2" stroke="white" stroke-width="1.33"/>
                                        </svg>
                                        Raporu Gör
                                    </a>
                                }
                                else
                                {
                                    <a href="@kurDetayUrl" class="w-9 h-9 flex items-center justify-center rounded-[10px] hover:bg-gray-100 transition-colors">
                                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                            <path d="M1.67 10C1.67 10 5 5.83 10 5.83C15 5.83 18.33 10 18.33 10C18.33 10 15 14.17 10 14.17C5 14.17 1.67 10 1.67 10Z" stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                            <circle cx="10" cy="10" r="2.5" stroke="#6A7282" stroke-width="1.67"/>
                                        </svg>
                                    </a>
                                }

                                <a asp-page-handler="DownloadPdf"
                                   asp-route-reportNo="@report.ReportNo"
                                   title="PDF İndir"
                                   class="w-9 h-9 flex items-center justify-center rounded-[10px] hover:bg-gray-100 transition-colors">
                                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                        <path d="M2.5 14.17V16.67H17.5V14.17" stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M10 12.5V3.33"               stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M10 12.5L6.67 9.17"          stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M10 12.5L13.33 9.17"         stroke="#6A7282" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </a>
                            }

                        </div>

                    </div>
                }
            </div>

        </div>

    </div>
</div>
