@page
@model MyApp.Web.Pages.KrediRaporlari.KurDetayModel
@{
    ViewData["Title"] = "KUR Detay";
    ViewData["ActivePage"] = "Kredi Raporların";

    var market = Model.ViewModel.MarketAnalysis;
}

<div class="p-3 md:p-6 flex flex-col items-center gap-4">

    @* ─── Tab geçişi ─── *@
    <div class="flex justify-center items-center w-full">
        <div class="flex items-center bg-[#F2F8FF] rounded-[10px] p-[5px] h-12 w-fit">

            <a href="?tab=kisisel"
               class="flex items-center gap-2 rounded-[10px] text-[12px] font-normal font-[Poppins]
                      @(Model.ViewModel.ActiveTab == "kisisel"
                          ? "grow bg-white shadow-[0px_0px_5px_rgba(46,109,248,0.5)] px-[15px] py-[10px] text-[#003F75]"
                          : "bg-transparent p-[10px] text-black/50")">
                <img src="/icons/@(Model.ViewModel.ActiveTab == "kisisel" ? "" : "gray/")user-check-01.svg" width="18" height="14" class="flex-shrink-0" alt="">
                Kişisel Raporum
            </a>

            <div class="w-px h-5 bg-gray-300 flex-shrink-0"></div>

            <a href="?tab=piyasa"
               class="flex items-center gap-2 rounded-[10px] text-[12px] font-normal font-[Poppins]
                      @(Model.ViewModel.ActiveTab == "piyasa"
                          ? "grow bg-white shadow-[0px_0px_5px_rgba(46,109,248,0.5)] px-[15px] py-[10px] text-[#003F75]"
                          : "bg-transparent p-[10px] text-black/50")">
                <img src="/icons/@(Model.ViewModel.ActiveTab == "piyasa" ? "navy/" : "")line-chart-up-02.svg" width="18" height="15" class="flex-shrink-0" alt="">
                Piyasa Analizi
            </a>

        </div>
    </div>

    @* ─── Alt başlık (sana özel ✨ yapay zeka analizi…) ─── *@
    <div class="flex justify-center items-center gap-1">
        <span class="font-[Poppins] text-[12px] font-normal leading-[18px] text-[#003F75]">Sana özel</span>
        <img src="/icons/primary/sparkle.svg" width="14" height="14" alt="">
        <span class="font-[Poppins] text-[12px] font-normal leading-[18px] text-[#003F75]">yapay zeka analizi ve finansal yol haritan</span>
    </div>

    @* ─── Tab içeriği ─── *@
    @if (Model.ViewModel.ActiveTab == "piyasa")
    {
        <div class="w-full max-w-[1210px] flex flex-col gap-5 px-2 sm:px-4 pt-2 pb-6">

            @* Info banner *@
            <div class="bg-[#F9FAFB] border border-[#DCE3FB] rounded-2xl text-center" style="padding: 20px 16px;">
                <span class="font-['Poppins'] font-medium" style="font-size: 13px; line-height: 20px; color: #0A0A0A;">
                    Kişisel durumunu analiz ettik. Şimdi de piyasadaki koşulların senin için ne anlama geldiğine bakalım.
                </span>
            </div>

            @* ─── Kart 1 · Faiz Oranı Trendi ─── *@
            <div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl overflow-hidden">

                <div class="flex flex-col gap-1 px-4 py-3" style="border-bottom: 1px solid rgba(0,0,0,0.1);">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <img src="/icons/primary/activity.svg" width="20" height="20" alt="">
                            <span class="font-[Poppins] text-[13px] font-semibold leading-5 text-[#003F75]">Faiz Oranı Trendi</span>
                        </div>
                        <button type="button"
                                class="flex items-center gap-1 bg-white border border-[#E5E7EB] shadow-[0px_1px_3px_rgba(0,0,0,0.1),0px_1px_2px_-1px_rgba(0,0,0,0.1)] rounded-[10px] px-2 py-1">
                            <span class="font-[Poppins] text-[11px] font-normal leading-4 text-[#003F75]">@market.InterestRateTrend.ProductLabel</span>
                            <img src="/icons/navy/chevron-down.svg" width="12" height="12" alt="">
                        </button>
                    </div>
                    <p class="font-[Poppins] italic font-light" style="font-size: 10px; line-height: 15px; color: rgba(0,0,0,0.5);">
                        Faiz oranı trendi, bankaların geçen hafta müşterilere fiilen kullandırılan kredilerin ağırlıklı ortalamasıdır.
                    </p>
                </div>

                @* Koyu mavi gövde — padding: 16px 16px 0px, gap: 12px *@
                <div class="flex flex-col gap-3" style="background: #122B62; padding: 16px 16px 0px;">

                    @* Üst satır: sol = label + %5,04 / Ay  |  sağ = -0.45% + Son 3 Ay *@
                    <div class="flex justify-between items-start">
                        <div class="flex flex-col gap-0.5">
                            <span class="font-['Poppins'] text-[10px] font-light leading-[15px] text-white" style="opacity: 0.8;">@market.InterestRateTrend.RateLabel</span>
                            <div class="flex items-end gap-1.5">
                                <span class="font-['Poppins'] text-[28px] font-bold leading-[42px] text-white">@market.InterestRateTrend.RateValue</span>
                                <span class="font-['Poppins'] text-[12px] font-light leading-[18px] text-white" style="padding-bottom: 4px;">@market.InterestRateTrend.PeriodSuffix</span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-0.5">
                            <div class="flex items-center gap-1">
                                <img src="/icons/green/trend-up.svg" width="16" height="16" alt="">
                                <span class="font-['Poppins'] text-[11px] font-normal leading-4 text-right" style="color: #46CA88;">@market.InterestRateTrend.ChangePercent</span>
                            </div>
                            <span class="font-['Poppins'] text-[10px] font-light leading-[15px] text-right" style="color: #46CA88;">@market.InterestRateTrend.ChangePeriodLabel</span>
                        </div>
                    </div>

                    @* Chart line — düz yatay yeşil çizgi *@
                    <div class="relative w-full" style="height: 72px;">
                        <div style="position: absolute; left: 0.44%; right: 0.44%; top: 34.72%; border-top: 2.5px solid #46CA88;"></div>
                    </div>

                    @* Alt satır: iki pill *@
                    <div class="flex items-center justify-between flex-wrap gap-2" style="padding-bottom: 16px;">
                        <span class="font-['Poppins'] text-[9px] font-light leading-[14px] text-white"
                              style="padding: 4px 12px; background: rgba(249,250,251,0.25); border: 1px solid rgba(0,0,0,0.25); border-radius: 9999px;">
                            @market.InterestRateTrend.MarketAverageLabel
                        </span>
                        <span class="flex items-center gap-1 font-['Poppins'] text-[9px] font-semibold leading-[14px] text-white"
                              style="padding: 4px 10px; background: rgba(70,202,136,0.6); border: 1px solid rgba(0,0,0,0.25); border-radius: 9999px;">
                            <img src="/icons/white/sparkle.svg" width="12" height="12" alt="">
                            @market.InterestRateTrend.OpportunityLabel
                        </span>
                    </div>

                </div>
            </div>

            @* ─── Kart 2 · Kredi Nabzı ─── *@
            <div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl overflow-hidden">
                <div class="flex flex-col gap-1 px-4 py-3" style="border-bottom: 1px solid rgba(0,0,0,0.1);">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <img src="/icons/primary/heartbeat.svg" width="20" height="20" alt="">
                            <span class="font-[Poppins] text-[13px] font-semibold leading-5 text-[#003F75]">Kredi Nabzı</span>
                        </div>
                        <button type="button"
                                class="flex items-center gap-1 bg-white border border-[#E5E7EB] shadow-[0px_1px_3px_rgba(0,0,0,0.1),0px_1px_2px_-1px_rgba(0,0,0,0.1)] rounded-[10px] px-2 py-1">
                            <span class="font-[Poppins] text-[11px] font-normal leading-4 text-[#003F75]">@market.CreditPulse.ProductLabel</span>
                            <img src="/icons/navy/chevron-down.svg" width="12" height="12" alt="">
                        </button>
                    </div>
                    <p class="font-[Poppins] italic font-light" style="font-size: 10px; line-height: 15px; color: rgba(0,0,0,0.5);">
                        @market.CreditPulse.Description
                    </p>
                </div>

                <partial name="~/Partials/_MarketSliderCard.cshtml" model="market.CreditPulse" />
            </div>

            @* ─── Kart 3 · Kredi Talebi Radarı ─── *@
            <div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl overflow-hidden">
                <div class="flex flex-col gap-1 px-4 py-3" style="border-bottom: 1px solid rgba(0,0,0,0.1);">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <img src="/icons/primary/radar.svg" width="20" height="20" alt="">
                            <span class="font-[Poppins] text-[13px] font-semibold leading-5 text-[#003F75]">Kredi Talebi Radarı</span>
                        </div>
                        <button type="button"
                                class="flex items-center gap-1 bg-white border border-[#E5E7EB] shadow-[0px_1px_3px_rgba(0,0,0,0.1),0px_1px_2px_-1px_rgba(0,0,0,0.1)] rounded-[10px] px-2 py-1">
                            <span class="font-[Poppins] text-[11px] font-normal leading-4 text-[#003F75]">@market.CreditDemandRadar.ProductLabel</span>
                            <img src="/icons/navy/chevron-down.svg" width="12" height="12" alt="">
                        </button>
                    </div>
                    <p class="font-[Poppins] italic font-light" style="font-size: 10px; line-height: 15px; color: rgba(0,0,0,0.5);">
                        @market.CreditDemandRadar.Description
                    </p>
                </div>

                <partial name="~/Partials/_MarketSliderCard.cshtml" model="market.CreditDemandRadar" />
            </div>

            @* ─── Kart 4 · Mantıklı Kredi Oranı ─── *@
            <div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl overflow-hidden">
                <div class="flex flex-col gap-1 px-4 py-3" style="border-bottom: 1px solid rgba(0,0,0,0.1);">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <img src="/icons/primary/info-circle.svg" width="20" height="20" alt="">
                            <span class="font-[Poppins] text-[13px] font-semibold leading-5 text-[#003F75]">Mantıklı Kredi Oranı</span>
                        </div>
                        <button type="button"
                                class="flex items-center gap-1 bg-white border border-[#E5E7EB] shadow-[0px_1px_3px_rgba(0,0,0,0.1),0px_1px_2px_-1px_rgba(0,0,0,0.1)] rounded-[10px] px-2 py-1">
                            <span class="font-[Poppins] text-[11px] font-normal leading-4 text-[#003F75]">@market.ReasonableCreditRate.ProductLabel</span>
                            <img src="/icons/navy/chevron-down.svg" width="12" height="12" alt="">
                        </button>
                    </div>
                    <p class="font-[Poppins] italic font-light" style="font-size: 10px; line-height: 15px; color: rgba(0,0,0,0.5);">
                        @market.ReasonableCreditRate.Description
                    </p>
                </div>

                @* Beyaz gövde *@
                @{
                    var ratePct = Math.Clamp(market.ReasonableCreditRate.SliderPercent, 0, 100);
                }
                <div class="relative w-full bg-white" style="height: 188px;">

                    <div class="absolute text-center" style="left: 16px; right: 16px; top: 16px;">
                        <span class="font-['Poppins'] font-bold" style="font-size: 34px; line-height: 51px; color: #003F75;">@market.ReasonableCreditRate.RateValue</span>
                    </div>

                    <p class="absolute text-center font-['Poppins'] font-light" style="left: 16px; right: 16px; top: 71px; font-size: 11px; line-height: 16px; color: rgba(0,0,0,0.5);">
                        @market.ReasonableCreditRate.SubText
                    </p>

                    <div class="absolute" style="left: 16px; right: 16px; top: 103.5px;">
                        <div class="relative w-full rounded-full" style="height: 20px; background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);">
                            <div class="absolute rounded-full bg-white border border-[#E5E7EB]"
                                 style="width: 10px; height: 28px; top: -4px; left: calc(@ratePct% - 5px);
                                        box-shadow: 0px 4px 6px -1px rgba(0,0,0,0.1), 0px 2px 4px -2px rgba(0,0,0,0.1);"></div>
                        </div>
                        <div class="flex justify-between mt-2 px-1">
                            <span class="font-['Poppins'] font-normal" style="font-size: 9px; line-height: 14px; color: #122B62; opacity: 0.75;">@market.ReasonableCreditRate.LeftLabel</span>
                            <span class="font-['Poppins'] font-normal" style="font-size: 9px; line-height: 14px; color: #2E6DF8; opacity: 0.75;">@market.ReasonableCreditRate.MiddleLabel</span>
                            <span class="font-['Poppins'] font-normal" style="font-size: 9px; line-height: 14px; color: #37C6B3; opacity: 0.75;">@market.ReasonableCreditRate.RightLabel</span>
                        </div>
                    </div>

                    <div class="absolute flex items-center gap-1.5" style="left: 16px; top: 157px;">
                        <img src="/icons/primary/sparkle-ai.svg" width="12" height="12" alt="">
                        <span class="font-['Poppins'] italic font-normal" style="font-size: 10px; line-height: 15px; color: #2E6DF8;">@market.ReasonableCreditRate.AiText</span>
                    </div>

                </div>
            </div>

        </div>
    }
</div>
