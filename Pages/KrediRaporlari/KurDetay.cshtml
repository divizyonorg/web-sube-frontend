@page
@model MyApp.Web.Pages.KrediRaporlari.KurDetayModel
@{
    ViewData["Title"] = "KUR Detay";
    ViewData["ActivePage"] = "Kredi Raporların";

    var market = Model.ViewModel.MarketAnalysis;
}

<div class="p-3 md:p-6 flex flex-col items-center gap-4">

    @* ─── Tab geçişi ─── *@
    <div class="flex justify-center items-center w-full">
        <div class="flex items-center bg-[#F2F8FF] rounded-[10px] p-[5px] h-12 w-fit">

            <a href="?tab=kisisel@(!string.IsNullOrEmpty(Model.ViewModel.Rid) ? $"&rid={Model.ViewModel.Rid}" : "")"
               class="flex items-center gap-2 rounded-[10px] text-[12px] font-normal font-[Poppins]
                      @(Model.ViewModel.ActiveTab == "kisisel"
                          ? "grow bg-white shadow-[0px_0px_5px_rgba(46,109,248,0.5)] px-[15px] py-[10px] text-[#003F75]"
                          : "bg-transparent p-[10px] text-black/50")">
                <img src="/icons/@(Model.ViewModel.ActiveTab == "kisisel" ? "Outher/" : "gray/")user-check-01.svg" width="18" height="14" class="flex-shrink-0" alt="">
                Kişisel Raporum
            </a>

            <div class="w-px h-5 bg-gray-300 flex-shrink-0"></div>

            <a href="?tab=piyasa@(!string.IsNullOrEmpty(Model.ViewModel.Rid) ? $"&rid={Model.ViewModel.Rid}" : "")"
               class="flex items-center gap-2 rounded-[10px] text-[12px] font-normal font-[Poppins]
                      @(Model.ViewModel.ActiveTab == "piyasa"
                          ? "grow bg-white shadow-[0px_0px_5px_rgba(46,109,248,0.5)] px-[15px] py-[10px] text-[#003F75]"
                          : "bg-transparent p-[10px] text-black/50")">
                <img src="/icons/@(Model.ViewModel.ActiveTab == "piyasa" ? "navy/" : "Outher/")line-chart-up-02.svg" width="18" height="15" class="flex-shrink-0" alt="">
                Piyasa Analizi
            </a>

        </div>
    </div>

    @* ─── Alt başlık (sana özel ✨ yapay zeka analizi…) ─── *@
    <div class="flex justify-center items-center gap-1">
        <span class="font-[Poppins] text-[12px] font-normal leading-[18px] text-[#003F75]">Sana özel</span>
        <img src="/icons/primary/sparkle.svg" width="14" height="14" alt="">
        <span class="font-[Poppins] text-[12px] font-normal leading-[18px] text-[#003F75]">yapay zeka analizi ve finansal yol haritan</span>
    </div>

    @* ─── Tab içeriği ─── *@
    @if (Model.ViewModel.ActiveTab == "kisisel")
    {
        @if (Model.ViewModel.IsError)
        {
            <div class="mt-4 w-full flex flex-col items-center px-4">
                <div class="w-full max-w-sm bg-white border border-[#DCE3FB] rounded-2xl overflow-hidden">

                    <div class="bg-[linear-gradient(120.44deg,#2E6DF8_70.34%,#1B4092_100.84%)] px-5 py-4 flex items-center gap-3">
                        <img src="~/icons/white/loan-app.svg" class="w-6 h-6 shrink-0" alt="">
                        <span class="font-[Poppins] font-medium text-[14px] text-white">Kişisel Raporunuz Henüz Hazır Değil</span>
                    </div>

                    <div class="flex flex-col items-center gap-5 px-6 py-6">
                        <p class="font-[Poppins] font-normal text-[13px] text-[#003F75] text-center leading-[20px]">
                            Yapay zeka destekli kişisel raporunuzu görebilmek için önce kredi başvurusu yapmanız gerekiyor. Başvurunuz onaylandıktan sonra raporunuz burada hazır olacak.
                        </p>

                        <div class="flex flex-col w-full gap-[10px]">
                            <div class="flex items-center gap-2">
                                <img src="~/icons/check-circle-broken.svg" class="w-5 h-5 shrink-0" alt="">
                                <span class="font-[Poppins] font-normal text-[12px] text-[#3AD7B3]">Finansal durum analizi</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <img src="~/icons/check-circle-broken.svg" class="w-5 h-5 shrink-0" alt="">
                                <span class="font-[Poppins] font-normal text-[12px] text-[#3AD7B3]">Kredi uygunluk skoru</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <img src="~/icons/check-circle-broken.svg" class="w-5 h-5 shrink-0" alt="">
                                <span class="font-[Poppins] font-normal text-[12px] text-[#3AD7B3]">Kişiselleştirilmiş kredi önerileri</span>
                            </div>
                        </div>

                        <a href="/KrediBasvurusu"
                           class="flex items-center justify-center gap-2 w-full h-[44px] bg-[#0056B3] rounded-[40px] font-[Poppins] font-medium text-[14px] text-white no-underline">
                            <img src="~/icons/white/credit-card-01.svg" class="w-5 h-5" alt="">
                            Kredi Başvurusu Yap
                        </a>

                        <p class="font-[Poppins] font-light text-[11px] text-gray-400 text-center">
                            @Model.ViewModel.ErrorMessage.Replace("(PENDING)", "").Trim()
                        </p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="mt-6 w-full">
                <partial name="~/Partials/_UygunlukSeridi.cshtml" model="Model.ViewModel.KisiselRapor.UygunlukSeridi" />
            </div>
        }
    }

    @if (Model.ViewModel.ActiveTab == "piyasa")
    {
        <div class="w-full max-w-[1210px] flex flex-col gap-5 px-2 sm:px-4 pt-2 pb-6">

            @* Info banner *@
            <div class="bg-[#F9FAFB] border border-[#DCE3FB] rounded-2xl text-center py-5 px-4">
                <span class="font-['Poppins'] font-medium text-[13px] leading-5 text-[#0A0A0A]">
                    Kişisel durumunu analiz ettik. Şimdi de piyasadaki koşulların senin için ne anlama geldiğine bakalım.
                </span>
            </div>

            @* ─── Kart 1 · Faiz Oranı Trendi ─── *@
            <partial name="~/Partials/KurDetay/_FaizOraniTrendiCard.cshtml" model="market.InterestRateTrend" />

            @* ─── Kart 2 · Kredi Nabzı ─── *@
            <partial name="~/Partials/KurDetay/_KrediNabziCard.cshtml" model="market.CreditPulse" />

            @* ─── Kart 3 · Kredi Talebi Radarı ─── *@
            <partial name="~/Partials/KurDetay/_KrediTalebiRadariCard.cshtml" model="market.CreditDemandRadar" />

            @* ─── Kart 4 · Mantıklı Kredi Oranı ─── *@
            <partial name="~/Partials/KurDetay/_MantikliKrediOraniCard.cshtml" model="market.ReasonableCreditRate" />

        </div>
    }
</div>

<script>
    (function () {
        var savedY;
        document.addEventListener('htmx:beforeRequest', function () { savedY = window.scrollY; });
        document.addEventListener('htmx:afterSettle', function () {
            if (savedY !== undefined) {
                var y = savedY;
                savedY = undefined;
                requestAnimationFrame(function () { window.scrollTo(0, y); });
            }
        });
    })();
</script>
