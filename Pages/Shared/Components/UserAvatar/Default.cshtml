@model MyApp.Web.ViewModels.UserAvatarViewModel

<style>
    @@media (max-width: 767px) {
        .ua-container    { width: 112.3px !important; }
        .ua-profile-btn  { width: 64.31px !important; padding: 8px 12px !important; }
        .ua-name-wrap    { display: none !important; }
        .ua-chevron      { display: none !important; }
    }
</style>

<div class="ua-container"
     style="position:relative;
            width:284.39px;
            height:56px;
            font-family:'Poppins',sans-serif;">

    @* ── Bildirim butonu — 40×40, left:0 top:8 ── *@
    <button type="button"
            style="position:absolute;
                   left:0; top:8px;
                   width:40px; height:40px;
                   border-radius:10px;
                   background:transparent;
                   border:none;
                   padding:0;
                   cursor:pointer;">

        @* Zil ikonu *@
        <img src="~/icons/white/bell-01.svg"
             width="24" height="24"
             alt=""
             style="position:absolute; left:8px; top:8px; display:block; pointer-events:none;">

        @* Bildirim rozeti *@
        @if (Model.NotificationCount > 0)
        {
            <span style="position:absolute;
                         left:18px; top:6px;
                         width:16px; height:16px;
                         display:flex; align-items:center; justify-content:center;
                         background:#FF3B30;
                         border-radius:9999px;
                         font-family:'Poppins',sans-serif;
                         font-weight:700;
                         font-size:9px;
                         line-height:14px;
                         text-align:center;
                         color:#FFFFFF;">
                @Model.NotificationCount
            </span>
        }
    </button>

    @* ── Profil butonu — desktop: 236px, mobil: 64px ── *@
    <button type="button"
            class="ua-profile-btn"
            style="position:absolute;
                   left:48px; top:0;
                   box-sizing:border-box;
                   display:flex;
                   flex-direction:row;
                   align-items:center;
                   padding:8px 12px;
                   gap:12px;
                   width:236.39px; height:56px;
                   background:#FCFCFC;
                   border:1px solid #DCE3FB;
                   border-radius:9999px;
                   cursor:pointer;">

        @* Profil resmi *@
        <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "/icons/navy/user-01.svg" : Model.ProfileImageUrl)"
             alt="Profil fotoğrafı"
             style="width:38px;
                    height:38px;
                    border-radius:9999px;
                    object-fit:cover;
                    flex:none;
                    flex-grow:0;">

        @* İsim (masaüstü) *@
        <span class="ua-name-wrap"
              style="display:flex; flex-direction:row; align-items:flex-start;
                     padding:0; width:128.39px; height:24px;
                     flex:none; order:1; flex-grow:1; overflow:hidden;">
            <span style="width:129px; height:24px;
                         font-family:'Poppins',sans-serif;
                         font-weight:500; font-size:16px; line-height:24px;
                         text-align:center; color:#003F75;
                         white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                @Model.UserName
            </span>
        </span>

        @* Chevron (masaüstü) *@
        <img src="~/icons/blue/chevron-down.svg"
             width="20" height="20"
             alt=""
             class="ua-chevron"
             style="flex:none; order:2; flex-grow:0; display:block; pointer-events:none;">

    </button>

</div>
