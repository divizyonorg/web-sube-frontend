@model MyApp.Web.ViewModels.UserAvatarViewModel

<div style="position:relative;
            width:284.39px;
            height:56px;
            font-family:'Poppins',sans-serif;">

    @* ── Bildirim butonu — 40×40, left:0 top:8 ── *@
    <button type="button"
            style="position:absolute;
                   left:0; top:8px;
                   width:40px; height:40px;
                   border-radius:10px;
                   background:#003F75;
                   border:none;
                   padding:0;
                   cursor:pointer;">

        @* Zil ikonu — Untitled UI / Iconify SVG API, 24×24, left:8 top:8 *@
        <img src="https://api.iconify.design/uit/bell-01.svg?color=%23ffffff"
             width="24" height="24"
             alt=""
             style="position:absolute; left:8px; top:8px; display:block; pointer-events:none;">

        @* Bildirim rozeti — 16×16, left:18 top:6 *@
        @if (Model.NotificationCount > 0)
        {
            <span style="position:absolute;
                         left:18px; top:6px;
                         width:16px; height:16px;
                         display:flex; align-items:center; justify-content:center;
                         background:#FF3B30;
                         border-radius:9999px;
                         font-family:'Poppins',sans-serif;
                         font-style:normal;
                         font-weight:700;
                         font-size:9px;
                         line-height:14px;
                         text-align:center;
                         color:#FFFFFF;">
                @Model.NotificationCount
            </span>
        }
    </button>

    @* ── Profil butonu — 236.39×56, left:48 top:0 ── *@
    <button type="button"
            style="position:absolute;
                   left:48px; top:0;
                   box-sizing:border-box;
                   display:flex;
                   flex-direction:row;
                   align-items:center;
                   padding:8px 12px;
                   gap:12px;
                   width:236.39px; height:56px;
                   background:#FCFCFC;
                   border:1px solid #DCE3FB;
                   border-radius:9999px;
                   cursor:pointer;">

        @* Profil resmi — 38×38, order:0 *@
        <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "https://api.iconify.design/uit/user-01.svg?color=%23003F75" : Model.ProfileImageUrl)"
             alt="Profil fotoğrafı"
             style="width:38px;
                    height:38px;
                    border-radius:9999px;
                    object-fit:cover;
                    flex:none;
                    order:0;
                    flex-grow:0;">

        @* İsim — order:1, flex-grow:1 *@
        <span style="display:flex;
                     flex-direction:row;
                     align-items:flex-start;
                     padding:0;
                     width:128.39px;
                     height:24px;
                     flex:none;
                     order:1;
                     flex-grow:1;
                     overflow:hidden;">
            <span style="width:129px;
                         height:24px;
                         font-family:'Poppins',sans-serif;
                         font-style:normal;
                         font-weight:500;
                         font-size:16px;
                         line-height:24px;
                         text-align:center;
                         color:#003F75;
                         flex:none;
                         order:0;
                         flex-grow:0;
                         white-space:nowrap;
                         overflow:hidden;
                         text-overflow:ellipsis;">
                @Model.UserName
            </span>
        </span>

        @* Chevron — Untitled UI / Iconify SVG API, 20×20, order:2 *@
        <img src="https://api.iconify.design/uit/chevron-down.svg?color=%230056B3"
             width="20" height="20"
             alt=""
             style="flex:none; order:2; flex-grow:0; display:block; pointer-events:none;">

    </button>

</div>
