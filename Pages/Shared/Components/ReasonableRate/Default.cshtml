@model MyApp.Web.ViewModels.MarketAnalysis.ReasonableRateViewModel

@{
    var sliderModel = new MyApp.Web.ViewModels.MarketAnalysis.MarketSliderViewModel
    {
        LeftLabel = "Düşük Faiz",
        MiddleLabel = "Orta",
        RightLabel = "Yüksek Faiz",
        PositionPercent = Model.SliderPositionPercent
    };
}

<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl overflow-hidden">

    @* ── Header ── *@
    <div class="px-4 pt-3 pb-3 border-b border-black/10">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-[#2E6DF8]" fill="none" stroke="currentColor" stroke-width="1.667" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="16" x2="12" y2="12"/>
                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <span class="text-[13px] font-semibold text-[#003F75]">Mantıklı Kredi Oranı</span>
            </div>
            <div class="flex items-center gap-1 px-2 py-1 bg-white border border-gray-200 shadow-sm rounded-lg">
                <span class="text-[11px] text-[#003F75]">@Model.LoanTypeLabel</span>
                <svg class="w-3 h-3 text-[#003F75]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
            </div>
        </div>
        <p class="mt-1 text-[10px] italic font-light text-black/50">
            Bankaların müşterilere fiilen kullandırdığı kredi uygunluk gerçek faiz oranının özüdür.
        </p>
    </div>

    @* ── İçerik ── *@
    <div class="bg-white px-4 py-4">
        <div class="text-center">
            <div class="text-[34px] font-bold text-[#003F75] leading-tight">@Model.AverageRateLabel</div>
            <div class="mt-1 text-[11px] font-light text-black/50">@Model.PeriodLabel</div>
        </div>

        <div class="mt-4">
            <partial name="~/Partials/_MarketSlider.cshtml" model="sliderModel" />
        </div>

        <div class="mt-3 flex items-center gap-1.5">
            <svg class="w-3 h-3 text-[#2E6DF8]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
            <span class="text-[10px] italic text-[#2E6DF8]">Yapay Zeka Destekli Mantıklı Kredi Oranı</span>
        </div>
    </div>
</div>