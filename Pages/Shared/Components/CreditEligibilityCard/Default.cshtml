@model MyApp.Web.ViewModels.CreditEligibility.CreditEligibilityCardViewModel

@* Dış kart (açık mavi arka plan) *@
<div class="flex flex-col gap-3 bg-[#E6F7FF] rounded-[15px] pt-[14px]">

    @* Başlık — Poppins 250 18px #003F75 *@
    <div class="text-center">
        <span class="font-['Poppins'] text-[18px] font-[250] text-[#003F75]">Krediye uygun musun?</span>
    </div>

    @* İç beyaz kart *@
    <div class="flex flex-col gap-4 bg-white border border-[#DCE3FB] rounded-[15px] p-4">

        @* Başlık + ayraç *@
        <div class="border-b border-black/15 pb-1">
            <span class="font-['Poppins'] text-[16px] font-medium text-[#003F75]">Kredi Uygunluk Durumun</span>
        </div>

        @* Slider alanı *@
        @{ var pos = Math.Clamp(Model.SliderPositionPercent, 0, 100); }
        <div class="flex flex-col gap-2 px-2">

            @if (!Model.HasData)
            {
                <div class="flex items-center justify-center py-6">
                    <span class="font-['Poppins'] text-[12px] font-[250] text-[#003F75]/50">Uygunluk verisi yüklenemedi.</span>
                </div>
            }
            else
            {

                @* Gradient çubuk — KrediNabzı ile birebir aynı yapı *@
                <div class="relative w-full h-5 rounded-full overflow-visible">
                    <div class="absolute inset-0 rounded-full"
                         style="background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);"></div>
                    <div class="absolute top-1/2 -translate-y-1/2 w-[10px] h-[25px] bg-white shadow-[0px_1px_4px_rgba(0,0,0,0.2)] rounded-[6px]"
                         style="left: calc(@(pos)% - 5px);"></div>
                </div>

                @* Durum etiketi *@
                <div class="relative w-full h-[28px]">
                    <span class="absolute font-['Poppins'] text-[22px] font-semibold text-[#1D459C] leading-none whitespace-nowrap"
                          style="left: @(pos)%; top: 0; transform: translateX(-50%);">
                        @Model.StatusLabel
                    </span>
                </div>

                @* Ölçek etiketleri *@
                <div class="flex justify-between">
                    <span class="font-['Poppins'] text-[9px] font-normal leading-[14px] text-black/50">premium</span>
                    <span class="font-['Poppins'] text-[9px] font-normal leading-[14px] text-black/50">kritik</span>
                    <span class="font-['Poppins'] text-[9px] font-normal leading-[14px] text-black/50">düşük</span>
                </div>
            }

        </div>

        @* Açıklama metni *@
        <p class="font-['Poppins'] text-[10px] font-[250] text-[#003F75] text-center leading-[15px]">
            Kredi uygunluk durumun Türkiye'de kredi veren tüm bankaların sana yakın kredi profiline
            son 30 gün içinde verdiği kredi kararlarına bakarak oluşturulur, gerçeğe en yakın sonuçtur.
        </p>
    </div>

    @* K.U.R Butonu *@
    <div class="flex justify-center px-[12px] pb-[12px]">
        <a href="@Model.KurDetayUrl"
           class="flex items-center justify-center w-full max-w-[280px] h-[44px] bg-[#0056B3] shadow-[0px_4px_4px_rgba(0,0,0,0.25)] rounded-[40px] hover:bg-[#004494] transition-all">
            <span class="font-['Poppins'] font-medium text-[16px] leading-6 text-center text-white">K.U.R Raporunu Gör</span>
        </a>
    </div>

</div>
