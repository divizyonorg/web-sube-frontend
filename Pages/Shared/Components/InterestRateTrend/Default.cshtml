@model MyApp.Web.ViewModels.MarketAnalysis.InterestRateTrendViewModel

<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl overflow-hidden">

    @* ── Header ─────────────────────────────────── *@
    <div class="px-4 pt-3 pb-3 border-b border-black/10">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-[#2E6DF8]" fill="none" stroke="currentColor" stroke-width="1.667" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8M14 7h7v7"/>
                </svg>
                <span class="text-[13px] font-semibold text-[#003F75]">Faiz Oranı Trendi</span>
            </div>
            <div class="flex items-center gap-1 px-2 py-1 bg-white border border-gray-200 shadow-sm rounded-lg">
                <span class="text-[11px] text-[#003F75]">@Model.LoanTypeLabel</span>
                <svg class="w-3 h-3 text-[#003F75]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
            </div>
        </div>
        <p class="mt-1 text-[10px] italic font-light text-black/50">
            Faiz oranı trendi, bankaların geçen hafta müşterilere fiilen kullandırılan kredilerin ağırlıklı ortalamasıdır.
        </p>
    </div>

    @* ── Koyu lacivert içerik ───────────────────── *@
    <div class="bg-[#122B62] px-4 pt-4 pb-4">
        @* Üst satır: Faiz oranı + delta *@
        <div class="flex items-start justify-between">
            <div class="flex flex-col gap-0.5">
                <span class="text-[10px] text-white/80 font-light">@Model.LoanTypeLabel Faizi</span>
                <div class="flex items-baseline">
                    <span class="text-[28px] font-bold text-white leading-tight">@Model.MonthlyRateLabel</span>
                    <span class="ml-1 text-[12px] font-light text-white">/ Ay</span>
                </div>
            </div>

            <div class="flex flex-col items-end">
                <div class="flex items-center gap-1">
                    @if (Model.IsPositiveChange)
                    {
                        <svg class="w-4 h-4 text-[#46CA88]" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                        </svg>
                    }
                    else
                    {
                        <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                        </svg>
                    }
                    <span class="text-[11px] @(Model.IsPositiveChange ? "text-[#46CA88]" : "text-red-400")">
                        @Model.ChangeLabel
                    </span>
                </div>
                <span class="text-[10px] font-light @(Model.IsPositiveChange ? "text-[#46CA88]" : "text-red-400")">
                    @Model.ChangePeriodLabel
                </span>
            </div>
        </div>

        @* Sparkline (basit yatay çizgi — gerçek datada SVG path kullanılacak) *@
        <div class="mt-4 h-[2px] bg-[#46CA88]/80 rounded-full"></div>

        @* Alt etiketler *@
        <div class="mt-4 flex items-center justify-between">
            <span class="px-3 py-1 text-[9px] text-white/90 bg-white/10 border border-white/25 rounded-full">
                Ortalama Piyasa Faizi
            </span>

            @if (Model.ShowOpportunityBadge)
            {
                <span class="flex items-center gap-1 px-3 py-1 text-[9px] font-semibold text-white bg-[#46CA88]/60 border border-black/25 rounded-full">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    FIRSAT: Yılın En Düşük Seviyesi
                </span>
            }
        </div>
    </div>
</div>