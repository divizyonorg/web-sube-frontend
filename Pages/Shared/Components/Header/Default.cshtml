@model MyApp.Web.ViewModels.HeaderViewModel

<style>
    .header-hamburger { display: none; }
    @@media (max-width: 767px) {
        .header-hamburger  { display: flex !important; }
        .header-inner      { padding: 0 16px !important; }
    }
</style>

<header x-data
        style="position:relative;
               z-index:60;
               width:100%;
               height:68px;
               background:linear-gradient(90deg,#2E6DF8 0%,#0056B3 100%);
               box-shadow:0px 4px 4px rgba(0,0,0,0.25);
               border-bottom:1px solid #2E6DF8;
               box-sizing:border-box;
               font-family:'Poppins',sans-serif;">

    <div class="header-inner"
         style="position:absolute; left:0; top:0; width:100%; height:100%;
                box-sizing:border-box; display:flex; flex-direction:row;
                justify-content:space-between; align-items:center; padding:0 24px;">

        @* Sol grup: hamburger + logo *@
        <div style="display:flex; flex-direction:row; align-items:center; gap:12px;">

            @* Hamburger — sadece mobil *@
            <button type="button"
                    class="header-hamburger"
                    @@click="$store.layout.mobileMenuOpen = !$store.layout.mobileMenuOpen"
                    style="align-items:center; justify-content:center;
                           width:40px; height:40px; flex-shrink:0;
                           background:transparent; border:none; cursor:pointer;
                           border-radius:10px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M3 6H21"  stroke="white" stroke-width="2" stroke-linecap="round"/>
                    <path d="M3 12H21" stroke="white" stroke-width="2" stroke-linecap="round"/>
                    <path d="M3 18H21" stroke="white" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>

            @* Logo + Web Şube — ana sayfaya link *@
            <a href="/Anasayfa" style="display:flex; align-items:center; gap:12px; text-decoration:none; flex:none;">
                <img src="~/images/Image (İnteraktif Kredi).png"
                     alt="İnteraktif Kredi"
                     style="width:118px; height:30px; object-fit:contain; flex:none;">

                @* Dikey ayırıcı *@
                <div class="hidden md:block" style="width:2px; height:28px; background:rgba(255,255,255,0.90); flex:none; border-radius:1px;"></div>

                @* Web Şube yazısı *@
                <span class="hidden md:block" style="font-family:'Poppins',sans-serif; font-weight:600; font-size:16px;
                             line-height:1; color:rgba(255,255,255,0.90); white-space:nowrap; flex:none;">
                    Web Şube
                </span>
            </a>

        </div>

        @* Sağ grup: Avatar bileşeni *@
        <div style="flex:none;">
            @await Component.InvokeAsync("UserAvatar", new
            {
                userName          = Model.UserName,
                userRole          = Model.UserRole,
                notificationCount = Model.NotificationCount,
                profileImageUrl   = Model.ProfileImageUrl
            })
        </div>

    </div>

</header>
