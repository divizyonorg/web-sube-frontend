<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>İnteraktif Kredi | @ViewData["Title"]</title>
    <link rel="icon" href="~/icons/logo_transparent.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Grid.js -->
    <link rel="stylesheet" href="~/lib/gridjs/mermaid.min.css" asp-append-version="true" />

    <!-- Swiper.js -->
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" asp-append-version="true" />

    <!-- FilePond -->
    <link rel="stylesheet" href="~/lib/filepond/filepond.min.css" asp-append-version="true" />


    <!-- Flatpickr -->
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true" />

    <!-- TOM Select -->
    <link rel="stylesheet" href="~/lib/tom-select/tom-select.default.min.css" asp-append-version="true" />

    <style>
        [x-cloak] { display: none !important; }

        /* ── Mobile sidebar overlay ── */
        .mobile-backdrop {
            position: fixed; inset: 0; z-index: 40;
            background: rgba(0,0,0,0.5);
            opacity: 0; pointer-events: none;
            transition: opacity 0.2s ease;
        }
        .mobile-backdrop.open { opacity: 1; pointer-events: auto; }

        .mobile-drawer {
            position: fixed; top: 68px; left: 0; bottom: 0; z-index: 50;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }
        .mobile-drawer.open { transform: translateX(0); }

        @@media (min-width: 768px) {
            .mobile-backdrop, .mobile-drawer { display: none !important; }
            .main-content { padding: 0 !important; }
            .page-content { padding: 24px; }
        }

        @@media (max-width: 767px) {
            .desktop-sidebar { display: none !important; }
            .main-content { padding: 0 !important; }
            .page-content { padding: 16px; }
        }

        /* Kredi modal overlay — display:flex CSS class'ta tutulur, x-show display:none ile çakışmasın */
        .kredi-overlay { display: flex; align-items: center; justify-content: center; }
    </style>

</head>
<body class="bg-gray-50 text-gray-900 antialiased" style="height:100vh; overflow:hidden;" hx-boost="true">
    <script>
        (function () {
            var t = localStorage.getItem('auth_token');
            if (t && !document.cookie.split(';').some(function (c) { return c.trim().startsWith('auth_token='); })) {
                document.cookie = 'auth_token=' + t + '; path=/; SameSite=Lax';
                location.reload();
            }
        })();
    </script>

    <div id="layout-header" hx-preserve>
        @await Component.InvokeAsync("Header", new
        {
            model = new MyApp.Web.ViewModels.HeaderViewModel
            {
                UserName          = User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Kullanıcı",
                UserRole          = "",
                NotificationCount = 0,
                ProfileImageUrl   = ""
            }
        })
    </div>

    @* Mobile backdrop *@
    <div x-data
         class="mobile-backdrop"
         :class="{ 'open': $store.layout.mobileMenuOpen }"
         @@click="$store.layout.mobileMenuOpen = false">
    </div>

    @* Mobile sidebar drawer *@
    <div x-data
         class="mobile-drawer"
         :class="{ 'open': $store.layout.mobileMenuOpen }">
        @await Component.InvokeAsync("Sidebar", new { activePage = ViewData["ActivePage"]?.ToString() ?? "" })
    </div>

    @* ── Kredi Başvurusu Modal ── *@
    <div id="kredi-modal-overlay"
         x-data
         x-show="$store.krediModal.open"
         x-cloak
         hx-preserve
         class="kredi-overlay"
         style="position:fixed; inset:0; z-index:1000;
                background:rgba(0,0,0,0.65);
                overflow-y:auto; padding:20px 16px; box-sizing:border-box;">

        <div id="wizard-container"
             hx-boost="false"
             style="width:100%; max-width:420px; flex-shrink:0; margin:auto;">
            <partial name="~/Partials/KrediBasvurusu/_Step1.cshtml" />
        </div>

    </div>

    @* ── Kapatma Onay Modalı ── *@
    <div id="kredi-confirm-overlay"
         x-data
         x-show="$store.krediModal.confirmClose"
         x-cloak
         hx-preserve
         class="kredi-overlay"
         style="position:fixed; inset:0; z-index:1100;
                background:rgba(0,0,0,0.45);
                padding:16px; box-sizing:border-box;">

        <div style="background:#FFFFFF; border-radius:20px; padding:28px 24px;
                    width:100%; max-width:320px; box-sizing:border-box;
                    box-shadow:0 8px 40px rgba(0,0,0,0.22);">

            <div style="display:flex; flex-direction:column; align-items:center; text-align:center; gap:8px; margin-bottom:24px;">
                <div style="width:48px; height:48px; border-radius:50%;
                            background:#FEF2F2; display:flex; align-items:center; justify-content:center; margin-bottom:4px;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <path d="M12 9v4M12 17h.01" stroke="#EF4444" stroke-width="2" stroke-linecap="round"/>
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                              stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 style="font-family:'Poppins'; font-weight:600; font-size:16px; color:#003F75; margin:0;">
                    Başvuruyu iptal et?
                </h3>
                <p style="font-family:'Poppins'; font-weight:400; font-size:13px; line-height:20px; color:#6A7282; margin:0;">
                    Girdiğiniz bilgiler kaydedilmeyecek.<br>Çıkmak istediğinize emin misiniz?
                </p>
            </div>

            <div style="display:flex; flex-direction:column; gap:10px;">
                <button type="button"
                        onclick="closeKrediModal()"
                        style="width:100%; height:46px; border-radius:12px;
                               background:linear-gradient(90deg,#EF4444,#DC2626);
                               border:none; cursor:pointer;
                               font-family:'Poppins'; font-weight:600; font-size:14px; color:#FFFFFF;">
                    Evet, kapat
                </button>
                <button type="button"
                        onclick="hideKrediConfirm()"
                        style="width:100%; height:46px; border-radius:12px;
                               background:#F3F4F6; border:none; cursor:pointer;
                               font-family:'Poppins'; font-weight:600; font-size:14px; color:#374151;">
                    Hayır, devam et
                </button>
            </div>

        </div>
    </div>

    <div style="display:flex; height:calc(100vh - 68px); overflow:hidden;">

        @* Desktop sidebar *@
        <div id="layout-desktop-sidebar" class="desktop-sidebar" style="flex-shrink:0;" hx-preserve>
            @await Component.InvokeAsync("Sidebar", new { activePage = ViewData["ActivePage"]?.ToString() ?? "" })
        </div>

        <main id="layout-main" class="main-content" style="flex:1; overflow-y:auto; box-sizing:border-box; display:flex; flex-direction:column;">
            @await RenderSectionAsync("Styles", required: false)
            <div class="page-content" style="flex:1;">
                @RenderBody()
            </div>
            @await Component.InvokeAsync("Footer")
        </main>

    </div>

    <!-- Alpine.js — defer zorunlu -->
    <script defer src="~/lib/alpinejs/cdn.min.js" asp-append-version="true"></script>

    <!-- HTMX -->
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>

    <!-- Grid.js -->
    <script src="~/lib/gridjs/gridjs.umd.js" asp-append-version="true"></script>

    <!-- Swiper.js -->
    <script src="~/lib/swiper/swiper-bundle.min.js" asp-append-version="true"></script>

    <!-- FilePond -->
    <script src="~/lib/filepond/filepond.min.js" asp-append-version="true"></script>

    <!-- IMask.js -->
    <script src="~/lib/imask/imask.min.js" asp-append-version="true"></script>

    <!-- JustValidate -->
    <script src="~/lib/just-validate/just-validate.production.min.js" asp-append-version="true"></script>

    <!-- Flatpickr + Türkçe dil paketi -->
    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/lib/flatpickr/l10n/tr.js" asp-append-version="true"></script>

    <!-- TOM Select -->
    <script src="~/lib/tom-select/tom-select.complete.min.js" asp-append-version="true"></script>

    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script>
        (function () {
            var token = localStorage.getItem('auth_token');
            if (!token) return;

            // HTMX isteklerine Authorization header ekle
            document.addEventListener('htmx:configRequest', function (e) {
                e.detail.headers['Authorization'] = 'Bearer ' + token;
            });

            // HTMX 401 → token sil, login'e at
            document.addEventListener('htmx:responseError', function (e) {
                if (e.detail.xhr.status === 401) {
                    localStorage.removeItem('auth_token');
                    window.location.replace('/login');
                }
            });

            // fetch çağrılarına Authorization header ekle
            var _fetch = window.fetch;
            window.fetch = function (input, init) {
                init = init || {};
                init.headers = Object.assign({ 'Authorization': 'Bearer ' + token }, init.headers || {});
                return _fetch(input, init);
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
