<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyApp.Web</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Grid.js -->
    <link rel="stylesheet" href="~/lib/gridjs/mermaid.min.css" asp-append-version="true" />

    <!-- Swiper.js -->
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" asp-append-version="true" />

    <!-- FilePond -->
    <link rel="stylesheet" href="~/lib/filepond/filepond.min.css" asp-append-version="true" />

    <!-- Toastify.js -->
    <link rel="stylesheet" href="~/lib/toastify-js/toastify.css" asp-append-version="true" />

    <!-- Flatpickr -->
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true" />

    <!-- TOM Select -->
    <link rel="stylesheet" href="~/lib/tom-select/tom-select.default.min.css" asp-append-version="true" />

    <style>
        [x-cloak] { display: none !important; }

        /* ── Mobile sidebar overlay ── */
        .mobile-backdrop {
            position: fixed; inset: 0; z-index: 40;
            background: rgba(0,0,0,0.5);
            opacity: 0; pointer-events: none;
            transition: opacity 0.2s ease;
        }
        .mobile-backdrop.open { opacity: 1; pointer-events: auto; }

        .mobile-drawer {
            position: fixed; top: 0; left: 0; bottom: 0; z-index: 50;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }
        .mobile-drawer.open { transform: translateX(0); }

        @@media (min-width: 768px) {
            .mobile-backdrop, .mobile-drawer { display: none !important; }
            .main-content { padding: 0 !important; }
            .page-content { padding: 24px; }
        }

        @@media (max-width: 767px) {
            .desktop-sidebar { display: none !important; }
            .main-content { padding: 0 !important; }
            .page-content { padding: 16px; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-gray-50 text-gray-900 antialiased" style="height:100vh; overflow:hidden;">

    @await Component.InvokeAsync("Header", new
    {
        model = new MyApp.Web.ViewModels.HeaderViewModel
        {
            UserName          = User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Kullanıcı",
            NotificationCount = 0,
            ProfileImageUrl   = ""
        }
    })

    @* Mobile backdrop *@
    <div x-data
         class="mobile-backdrop"
         :class="{ 'open': $store.layout.mobileMenuOpen }"
         @@click="$store.layout.mobileMenuOpen = false">
    </div>

    @* Mobile sidebar drawer *@
    <div x-data
         class="mobile-drawer"
         :class="{ 'open': $store.layout.mobileMenuOpen }">
        @await Component.InvokeAsync("Sidebar", new { activePage = ViewData["ActivePage"]?.ToString() ?? "" })
    </div>

    <div style="display:flex; height:calc(100vh - 85px); overflow:hidden;">

        @* Desktop sidebar *@
        <div class="desktop-sidebar" style="flex-shrink:0;">
            @await Component.InvokeAsync("Sidebar", new { activePage = ViewData["ActivePage"]?.ToString() ?? "" })
        </div>

        <main class="main-content" style="flex:1; overflow-y:auto; box-sizing:border-box;">
            <div class="page-content">
                @RenderBody()
            </div>
            @await Component.InvokeAsync("Footer")
        </main>

    </div>

    <!-- Alpine.js — defer zorunlu -->
    <script defer src="~/lib/alpinejs/cdn.min.js" asp-append-version="true"></script>

    <!-- HTMX -->
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>

    <!-- Grid.js -->
    <script src="~/lib/gridjs/gridjs.umd.js" asp-append-version="true"></script>

    <!-- Swiper.js -->
    <script src="~/lib/swiper/swiper-bundle.min.js" asp-append-version="true"></script>

    <!-- FilePond -->
    <script src="~/lib/filepond/filepond.min.js" asp-append-version="true"></script>

    <!-- IMask.js -->
    <script src="~/lib/imask/imask.min.js" asp-append-version="true"></script>

    <!-- Toastify.js -->
    <script src="~/lib/toastify-js/toastify.js" asp-append-version="true"></script>

    <!-- JustValidate -->
    <script src="~/lib/just-validate/just-validate.production.min.js" asp-append-version="true"></script>

    <!-- Flatpickr + Türkçe dil paketi -->
    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/lib/flatpickr/l10n/tr.js" asp-append-version="true"></script>

    <!-- TOM Select -->
    <script src="~/lib/tom-select/tom-select.complete.min.js" asp-append-version="true"></script>

    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
