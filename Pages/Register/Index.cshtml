@page "/register"
@model MyApp.Web.Pages.Register.IndexModel
@{ Layout = null; }

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Üye Ol — İnteraktif Şube</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; min-height: 100%; font-family: 'Poppins', sans-serif; }
        button { font-family: 'Poppins', sans-serif; }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body>

    <div x-data="registerForm()" class="flex min-h-screen">

        @* ── Sol panel — yalnızca desktop ── *@
        <div class="hidden lg:block relative w-[44.4%] shrink-0 overflow-hidden h-screen sticky top-0">

            @*
            <div class="absolute -bottom-15 left-1/2 -translate-x-1/2 w-130 h-130 rounded-full pointer-events-none z-1"
                 style="background:radial-gradient(circle, rgba(30,130,255,0.30) 0%, rgba(20,100,220,0.18) 40%, transparent 70%);"></div>
            <div class="absolute -bottom-10 left-1/2 -translate-x-1/2 w-95 h-95 rounded-full border-[1.5px] border-[rgba(100,180,255,0.20)] pointer-events-none z-1"></div>
            <div class="absolute left-7.5 bottom-80 w-37.5 h-37.5 rotate-45 border-[1.5px] border-[rgba(80,160,255,0.30)] rounded-md pointer-events-none z-2"></div>
            <div class="absolute right-2.5 bottom-92.5 w-30 h-30 rotate-45 border-[1.5px] border-[rgba(80,160,255,0.22)] rounded-[5px] pointer-events-none z-2"></div>
            <div class="absolute left-12.5 bottom-42.5 w-32.5 h-32.5 rotate-45 border-[1.5px] border-[rgba(80,160,255,0.25)] rounded-[5px] pointer-events-none z-2"></div>
            <div class="absolute right-5 bottom-50 w-40 h-40 rotate-45 border-[1.5px] border-[rgba(80,160,255,0.20)] rounded-md pointer-events-none z-2"></div>
            <div class="absolute left-1/2 bottom-60 -translate-x-1/2 rotate-45 w-50 h-50 border-[1.5px] border-[rgba(100,180,255,0.15)] rounded-lg pointer-events-none z-1"></div>

            <div class="absolute top-0 left-0 right-0 h-[40%] z-5 flex items-center px-[52px]">
                <p class="font-semibold text-[28px] leading-[1.65] text-white m-0">
                    Kafana en çok takılan,<br>
                    bunu nasıl çözerim<br>
                    dediğin <span class="text-[#3AD7B3]">tüm finansal<br>
                    soruların</span> cevabını<br>
                    burada bulacaksın.
                </p>
            </div>
            *@

            <img src="~/images/register-image.jpg"
                 alt=""
                 class="w-full h-full object-cover object-center" />
        </div>

        @* ── Sağ panel ── *@
        <div class="flex-1 min-w-0 flex flex-col items-center bg-[#EEF2FB] px-4 py-8 lg:bg-white lg:px-6 lg:py-8">
            <div class="w-full max-w-[440px] flex flex-col items-center lg:max-w-[420px]">

                @* Logo 200×52 *@
                <img src="~/images/ik_logo.png"
                     alt="İnteraktif Kredi"
                     style="width:200px; height:52px; object-fit:contain;"
                     class="mb-3" />

                @* Kart *@
                <div class="w-full rounded-2xl px-5 pt-4 pb-4 bg-white lg:px-7" style="box-shadow:0 4px 32px 0 rgba(0,86,179,0.10);">
                    <form id="registerForm" method="post" class="flex flex-col space-y-4">
                        @Html.AntiForgeryToken()

                        @* Başlık *@
                        <div>
                            <p style="font-size:14px; font-weight:300; color:#374151; margin:0 0 4px 0;">Bireysel</p>
                            <h1 style="font-size:22px; font-weight:700; color:#0D2B6C; margin:0;">Hemen Üye Ol</h1>
                        </div>

                        @* Adın *@
                        <div class="[&>div]:w-full! [&_input]:w-full!">
                            <partial name="~/Partials/Components/_Input.cshtml"
                                     model='new InputViewModel { Label = "Adın", Type = InputFieldType.Text, Name = "FirstName", ContainerWidth = 364 }' />
                        </div>

                        @* Soyadın *@
                        <div class="[&>div]:w-full! [&_input]:w-full!">
                            <partial name="~/Partials/Components/_Input.cshtml"
                                     model='new InputViewModel { Label = "Soyadın", Type = InputFieldType.Text, Name = "LastName", ContainerWidth = 364 }' />
                        </div>

                        @* Mail *@
                        <div class="[&>div]:w-full! [&_input]:w-full!">
                            <partial name="~/Partials/Components/_Input.cshtml"
                                     model='new InputViewModel { Label = "Mail", Type = InputFieldType.Email, Name = "Email", ContainerWidth = 364 }' />
                        </div>

                        @* Doğum Tarihi *@
                        <div class="[&>div]:w-full! [&_input]:w-full!">
                            <partial name="~/Partials/Components/_Input.cshtml"
                                     model='new InputViewModel { Label = "Doğum Tarihin (GG/AA/YYYY)", Type = InputFieldType.Text, Name = "BirthDate", ContainerWidth = 364 }' />
                        </div>

                        @* TC Kimlik No *@
                        <div class="[&>div]:w-full! [&_input]:w-full!">
                            <partial name="~/Partials/Components/_Input.cshtml"
                                     model='new InputViewModel { Label = "TCKN", Type = InputFieldType.Tckn, Name = "Tckn", ContainerWidth = 364 }' />
                        </div>

                        @* GSM + Doğrula butonu *@
                        <div class="flex items-center gap-2">
                            <div class="flex-1 [&>div]:w-full! [&_input]:w-full!">
                                <partial name="~/Partials/Components/_Input.cshtml"
                                         model='new InputViewModel { Label = "GSM", Type = InputFieldType.Phone, Name = "PhoneNumber", ContainerWidth = 364 }' />
                            </div>
                            @* Doğrula — phoneVerified=true olunca hidden class ile gizlenir *@
                            <button type="button"
                                    id="btnDogrula"
                                    @@click="sendingOtp ? null : (canVerifyPhone() ? sendOtp() : explainWhyCannotVerify())"
                                    :disabled="!canVerifyPhone() || sendingOtp"
                                    :class="{ 'hidden': phoneVerified, 'opacity-40 cursor-not-allowed': !canVerifyPhone() || sendingOtp }"
                                    class="h-14 px-4 rounded-lg bg-[#0056B3] text-white text-sm font-semibold shrink-0 whitespace-nowrap border-0 cursor-pointer">
                                <span :class="{ 'hidden': sendingOtp }">Doğrula</span>
                                <span :class="{ 'hidden': !sendingOtp, 'inline-block': sendingOtp }" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                            </button>
                            @* Doğrulandı badge — başlangıçta hidden, phoneVerified=true olunca görünür *@
                            <div :class="{ 'hidden': !phoneVerified }"
                                 class="hidden flex items-center gap-1.5 h-14 px-3 rounded-lg bg-green-50 border border-green-200 shrink-0">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6L9 17L4 12"/>
                                </svg>
                                <span class="text-green-700 text-sm font-medium whitespace-nowrap">Doğrulandı</span>
                            </div>
                        </div>

                        @* SMS gönderme hatası *@
                        <p :class="{ 'hidden': !otpError }"
                           class="hidden text-xs text-[#DC2626] text-center m-0 -mt-2"
                           x-text="otpErrorMsg"></p>

                        @* Açık Rıza — tıklayınca modal açar *@
                        <div class="flex items-start gap-2">
                            <input type="checkbox" name="ConsentOpenRiza" x-model="consentOpenRiza" class="sr-only" />
                            <div @@click="consentOpenRiza ? (consentOpenRiza = false) : (showAcikRizaModal = true)"
                                 :class="consentOpenRiza ? 'bg-[#0056B3] border-[#0056B3]' : 'bg-white border-[#0056B3]'"
                                 class="w-4.5 h-4.5 border rounded-[4px] flex items-center justify-center shrink-0 cursor-pointer mt-0.5">
                                <svg x-show="consentOpenRiza" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6L9 17L4 12"/>
                                </svg>
                            </div>
                            <span @@click="consentOpenRiza ? (consentOpenRiza = false) : (showAcikRizaModal = true)"
                                  class="text-xs font-normal text-[#374151] select-none cursor-pointer leading-[1.6]">
                                İnteraktif Kredi <span class="font-medium text-[#0056B3] underline">Açık Rıza Metni</span>'ni okudum ve kişisel verilerimin işlenmesine onay veriyorum.
                            </span>
                        </div>

                        @* Aydınlatma Metni — tıklayınca modal açar *@
                        <div class="flex items-start gap-2">
                            <input type="checkbox" name="ConsentAydinlatma" x-model="consentAydinlatma" class="sr-only" />
                            <div @@click="consentAydinlatma ? (consentAydinlatma = false) : (showAydinlatmaModal = true)"
                                 :class="consentAydinlatma ? 'bg-[#0056B3] border-[#0056B3]' : 'bg-white border-[#0056B3]'"
                                 class="w-4.5 h-4.5 border rounded-[4px] flex items-center justify-center shrink-0 cursor-pointer mt-0.5">
                                <svg x-show="consentAydinlatma" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6L9 17L4 12"/>
                                </svg>
                            </div>
                            <span @@click="consentAydinlatma ? (consentAydinlatma = false) : (showAydinlatmaModal = true)"
                                  class="text-xs font-normal text-[#374151] select-none cursor-pointer leading-[1.6]">
                                İnteraktif Kredi <span class="font-medium text-[#0056B3] underline">Aydınlatma Metni</span>'ni okudum ve onaylıyorum.
                            </span>
                        </div>

                        @* İleti onayı *@
                        <div class="flex items-start gap-2">
                            <input type="checkbox" name="ConsentIleti" x-model="consentIleti" class="sr-only" />
                            <div @@click="consentIleti = !consentIleti"
                                 :class="consentIleti ? 'bg-[#0056B3] border-[#0056B3]' : 'bg-white border-[#0056B3]'"
                                 class="w-4.5 h-4.5 border rounded-[4px] flex items-center justify-center shrink-0 cursor-pointer mt-0.5">
                                <svg x-show="consentIleti" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6L9 17L4 12"/>
                                </svg>
                            </div>
                            <span @@click="consentIleti = !consentIleti"
                                  class="text-xs font-normal text-[#374151] select-none cursor-pointer leading-[1.6]">
                                İnteraktif Kredi tarafından ticari elektronik ileti gönderilmesini onay metni kapsamında kabul ediyorum.
                            </span>
                        </div>

                        @* İletişim kanalları *@
                        <div class="flex gap-5">
                            <div class="flex items-center gap-2">
                                <input type="checkbox" name="ConsentSms" x-model="consentSms" class="sr-only" />
                                <div @@click="consentSms = !consentSms"
                                     :class="consentSms ? 'bg-[#0056B3] border-[#0056B3]' : 'bg-white border-[#0056B3]'"
                                     class="w-4.5 h-4.5 border rounded-[4px] flex items-center justify-center shrink-0 cursor-pointer">
                                    <svg x-show="consentSms" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 6L9 17L4 12"/>
                                    </svg>
                                </div>
                                <span @@click="consentSms = !consentSms" class="text-xs font-normal text-[#739FCC] select-none cursor-pointer">SMS</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="checkbox" name="ConsentEposta" x-model="consentEposta" class="sr-only" />
                                <div @@click="consentEposta = !consentEposta"
                                     :class="consentEposta ? 'bg-[#0056B3] border-[#0056B3]' : 'bg-white border-[#0056B3]'"
                                     class="w-4.5 h-4.5 border rounded-[4px] flex items-center justify-center shrink-0 cursor-pointer">
                                    <svg x-show="consentEposta" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 6L9 17L4 12"/>
                                    </svg>
                                </div>
                                <span @@click="consentEposta = !consentEposta" class="text-xs font-normal text-[#739FCC] select-none cursor-pointer">E-Posta</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="checkbox" name="ConsentArama" x-model="consentArama" class="sr-only" />
                                <div @@click="consentArama = !consentArama"
                                     :class="consentArama ? 'bg-[#0056B3] border-[#0056B3]' : 'bg-white border-[#0056B3]'"
                                     class="w-4.5 h-4.5 border rounded-[4px] flex items-center justify-center shrink-0 cursor-pointer">
                                    <svg x-show="consentArama" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 6L9 17L4 12"/>
                                    </svg>
                                </div>
                                <span @@click="consentArama = !consentArama" class="text-xs font-normal text-[#739FCC] select-none cursor-pointer">Arama</span>
                            </div>
                        </div>

                        @* Kayıt hatası *@
                        <p :class="{ 'hidden': !registerError }"
                           class="hidden text-xs text-[#DC2626] text-center m-0"
                           x-text="registerErrorMsg"></p>

                        @* Üye Ol butonu *@
                        <div class="[&_button]:w-full!"
                             :class="canSubmit() ? 'cursor-pointer opacity-100' : 'cursor-not-allowed opacity-50'"
                             @@click="canSubmit() ? submitForm() : explainWhyCannotSubmit()">
                            <button type="button"
                                    :disabled="!canSubmit() || registering"
                                    class="w-full h-12 rounded-[40px] bg-[#0056B3] text-white text-sm font-semibold border-0 cursor-inherit flex items-center justify-center gap-2">
                                <span :class="{ 'hidden': registering }">Üye Ol</span>
                                <span :class="{ 'hidden': !registering, 'inline-flex': registering }" class="hidden items-center gap-2">
                                    <span class="inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                    Kaydediliyor...
                                </span>
                            </button>
                        </div>

                        @* Giriş linki *@
                        <p style="font-size:14px; color:#374151; text-align:center; margin:0;">
                            Zaten üye misin?
                            <a href="/login" class="font-semibold text-[#0056B3] no-underline ml-1">Giriş Yap</a>
                        </p>

                        @* Ayırıcı *@
                        <div class="h-px bg-[#E5E7EB]"></div>

                        <button type="button"
                                style="background-color:#D4E2F2;"
                                class="flex items-center justify-center gap-2.5 w-full h-12 border-0 rounded-[40px] text-sm font-medium text-[#374151] cursor-pointer shrink-0">
                            <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                            </svg>
                            Google ile Giriş Yap
                        </button>

                    </form>
                </div>

            </div>
        </div>

        @* OTP Modal — Telefon Doğrulama (x-data scope içinde olmalı) *@
        <div x-show="showOtpModal" x-cloak class="fixed inset-0 z-100 overflow-y-auto lg:overflow-hidden">
            <div class="min-h-full flex flex-col items-center bg-[#E8EDF5] px-5 py-8
                        lg:min-h-0 lg:h-full lg:flex-row lg:justify-center lg:items-center lg:bg-[#DDE3ECBF] lg:px-4 lg:py-4">

                @* Soluk başlık — yalnızca mobile *@
                <div class="w-full flex flex-col items-center mb-5 lg:hidden">
                    <img src="~/images/ik_logo.png"
                         alt="İnteraktif Kredi"
                         class="h-14 w-auto object-contain mb-4 opacity-35" />
                    <p class="font-light text-base text-[#7B9CC4] mb-2 text-center">Bireysel</p>
                    <h2 class="font-semibold text-[30px] leading-[1.2] text-[#7B9CC4] text-center">
                        Üye Ol
                    </h2>
                </div>

                @* Modal kart *@
                <div class="bg-white w-full rounded-[20px] overflow-hidden
                            shadow-[0_4px_24px_rgba(0,0,0,0.08)]
                            lg:max-w-120 lg:shadow-[0_25px_60px_rgba(0,0,0,0.3)]">

                    <img src="~/images/sms.png"
                         class="w-full h-50 object-cover object-top block" />

                    <div class="px-5 pt-6 pb-8 flex flex-col items-center gap-4 lg:px-9 lg:pt-7 lg:pb-8">

                        <h2 class="font-bold text-xl text-[#0056B3] m-0 text-center">
                            Telefon Doğrulama
                        </h2>

                        <p class="text-sm text-[#374151] text-center m-0 leading-[1.7]">
                            Telefon numaranızı doğrulamak için
                            <strong x-text="maskedPhone()" class="text-[#0056B3]"></strong>
                            nolu cep telefonuna gönderdiğimiz kodu yazın.
                        </p>

                        <input type="text" id="RegisterOtpCode"
                               x-model="otpCode"
                               placeholder="SMS Kodunu Girin"
                               maxlength="6"
                               class="w-full h-13 border-[1.5px] border-[#DCE3FB] rounded-xl px-4 text-[15px] outline-none text-[#374151]" />

                        <p class="text-[13px] text-[#374151] m-0 text-center">
                            <span x-text="timerDisplay()" class="font-semibold text-[#0056B3]"></span>
                            saniye sonra yeni kod gönderebilirsin
                        </p>

                        <p x-show="otpVerifyError" x-cloak
                           x-text="otpVerifyErrorMsg"
                           class="text-[13px] text-[#DC2626] text-center m-0"></p>

                        <div @@click="!verifyingOtp && verifyOtp()"
                             :class="verifyingOtp ? 'opacity-60 cursor-not-allowed pointer-events-none' : 'cursor-pointer'"
                             class="w-full [&_button]:w-full!">
                            <partial name="~/Partials/Components/_Button.cshtml"
                                     model='new ButtonViewModel { Label = "Doğrula", Variant = ButtonVariant.Primary, Width = 408 }' />
                        </div>

                        <button type="button"
                                @@click="showOtpModal = false"
                                class="text-sm text-[#6B7280] underline bg-transparent border-0 cursor-pointer">
                            Geri Dön
                        </button>

                    </div>
                </div>
            </div>
        </div>

        @* Açık Rıza Metni Modalı *@
        <div :class="{ 'hidden': !showAcikRizaModal }"
             class="hidden fixed inset-0 z-200 flex items-center justify-center bg-black/50 px-4">
            <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl flex flex-col max-h-[90vh]">
                <div class="flex items-center justify-between px-6 pt-5 pb-3 border-b border-[#E5E7EB]">
                    <h3 class="font-bold text-base text-[#0D2B6C]">Açık Rıza Metni</h3>
                    <button type="button" @@click="showAcikRizaModal = false"
                            class="text-[#9CA3AF] hover:text-[#374151] bg-transparent border-0 cursor-pointer text-xl leading-none">&times;</button>
                </div>
                <div class="px-6 py-4 overflow-y-auto text-xs text-[#374151] leading-[1.8] flex-1">
                    <p class="font-semibold mb-2">KİŞİSEL VERİLERİN İŞLENMESİNE İLİŞKİN AÇIK RIZA BEYANI</p>
                    <p>6698 Sayılı Kişisel Verilerin Korunması Kanunu ("Kanun") ve Aydınlatma Yükümlülüğünün Yerine Getirilmesinde Uyulacak Usul ve Esaslar Hakkında Tebliğ uyarınca "AYDINLATMA METNİ" veri sorumlusu tarafından tarafıma tebliğ edilmiş olup; Merkez Mah. Abide-i Hürriyet Cad. Meydan Apt. No:143/8 Şişli-İSTANBUL adresinde mukim Veri Sorumlusu İnteraktifKredi Danışmanlık A.Ş. tarafından toplanacak olan kişisel verilerimin işlenme sebeplerini, toplanma yöntemlerini, işlenme amaçlarını, işlemenin hukuki dayanağını, üçüncü kişilere aktarılıp aktarılmayacağını, aktarılacaksa hangi amaçlarla kimlere aktarılabileceğini, kişisel verilerimle ilgili olarak Kanun'un 11. maddesinde yazılı haklarımın bulunduğunu, Kanun çerçevesinde bu haklarımı kullanabileceğimi ve bu haklarım doğrultusunda Veri Sorumlusu'na nasıl başvurabileceğimi açıkça anladım.</p>
                    <p class="mt-3">Veri sorumlusu tarafından açık rızama dayalı olarak işlenecek ve aktarılacak olan, kısmen otomatik (interakifkredi App, interaktifkredi Web) yöntemlerle/vasıtasıyla işlenen Müşteri İşlem (kredi kullanım amacı, kredi onay bilgisi, kredi tutarı, vade), Kimlik (ad-soyad, doğum tarihi), İletişim (telefon no), kategorisi altındaki kişisel verilerimin "aydınlatma metni"nde yazılı pazarlama analiz çalışmalarının yürütülmesi, reklam/kampanya/promosyon süreçlerinin Yürütülmesi amacı doğrultusunda ve bu amaçlarla sınırlı olarak: İşlenmesine ve aydınlatma metninde belirtilen üçüncü kişilere aktarılmasına; işbu kutucuğa tıklamak kaydıyla açık rıza gösteriyorum.</p>
                </div>
                <div class="px-6 py-4 border-t border-[#E5E7EB]">
                    <button type="button"
                            @@click="consentOpenRiza = true; showAcikRizaModal = false"
