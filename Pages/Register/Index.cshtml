    <script src="~/js/toast.js"></script>
    <script defer src="~/lib/alpinejs/cdn.min.js"></script>
    <script src="~/lib/imask/imask.min.js"></script>
    <script>
        function registerForm() {
            return {
                firstName: '',
                lastName: '',
                email: '',
                birthDate: '',
                tckn: '',
                phone: '',
                phoneVerified: false,
                otpToken: '',
                showOtpModal: false,
                otpCode: '',
                timer: 180,
                timerInterval: null,
                sendingOtp: false,
                otpError: false,
                otpErrorMsg: '',
                verifyingOtp: false,
                otpVerifyError: false,
                otpVerifyErrorMsg: '',
                consentOpenRiza: false,
                consentAydinlatma: false,
                consentIleti: false,
                consentSms: false,
                consentEposta: false,
                consentArama: false,
                showAcikRizaModal: false,
                showAydinlatmaModal: false,
                registering: false,
                registerError: false,
                registerErrorMsg: '',

                init() {
                    var self = this;

                    var firstEl = document.getElementById('FirstName');
                    if (firstEl) {
                        firstEl.addEventListener('input', function () {
                            this.value = this.value.replace(/[^a-zA-ZğüşıöçĞÜŞİÖÇ \-]/g, '');
                            self.firstName = this.value.trim();
                        });
                    }

                    var lastEl = document.getElementById('LastName');
                    if (lastEl) {
                        lastEl.addEventListener('input', function () {
                            this.value = this.value.replace(/[^a-zA-ZğüşıöçĞÜŞİÖÇ \-]/g, '');
                            self.lastName = this.value.trim();
                        });
                    }

                    var emailEl = document.getElementById('Email');
                    if (emailEl) {
                        emailEl.addEventListener('input', function () { self.email = this.value.trim(); });
                        emailEl.addEventListener('blur', function () {
                            if (self.email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(self.email))
                                toast.warning('Geçerli bir e-posta adresi giriniz.');
                        });
                    }

                    var birthEl = document.getElementById('BirthDate');
                    if (birthEl) {
                        var dateMask = IMask(birthEl, { mask: '00/00/0000' });
                        dateMask.on('accept', function () { self.birthDate = dateMask.value; });
                    }

                    var tcknEl = document.getElementById('Tckn');
                    if (tcknEl) {
                        var tcknMask = IMask(tcknEl, { mask: '00000000000' });
                        tcknMask.on('accept', function () {
                            self.tckn = tcknMask.value;
                            self.phoneVerified = false;
                        });
                    }

                    // Türk GSM: +90 sonrası daima 5 ile başlar (5XX XXX XX XX)
                    var phoneEl = document.getElementById('PhoneNumber');
                    if (phoneEl) {
                        var phoneMask = IMask(phoneEl, {
                            mask: '+9\\0 N00 000 00 00',
                            definitions: { 'N': /[5]/ }
                        });
                        phoneMask.value = '+90 ';
                        self.phone = phoneMask.value;
                        phoneMask.on('accept', function () {
                            self.phone = phoneMask.value;
                            self.phoneVerified = false;
                        });
                    }
                },

                validateTckn(tckn) {
                    if (!/^\d{11}$/.test(tckn)) return false;
                    if (tckn[0] === '0') return false;
                    var d = tckn.split('').map(Number);
                    var oddSum  = d[0] + d[2] + d[4] + d[6] + d[8];
                    var evenSum = d[1] + d[3] + d[5] + d[7];
                    if ((oddSum * 7 - evenSum) % 10 !== d[9]) return false;
                    var sum10 = d[0]+d[1]+d[2]+d[3]+d[4]+d[5]+d[6]+d[7]+d[8]+d[9];
                    return sum10 % 10 === d[10];
                },

                canVerifyPhone() {
                    return this.phone.replace(/\D/g, '').length >= 12 && this.tckn.length === 11;
                },

                async sendOtp() {
                    this.otpError    = false;
                    this.otpErrorMsg = '';

                    if (!this.validateTckn(this.tckn)) {
                        this.otpError    = true;
                        this.otpErrorMsg = 'Geçerli bir TC Kimlik Numarası giriniz.';
                        return;
                    }

                    this.sendingOtp  = true;

                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    var params = new URLSearchParams();
                    params.append('__RequestVerificationToken', token);
                    params.append('PhoneNumber', this.phone);
                    params.append('Tckn', this.tckn);

                    try {
                        var resp = await fetch('/register?handler=SendOtp', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: params
                        });
                        var json = await resp.json();
                        if (json.success) {
                            this.openOtpModal();
                        } else {
                            this.otpError    = true;
                            this.otpErrorMsg = json.message || 'SMS gönderilemedi. Lütfen tekrar deneyin.';
                        }
                    } catch (_) {
                        this.otpError    = true;
                        this.otpErrorMsg = 'Bağlantı hatası oluştu.';
                    } finally {
                        this.sendingOtp = false;
                    }
                },

                maskedPhone() {
                    var digits = this.phone.replace(/\D/g, '');
                    if (digits.length < 12) return this.phone;
                    return '+90 ' + digits.substring(2, 5) + ' *** ** ' + digits.substring(10, 12);
                },

                timerDisplay() {
                    var m = Math.floor(this.timer / 60);
                    var s = this.timer % 60;
                    return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
                },

                openOtpModal() {
                    this.otpCode = '';
                    this.otpVerifyError = false;
                    this.otpVerifyErrorMsg = '';
                    this.showOtpModal = true;
                    this.timer = 180;
                    var self = this;
                    if (this.timerInterval) clearInterval(this.timerInterval);
                    this.timerInterval = setInterval(function () {
                        if (self.timer > 0) { self.timer--; }
                        else { clearInterval(self.timerInterval); }
                    }, 1000);
                },

                async verifyOtp() {
                    this.verifyingOtp      = true;
                    this.otpVerifyError    = false;
                    this.otpVerifyErrorMsg = '';

                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    var params = new URLSearchParams();
                    params.append('__RequestVerificationToken', token);
                    params.append('PhoneNumber', this.phone);
                    params.append('OtpCode', this.otpCode);

                    try {
                        var resp = await fetch('/register?handler=VerifyOtp', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: params
                        });
                        var json = await resp.json();
                        if (json.success) {
                            this.phoneVerified = true;
                            this.otpToken      = json.token || '';
                            this.showOtpModal  = false;
                            if (this.timerInterval) clearInterval(this.timerInterval);
                        } else {
                            this.otpVerifyError    = true;
                            this.otpVerifyErrorMsg = json.message || 'Kod hatalı. Lütfen tekrar deneyin.';
                        }
                    } catch (_) {
                        this.otpVerifyError    = true;
                        this.otpVerifyErrorMsg = 'Bağlantı hatası oluştu.';
                    } finally {
                        this.verifyingOtp = false;
                    }
                },

                canSubmit() {
                    return this.firstName.length >= 2
                        && this.lastName.length >= 2
                        && /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(this.email)
                        && this.birthDate.length === 10
                        && this.phoneVerified
                        && this.consentOpenRiza
                        && this.consentAydinlatma
                        && !this.registering;
                },

                explainWhyCannotVerify() {
                    if (this.tckn.length < 11)
                        return toast.warning('Önce TCKN alanını eksiksiz doldurunuz.');
                    if (!this.validateTckn(this.tckn))
                        return toast.warning('Geçerli bir TC Kimlik Numarası giriniz.');
                    if (this.phone.replace(/\D/g, '').length < 12)
                        return toast.warning('Telefon numaranızı eksiksiz giriniz.');
                },

                explainWhyCannotSubmit() {
                    if (!this.firstName || this.firstName.length < 2)
                        return toast.warning('Adınızı eksiksiz giriniz (en az 2 karakter).');
                    if (!this.lastName || this.lastName.length < 2)
                        return toast.warning('Soyadınızı eksiksiz giriniz (en az 2 karakter).');
                    if (!this.email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(this.email))
                        return toast.warning('Geçerli bir e-posta adresi giriniz.');
                    if (!this.birthDate || this.birthDate.length < 10)
                        return toast.warning('Doğum tarihinizi giriniz (GG/AA/YYYY).');
                    if (!this.phoneVerified)
                        return toast.warning('Telefon numaranızı doğrulamanız gerekmektedir.');
                    if (!this.consentOpenRiza)
                        return toast.warning('Açık Rıza Metni\'ni onaylamanız gerekmektedir.');
                    if (!this.consentAydinlatma)
                        return toast.warning('Aydınlatma Metni\'ni onaylamanız gerekmektedir.');
                },

                async submitForm() {
                    this.registering     = true;
                    this.registerError   = false;
                    this.registerErrorMsg = '';

                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    var params = new URLSearchParams();
                    params.append('__RequestVerificationToken', token);
                    params.append('FirstName',          this.firstName);
                    params.append('LastName',           this.lastName);
                    params.append('Email',              this.email);
                    params.append('BirthDate',          this.birthDate);
                    params.append('Tckn',               this.tckn);
                    params.append('PhoneNumber',        this.phone);
                    params.append('ConsentOpenRiza',    this.consentOpenRiza   ? 'true' : 'false');
                    params.append('ConsentAydinlatma',  this.consentAydinlatma ? 'true' : 'false');
                    params.append('ConsentIleti',       this.consentIleti      ? 'true' : 'false');
                    params.append('ConsentSms',         this.consentSms        ? 'true' : 'false');
                    params.append('ConsentEposta',      this.consentEposta     ? 'true' : 'false');
                    params.append('ConsentArama',       this.consentArama      ? 'true' : 'false');

                    try {
                        var resp = await fetch('/register?handler=Register', {
                            method: 'POST',
                            headers: {
                                'Content-Type':  'application/x-www-form-urlencoded',
                                'Authorization': 'Bearer ' + this.otpToken
                            },
                            body: params
                        });
                        var json = await resp.json();
                        if (json.success) {
                            localStorage.setItem('auth_token', json.token);
                            document.cookie = 'auth_token=' + json.token + '; path=/; SameSite=Lax';
                            toast.success('Kaydınız başarıyla oluşturulmuştur.', { duration: 3000 });
                            setTimeout(function () { window.location.href = '/anasayfa'; }, 1800);
                        } else {
                            var errMsg = json.message || 'Kayıt sırasında bir hata oluştu.';
                            toast.error(errMsg);
                            this.registerError    = true;
                            this.registerErrorMsg = errMsg;
                        }
                    } catch (_) {
                        toast.error('Bağlantı hatası oluştu.');
                        this.registerError    = true;
                        this.registerErrorMsg = 'Bağlantı hatası oluştu.';
                    } finally {
                        this.registering = false;
                    }
                }
            };
        }
    </script>

</body>
</html>
