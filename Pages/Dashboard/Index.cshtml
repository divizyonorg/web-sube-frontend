@page "/dashboard"
@model MyApp.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"]      = "Dashboard";
    ViewData["ActivePage"] = "Anasayfa";
}

@* ── PageBar ── *@
<div class="flex items-center justify-between pb-3 border-b border-[#DCE3FB]">
    <div class="flex flex-col">
        <span class="text-[14px] text-[#003F75]">Tekrar Hoşgeldin👋🏻</span>
        <span class="text-[18px] font-light text-[#003F75]">Mustafa</span>
    </div>
    <div class="text-right">
        <div class="text-[14px] text-[#003F75]">İnteraktif Kredi</div>
        <div class="text-[18px] font-light text-[#003F75]">WEB Şube</div>
    </div>
</div>

@* ── Dashboard içeriği ── *@
<div class="flex flex-col gap-6 mt-6">

    @* ── Birinci satır: 2 kart yan yana ── *@
    <div class="grid grid-cols-2 gap-6">

        @* Kredi Uygunluk Durumu kartı — 01-FO-01 *@
        @await Component.InvokeAsync("CreditEligibilityCard")

        @* Kredi Nabzı kartı — ileride başka task'ta eklenecek *@
        <div class="bg-[#E6F7FF] rounded-[15px] flex items-center justify-center min-h-[341px]">
            <span class="text-[#003F75]/40 text-sm">Bankalarda kredi muslukları açık mı?</span>
        </div>

    </div>

    @* ── İkinci satır: Kredi Danışmanlığı kartı — 01-FO-01 *@
    <div class="grid grid-cols-2 gap-6">

        @await Component.InvokeAsync("KrediDanismanligiCard")

        @* İkinci sütun — ileride başka task'ta eklenecek *@
        <div></div>

    </div>

</div>