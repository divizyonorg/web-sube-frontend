@page "/Sozlesmelerin"
@model MyApp.Web.Pages.Sozlesmelerim.IndexModel
@{
    ViewData["Title"]      = "Sözleşmelerin";
    ViewData["ActivePage"] = "Sözleşmelerin";
}

@section Styles {
<style>
    #layout-main .page-content { display: flex; flex-direction: column; }
</style>
}

<div class="flex flex-col gap-6 flex-1 min-h-0 font-[Poppins]">

    @* ── Sayfa Başlığı ── *@
    <div class="flex flex-col gap-1">
        <h1 class="font-[Poppins] font-bold text-[30px] leading-[36px] text-[#101828] m-0">Sözleşmelerin</h1>
        <p class="font-[Poppins] text-[16px] leading-[24px] text-[#4A5565] m-0">Tüm sözleşmelerini buradan görüntüleyebilir ve yönetebilirsin</p>
    </div>

    @* ── Yakında Kutusu ── *@
    <div class="flex-1 min-h-0">
        <div class="bg-white border border-[#E5E7EB] rounded-2xl h-full p-10 flex flex-col items-center justify-center gap-6">

            @* İkon *@
            <div class="w-20 h-20 rounded-full flex items-center justify-center"
                 style="background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <path d="M10 6H26L32 12V36H10V6Z" stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M26 6V12H32" stroke="#0056B3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M16 20H26" stroke="#0056B3" stroke-width="2" stroke-linecap="round"/>
                    <path d="M16 25H26" stroke="#0056B3" stroke-width="2" stroke-linecap="round"/>
                    <path d="M16 30H21" stroke="#0056B3" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </div>

            @* Başlık + Açıklama *@
            <div class="flex flex-col items-center gap-3 text-center">
                <h2 class="font-[Poppins] font-semibold text-[22px] leading-[33px] text-[#003F75] m-0">Çok Yakında</h2>
                <p class="font-[Poppins] text-[14px] leading-[22px] text-[#6A7282] m-0 max-w-[380px]">
                    Bu sayfadan kredi sözleşmelerini, ödeme planlarını ve tüm belgelerini tek yerden görüntüleyebileceksin.
                </p>
            </div>

        </div>
    </div>

</div>
