@page "/KrediBasvurusu"
@model MyApp.Web.Pages.KrediBasvurusu.IndexModel
@{
    ViewData["Title"]      = "Kredi Başvurusu";
    ViewData["ActivePage"] = "Kredi Başvurusu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="flex flex-col gap-6">

    @* ─── PageBar ─── *@
    <div class="box-border flex flex-row justify-between items-center pb-3 border-b border-[#DCE3FB]">
        <a href="/anasayfa" class="flex items-center gap-1 no-underline">
            <img src="~/icons/dark/chevron-left.svg" width="20" height="20" alt="">
            <span class="font-[Poppins] font-normal text-[14px] leading-5 text-[#1B4092]">Geri</span>
        </a>
        <div class="flex flex-col items-end">
            <span class="font-[Poppins] font-normal text-[14px] leading-5 text-right text-[#003F75]">İnteraktif Kredi</span>
            <span class="font-[Poppins] font-light text-[18px] leading-[25px] text-right text-[#003F75]">WEB Şube</span>
        </div>
    </div>

    @* ─── Wizard alanı ─── *@
    <div id="wizard-container" class="flex justify-center items-start pb-6 w-full">
        <partial name="~/Partials/KrediBasvurusu/_Step1.cshtml" />
    </div>

</div>

@section Scripts {
<script>
    document.body.addEventListener('htmx:afterSwap', function (e) {
        if (e.detail.target.id === 'wizard-container') {
            Alpine.initTree(e.detail.target);
        }
    });

    document.body.addEventListener('htmx:afterRequest', function (e) {
        if (!e.detail.successful) return;

        if (e.detail.elt.hasAttribute('data-pay-trigger')) {
            try {
                var r = JSON.parse(e.detail.xhr.responseText);
                if (r.success) {
                    htmx.ajax('GET', '/KrediBasvurusu?handler=Step7', { target: '#wizard-container', swap: 'innerHTML' });
                } else {
                    Toastify({ text: r.message || 'Ödeme sırasında hata oluştu.', duration: 3000,
                               gravity: 'top', position: 'right', style: { background: '#ef4444' } }).showToast();
                }
            } catch (_) {}
            return;
        }

        if (e.detail.elt.hasAttribute('data-coupon-trigger')) {
            try {
                var r = JSON.parse(e.detail.xhr.responseText);
                Toastify({ text: r.message, duration: 3000, gravity: 'top', position: 'right',
                           style: { background: r.success ? '#22c55e' : '#ef4444' } }).showToast();
                if (r.success && r.finalAmount != null) {
                    var fmt = '₺' + r.finalAmount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    var cardPrice = document.getElementById('coupon-card-price');
                    var payBtn = document.getElementById('coupon-pay-amount');
                    if (cardPrice) cardPrice.textContent = fmt;
                    if (payBtn) payBtn.textContent = fmt + ' Öde';
                    var input = e.detail.elt.querySelector('input[name="CouponCode"]');
                    if (input) input.value = '';
                }
            } catch (_) {}
            return;
        }

        if (e.detail.elt.hasAttribute('data-verify-trigger')) {
            try {
                var r = JSON.parse(e.detail.xhr.responseText);
                if (r.success) {
                    htmx.ajax('GET', '/KrediBasvurusu?handler=Step8', { target: '#wizard-container', swap: 'innerHTML' });
                } else {
                    Toastify({ text: r.message || 'Doğrulama başarısız.', duration: 3000,
                               gravity: 'top', position: 'right', style: { background: '#ef4444' } }).showToast();
                }
            } catch (_) {}
        }
    });
</script>
}
