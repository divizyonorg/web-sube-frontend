@page "/KrediBasvurusu"
@model MyApp.Web.Pages.KrediBasvurusu.IndexModel
@{
    ViewData["Title"]      = "Kredi Başvurusu";
    ViewData["ActivePage"] = "Kredi Başvurusu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Scripts {
<script>
    (function openKrediModal() {
        if (window.Alpine && Alpine.store) {
            Alpine.store('krediModal').open = true;
        } else {
            setTimeout(openKrediModal, 50);
        }
    })();
</script>
}
