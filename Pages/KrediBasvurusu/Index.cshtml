@page "/KrediBasvurusu"
@model MyApp.Web.Pages.KrediBasvurusu.IndexModel
@{
    ViewData["Title"]      = "Kredi Başvurusu";
    ViewData["ActivePage"] = "Kredi Başvurusu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Scripts {
<script>
    (function () {
        // Replace /KrediBasvurusu in history with /anasayfa so the back button
        // never lands back here and re-fires the modal.
        if (window.location.pathname === '/KrediBasvurusu') {
            history.replaceState(null, '', '/anasayfa');
        }
        if (window.openKrediModal) {
            window.openKrediModal();
        } else {
            (function retry() {
                window.openKrediModal ? window.openKrediModal() : setTimeout(retry, 50);
            })();
        }
    })();
</script>
}
