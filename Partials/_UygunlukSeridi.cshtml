@model MyApp.Web.ViewModels.UygunlukSeridiViewModel

<div class="flex flex-col items-center w-full bg-[#F9FAFB] p-5 gap-4" style="box-shadow: 0px -2px 4px rgba(0,0,0,0.25); border-radius: 25px 25px 0px 0px;">

    <p class="font-[Poppins] font-medium text-[18px] leading-[27px] text-[#003F75] text-center">
        Kredi Uygunluk Durumun
    </p>

    <div class="w-full flex flex-col px-2" style="gap: 4px;">

        <div class="relative w-full h-[35px] rounded-full shadow-[inset_0px_0px_4px_rgba(0,0,0,0.2)]"
             style="background: linear-gradient(90deg, rgba(255,255,255,0.5) 0%, #37B8C7 20%, #2E6DF8 50%, #122B62 100%);">

            <div class="absolute top-0 h-full w-px" style="left: 25%; background: rgba(217,217,217,0.5);"></div>
            <div class="absolute top-0 h-full w-px" style="left: 59%; background: rgba(217,217,217,0.5);"></div>
            <div class="absolute top-0 h-full w-px" style="left: 82%; background: rgba(217,217,217,0.5);"></div>

            <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2"
                 style="left: @(Model.MarkerPositionPercent)%;">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"
                     style="filter: drop-shadow(0px 0px 3.56px rgba(46,110,247,0.5));">
                    <path d="M7 4L10.44 10.07H3.56L7 4Z" fill="#1D459C" />
                </svg>
            </div>
        </div>

        <div class="relative w-full" style="height: 36px;">
            <span class="absolute font-[Poppins] font-normal text-[9px] leading-[14px] text-black/50"
                  style="left: 35px; top: 0;">premium</span>

            <span class="absolute font-[Poppins] font-semibold text-[22px] leading-[33px] text-[#1D459C] -translate-x-1/2"
                  style="left: @(Model.MarkerPositionPercent)%; top: 0;">@Model.UygunlukEtiketi</span>

            <span class="absolute font-[Poppins] font-normal text-[9px] leading-[14px] text-black/50"
                  style="left: calc(59% - 10px); top: 0;">kritik</span>

            <span class="absolute font-[Poppins] font-normal text-[9px] leading-[14px] text-black/50"
                  style="left: calc(82% - 13px); top: 0;">düşük</span>
        </div>
    </div>

    <div class="w-full flex flex-col bg-[#F9FAFB] rounded-[20px] p-4 gap-4" style="box-shadow: 0px 0px 4px rgba(0,0,0,0.20);">

        <div class="flex flex-col" style="gap: 2px;">
            <p class="font-[Poppins] font-medium text-[14px] leading-[21px] text-[#0A0A0A]">
                @Model.AnalizBaslik
            </p>
            <p class="font-[Poppins] font-normal text-[10px] leading-[15px] text-[#0A0A0A]">
                @Model.AnalizAltBaslik
            </p>
        </div>

        <div class="flex flex-col gap-1 pl-5">
            @foreach (var vurgu in Model.AnalizVurgular)
            {
                <p class="font-[Poppins] text-[12px] leading-[18px] text-[#003F75] @(vurgu.IsBold ? "font-medium" : "font-light")">
                    @vurgu.Text
                </p>
            }
        </div>

        <div class="relative pl-6">
            <div style="position: absolute; left: 12px; top: 20px; height: calc(100% - 20px); border-left: 1px dashed #2E6DF8;"></div>
            <p class="font-[Poppins] font-medium text-[12px] leading-[18px] text-[#2E6DF8]">
                @Model.BuSekildeBulguBaslik
            </p>
            <ul class="mt-[6px] flex flex-col gap-1">
                @foreach (var madde in Model.BuSekildeBulgular)
                {
                    <li class="flex items-start gap-4">
                        <span class="shrink-0 rounded-full bg-[#2E6DF8] mt-1.5" 
                              style="width: 7.98px; height: 8px; min-width: 7.98px;"></span>
                        <span class="font-[Poppins] font-light text-[12px] leading-5 text-[#003F75]">@madde</span>
                    </li>
                }
            </ul>
        </div>

        <div class="relative pl-6">
            <div style="position: absolute; left: 12px; top: 20px; height: calc(100% - 20px); border-left: 1px dashed #2E6DF8;"></div>
            <p class="font-[Poppins] font-medium text-[12px] leading-[18px] text-[#2E6DF8]">
                @Model.NelerYapilabilirBaslik
            </p>
            <ul class="mt-[6px] flex flex-col gap-1">
                @foreach (var madde in Model.NelerYapilabilir)
                {
                     <li class="flex items-start gap-4">
                         <span class="shrink-0 rounded-full bg-[#2E6DF8] mt-1.5"
                               style="width: 7.98px; height: 8px; min-width: 7.98px;"></span>
                         <span class="font-[Poppins] font-light text-[12px] leading-5 text-[#003F75]">@madde</span>
                    </li>
                }
            </ul>
        </div>

    </div>

    <p class="font-[Poppins] font-light text-[9px] leading-[14px] text-center text-black/50 self-center">
        Bu bir başvuru sonucu değil, sana özel yapay zeka destekli bir kredi uygunluk analizidir.
    </p>
</div>

<div class="flex flex-col items-center w-full"
     style="background: linear-gradient(98.13deg, #2E6DF8 39.12%, #0056B3 101.17%); padding: 32px 16px; gap: 20px;">
    <img src="~/icons/check-circle.svg" width="24" height="24" alt="">
    <p class="font-[Poppins] w-full" style="font-weight: 300; font-size: 14px; color: #FFFFFF; text-align: center;">@Model.CtaDescription</p>
    <p class="font-[Poppins]" style="font-weight: 500; font-size: 14px; color: #FFFFFF;">@Model.CtaTitle</p>
    <a href="@Model.CtaButtonHref"
       class="font-[Poppins] flex items-center justify-center"
       style="width: 280px; height: 44px; background: #FFFFFF; border-radius: 40px; color: #0056B3; font-weight: 500; font-size: 16px;">
        @Model.CtaButtonText
    </a>
</div>

<div class="flex flex-col w-full bg-white" style="padding: 16px; gap: 12px;">

    <div class="flex flex-col">
        <p class="font-[Poppins]" style="font-weight: 400; font-size: 14px; color: #003F75;">Mevcut Durumuna Göz At</p>
        <p class="font-[Poppins]" style="font-weight: 500; font-size: 16px; color: #003F75;">En Önemli Finansal Göstergeler</p>
    </div>

    <div class="flex flex-col" style="gap: 15px;">
        @foreach (var gosterge in Model.FinansalGostergeler)
        {
            <div style="background: #F2F8FF; border-radius: 10px; box-shadow: 0px 0px 4px rgba(0,0,0,0.25); padding: 16px; display: flex; flex-direction: column; gap: 8px;">
                <div class="flex items-center" style="gap: 8px;">
                    <img src="@Url.Content(gosterge.IkonYolu)" width="20" height="20" alt="">
                    <span class="font-[Poppins]" style="font-weight: 400; font-size: 14px; color: #003F75;">@gosterge.Baslik</span>
                </div>
                <div style="position: relative; width: 100%; height: 35px; border-radius: 20px; background: linear-gradient(270deg, rgba(255,255,255,0.9) 5.3%, #122B62 13%, #2E6DF8 49.5%, #32B5C8 80%, #36F99B 90%); box-shadow: inset 0px 0px 4px rgba(0,0,0,0.2); display: flex; align-items: center;">
                    <span class="font-[Poppins]" style="margin-left: 12px; font-weight: 700; font-size: 12px; color: #FFFFFF; white-space: nowrap;">@gosterge.LeftLabel</span>
                </div>
                @foreach (var satir in gosterge.Aciklama)
                {
                    <p class="font-[Poppins]" style="font-style: italic; font-weight: 300; font-size: 12px; color: #003F75; line-height: 18px;">@satir</p>
                }
            </div>
        }
    </div>

</div>
