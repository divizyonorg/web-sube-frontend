@model MyApp.Web.ViewModels.UygunlukSeridiViewModel

@* ─── Kart 1 · Kredi Uygunluk Durumun ─── *@
<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl">

    <div class="flex flex-col gap-1.5 px-4 py-3 border-b border-black/10">
        <div class="flex items-center gap-2">
            <img src="/icons/Outher/user-check-01.svg" width="20" height="20" alt="">
            <span class="font-[Poppins] text-[18px] font-semibold leading-6 text-[#003F75]">Kredi Uygunluk Durumun</span>
        </div>
        <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-black/50">
            Türkiye'deki bankaların sana benzer kredi profiline son 30 günde verdiği kararlara göre hesaplanmıştır.
        </p>
    </div>

    <div class="bg-white rounded-b-2xl px-4 pt-4 pb-4 flex flex-col gap-4">

        @{ var sliderPos = Math.Clamp(Model.MarkerPositionPercent, 0, 100); }
        <div x-data="{ pos: 50 }"
             x-init="setTimeout(() => pos = @sliderPos, 60)"
             class="flex flex-col gap-2">

            <div class="relative w-full" style="height: 42px;">
                <div :style="`position: absolute; left: ${pos}%; transform: translateX(-50%); bottom: 6px; display: flex; align-items: center; border-radius: 9999px; padding: 6px 18px; background-color: @Model.StatusBgColor; transition: left 0.8s cubic-bezier(0.4,0,0.2,1); white-space: nowrap;`">
                    <span class="font-['Poppins'] text-[14px] font-semibold leading-[21px] capitalize"
                          style="color: @Model.StatusTextColor;">@Model.UygunlukEtiketi</span>
                </div>
            </div>

            <div class="relative w-full h-5 rounded-full overflow-visible">
                <div class="absolute inset-0 rounded-full"
                     style="background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);"></div>
                <div class="absolute top-1/2 -translate-y-1/2 w-[10px] h-[25px] bg-white shadow-[0px_1px_4px_rgba(0,0,0,0.2)] rounded-[6px]"
                     :style="`left: calc(${pos}% - 5px); transition: left 0.8s cubic-bezier(0.4,0,0.2,1);`"></div>
            </div>

            <div class="flex justify-between">
                <span class="font-['Poppins'] text-[14px] font-normal leading-[21px] text-black/50">düşük</span>
                <span class="font-['Poppins'] text-[14px] font-normal leading-[21px] text-black/50">kritik</span>
                <span class="font-['Poppins'] text-[14px] font-normal leading-[21px] text-black/50">premium</span>
            </div>
        </div>

        <div class="flex flex-col gap-[2px]">
            <p class="font-[Poppins] font-medium text-[14px] leading-[21px] text-[#0A0A0A]">@Model.AnalizBaslik</p>
            <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-[#0A0A0A]">@Model.AnalizAltBaslik</p>
        </div>

        <div class="flex flex-col gap-1">
            @foreach (var vurgu in Model.AnalizVurgular)
            {
                <p class="font-[Poppins] text-[14px] leading-[21px] text-[#003F75] @(vurgu.IsBold ? "font-medium" : "font-[250]")">
                    @vurgu.Text
                </p>
            }
        </div>

        <div class="flex flex-col gap-2">
            <p class="font-[Poppins] font-medium text-[14px] leading-[21px] text-[#0A0A0A]">@Model.BuSekildeBulguBaslik @Model.NelerYapilabilirBaslik</p>
            <ul class="flex flex-col gap-1">
                @foreach (var madde in Model.BuSekildeBulgular)
                {
                    <li class="flex items-start gap-[6px]">
                        <img src="~/icons/Outher/dot-bullet.svg" class="shrink-0 mt-1 w-2 h-2" alt="">
                        <span class="font-[Poppins] font-[250] text-[14px] leading-5 text-[#003F75]">@madde</span>
                    </li>
                }
                @foreach (var madde in Model.NelerYapilabilir)
                {
                    <li class="flex items-start gap-[6px]">
                        <img src="~/icons/Outher/dot-bullet.svg" class="shrink-0 mt-1 w-2 h-2" alt="">
                        <span class="font-[Poppins] font-[250] text-[14px] leading-5 text-[#003F75]">@madde</span>
                    </li>
                }
            </ul>
        </div>

        <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-center text-black/50">
            Bu bir başvuru sonucu değil, sana özel yapay zeka destekli bir kredi uygunluk analizidir.
        </p>

    </div>
</div>

@* ─── CTA · Mavi Gradyan ─── *@
<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl overflow-hidden">
    <div class="flex flex-col items-center bg-[linear-gradient(98.13deg,#2E6DF8_39.12%,#0056B3_101.17%)] py-8 px-4 gap-5">
        <img src="~/icons/Outher/check-circle.svg" class="w-6 h-6" alt="">
        <p class="font-[Poppins] font-semibold text-[18px] text-white">@Model.CtaTitle</p>
        <p class="font-[Poppins] font-[250] text-[14px] text-white text-center w-full">@Model.CtaDescription</p>
        <a href="@Model.CtaButtonHref"
           class="font-[Poppins] flex items-center justify-center w-[280px] h-[44px] bg-white rounded-[40px] text-[#0056B3] font-medium text-[14px] no-underline">
            @Model.CtaButtonText
        </a>
    </div>
</div>

@* ─── Kart 2 · Finansal Göstergeler ─── *@
<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl">

    <div class="flex flex-col gap-1.5 px-4 py-3 border-b border-black/10">
        <div class="flex items-center gap-2">
            <img src="/icons/primary/activity.svg" width="20" height="20" alt="">
            <span class="font-[Poppins] text-[18px] font-semibold leading-6 text-[#003F75]">En Önemli Finansal Göstergeler</span>
        </div>
        <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-black/50">
            Kredi profili değerlendirmesinde kullanılan temel göstergelerinin güncel durumu.
        </p>
    </div>

    <div class="bg-white rounded-b-2xl px-4 py-4">
        <div class="flex flex-col divide-y-2 divide-[#C8D6E8]">
            @if (Model.FinansalGostergeler.Any())
            {
                @foreach (var gosterge in Model.FinansalGostergeler)
                {
                    var _d = new string((gosterge.LeftLabel ?? "").Where(char.IsDigit).ToArray());
                    int.TryParse(_d, out int gPct);
                    if (gPct == 0) gPct = 50;
                    <div class="bg-white rounded-[10px] p-4 flex flex-col gap-2">
                        <div class="flex items-center gap-2">
                            <img src="@Url.Content(gosterge.IkonYolu)" class="w-5 h-5" alt="">
                            <span class="font-[Poppins] font-medium text-[14px] text-[#003F75]">@gosterge.Baslik</span>
                        </div>
                        <div x-data="{ pos: 0 }" x-init="setTimeout(() => pos = @gPct, 60)" class="flex flex-col gap-2">
                            <div class="relative w-full" style="height: 42px;">
                                <div :style="`position: absolute; left: ${pos}%; transform: translateX(-50%); bottom: 6px; display: flex; align-items: center; border-radius: 9999px; padding: 4px 14px; background-color: #EEF4FF; transition: left 0.8s cubic-bezier(0.4,0,0.2,1); white-space: nowrap;`">
                                    <span class="font-['Poppins'] text-[14px] font-semibold" style="color: #2E6DF8;">%@gPct</span>
                                </div>
                            </div>
                            <div class="relative w-full h-5 rounded-full overflow-visible">
                                <div class="absolute inset-0 rounded-full"
                                     style="background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);"></div>
                                <div class="absolute top-1/2 -translate-y-1/2 w-[10px] h-[25px] bg-white shadow-[0px_1px_4px_rgba(0,0,0,0.2)] rounded-[6px]"
                                     :style="`left: calc(${pos}% - 5px); transition: left 0.8s cubic-bezier(0.4,0,0.2,1);`"></div>
                            </div>
                        </div>
                        @foreach (var satir in gosterge.Aciklama)
                        {
                            <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">@satir</p>
                        }
                    </div>
                }
            }
            else
            {
                <div class="bg-white rounded-[10px] p-4 flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <img src="/icons/primary/activity.svg" class="w-5 h-5" alt="">
                        <span class="font-[Poppins] font-medium text-[14px] text-[#003F75]">Aylık Nakit Akışı Dengesi</span>
                    </div>
                    <div x-data="{ pos: 0 }" x-init="setTimeout(() => pos = 95, 60)" class="flex flex-col gap-2">
                        <div class="relative w-full" style="height: 42px;">
                            <div :style="`position: absolute; left: ${pos}%; transform: translateX(-50%); bottom: 6px; display: flex; align-items: center; border-radius: 9999px; padding: 4px 14px; background-color: #EEF4FF; transition: left 0.8s cubic-bezier(0.4,0,0.2,1); white-space: nowrap;`">
                                <span class="font-['Poppins'] text-[14px] font-semibold" style="color: #2E6DF8;">%95</span>
                            </div>
                        </div>
                        <div class="relative w-full h-5 rounded-full overflow-visible">
                            <div class="absolute inset-0 rounded-full"
                                 style="background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);"></div>
                            <div class="absolute top-1/2 -translate-y-1/2 w-[10px] h-[25px] bg-white shadow-[0px_1px_4px_rgba(0,0,0,0.2)] rounded-[6px]"
                                 :style="`left: calc(${pos}% - 5px); transition: left 0.8s cubic-bezier(0.4,0,0.2,1);`"></div>
                        </div>
                    </div>
                    <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">Gelirinin %90'ı borçlara gidiyor.</p>
                    <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">Bu, bankalar için "yeni kredi alanı yok" demektir.</p>
                </div>

                <div class="bg-white rounded-[10px] p-4 flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <img src="/icons/Outher/credit-card-01.svg" class="w-5 h-5" alt="">
                        <span class="font-[Poppins] font-medium text-[14px] text-[#003F75]">Yasal Kart Limit Kotası</span>
                    </div>
                    <div x-data="{ pos: 0 }" x-init="setTimeout(() => pos = 85, 60)" class="flex flex-col gap-2">
                        <div class="relative w-full" style="height: 42px;">
                            <div :style="`position: absolute; left: ${pos}%; transform: translateX(-50%); bottom: 6px; display: flex; align-items: center; border-radius: 9999px; padding: 4px 14px; background-color: #EEF4FF; transition: left 0.8s cubic-bezier(0.4,0,0.2,1); white-space: nowrap;`">
                                <span class="font-['Poppins'] text-[14px] font-semibold" style="color: #2E6DF8;">%85</span>
                            </div>
                        </div>
                        <div class="relative w-full h-5 rounded-full overflow-visible">
                            <div class="absolute inset-0 rounded-full"
                                 style="background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);"></div>
                            <div class="absolute top-1/2 -translate-y-1/2 w-[10px] h-[25px] bg-white shadow-[0px_1px_4px_rgba(0,0,0,0.2)] rounded-[6px]"
                                 :style="`left: calc(${pos}% - 5px); transition: left 0.8s cubic-bezier(0.4,0,0.2,1);`"></div>
                        </div>
                    </div>
                    <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">Yasal kart limit kotası dolmak üzere.</p>
                    <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">Yeni kart veya limit artışı şu an mümkün değil.</p>
                </div>

                <div class="bg-white rounded-[10px] p-4 flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <img src="/icons/Outher/credit-card-01.svg" class="w-5 h-5" alt="">
                        <span class="font-[Poppins] font-medium text-[14px] text-[#003F75]">Kredi Limit Kullanım Oranı</span>
                    </div>
                    <div x-data="{ pos: 0 }" x-init="setTimeout(() => pos = 95, 60)" class="flex flex-col gap-2">
                        <div class="relative w-full" style="height: 42px;">
                            <div :style="`position: absolute; left: ${pos}%; transform: translateX(-50%); bottom: 6px; display: flex; align-items: center; border-radius: 9999px; padding: 4px 14px; background-color: #EEF4FF; transition: left 0.8s cubic-bezier(0.4,0,0.2,1); white-space: nowrap;`">
                                <span class="font-['Poppins'] text-[14px] font-semibold" style="color: #2E6DF8;">%95</span>
                            </div>
                        </div>
                        <div class="relative w-full h-5 rounded-full overflow-visible">
                            <div class="absolute inset-0 rounded-full"
                                 style="background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);"></div>
                            <div class="absolute top-1/2 -translate-y-1/2 w-[10px] h-[25px] bg-white shadow-[0px_1px_4px_rgba(0,0,0,0.2)] rounded-[6px]"
                                 :style="`left: calc(${pos}% - 5px); transition: left 0.8s cubic-bezier(0.4,0,0.2,1);`"></div>
                        </div>
                    </div>
                    <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">Kredi limitlerinin %85'ini kullanıyorsun.</p>
                    <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">Bu durum kredi profilini olumsuz etkiliyor.</p>
                </div>
            }
        </div>
    </div>

</div>

@* ─── Kart 3 · Olumlu Noktalar ─── *@
<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl">

    <div class="flex flex-col gap-1.5 px-4 py-3 border-b border-black/10">
        <div class="flex items-center gap-2">
            <img src="/icons/Outher/stars-02.svg" width="20" height="20" alt="">
            <span class="font-[Poppins] text-[18px] font-semibold leading-6 text-[#003F75]">@Model.OlumluNoktalarBaslik</span>
        </div>
        <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-black/50">
            @Model.OlumluNoktalarUstBaslik
        </p>
    </div>

    <div class="bg-white rounded-b-2xl px-4 py-4">
        <ul class="flex flex-col gap-1">
            @foreach (var madde in Model.OlumluNoktalar)
            {
                <li class="flex items-start gap-[6px]">
                    <img src="~/icons/Outher/dot-bullet.svg" class="shrink-0 mt-1 w-2 h-2" alt="">
                    <span class="font-[Poppins] font-[250] text-[14px] text-[#2E6DF8] leading-[21px]">@madde</span>
                </li>
            }
        </ul>
    </div>

</div>

@* ─── Kart 4 · Kredi Türü Analizi ─── *@
<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl">

    <div class="flex flex-col gap-1.5 px-4 py-3 border-b border-black/10">
        <div class="flex items-center gap-2">
            <img src="/icons/Outher/credit-card-01.svg" width="20" height="20" alt="">
            <span class="font-[Poppins] text-[18px] font-semibold leading-6 text-[#003F75]">@Model.KrediTuruBaslik</span>
        </div>
        <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-black/50">
            @Model.KrediTuruUstBaslik
        </p>
    </div>

    <div class="bg-white rounded-b-2xl px-4 py-4">
        <div class="flex flex-col gap-[10px] sm:flex-row">
            @foreach (var kart in Model.KrediTuruKartlari)
            {
                <div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-[10px] px-[10px] py-[15px] flex flex-col gap-[10px] flex-1">
                    <div class="flex items-center justify-between gap-2">
                        <p class="font-[Poppins] font-semibold text-[14px] text-[#003F75]">@kart.Baslik</p>
                        <button type="button" class="font-[Poppins] border border-[rgba(217,217,217,0.5)] rounded-[10px] py-1 px-3 font-[250] text-[14px] text-[#2E6DF8] underline bg-transparent cursor-pointer whitespace-nowrap">
                            detayları gör
                        </button>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-[68px] h-[15px] rounded-[20px] shadow-[inset_0px_0px_4px_rgba(0,0,0,0.2)]"
                             style="background: @kart.BarGradient;">
                        </div>
                        <span class="font-[Poppins] font-[250] text-[14px] text-[#003F75]">@kart.OlasilikEtiketi</span>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

@* ─── Kart 5 · Uyarılar ─── *@
<div class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl">

    <div class="flex flex-col gap-1.5 px-4 py-3 border-b border-black/10">
        <div class="flex items-center gap-2">
            <img src="/icons/Outher/alert-triangle.svg" width="20" height="20" alt="">
            <span class="font-[Poppins] text-[18px] font-semibold leading-6 text-[#003F75]">@Model.UyarilarBaslik</span>
        </div>
        <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-black/50">
            Kredi sürecinizi olumsuz etkileyebilecek faktörler ve alınabilecek önlemler.
        </p>
    </div>

    <div class="bg-white rounded-b-2xl px-4 py-4">
        <div class="flex flex-col gap-3">
            @foreach (var uyari in Model.UyariKartlari)
            {
                <div class="flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <span class="shrink-0 px-2.5 py-[3px] rounded-full font-[Poppins] font-semibold text-[14px] text-white @(uyari.IsKritik ? "bg-[#0056B3]" : "bg-[#2E6DF8]")">
                            @(uyari.IsKritik ? "KRİTİK" : "ÖNEMLİ")
                        </span>
                        <span class="font-[Poppins] font-medium text-[14px] text-[#003F75] capitalize flex-1">@uyari.Baslik</span>
                        <button type="button" class="shrink-0 font-[Poppins] border border-[#DCE3FB] rounded-[16px] py-[5px] px-4 font-[250] text-[14px] text-[#2E6DF8] bg-white cursor-pointer">
                            detayları gör
                        </button>
                    </div>
                    <p class="font-[Poppins] font-[250] text-[14px] text-[#003F75] leading-[21px]">@uyari.Aciklama</p>
                </div>
            }
        </div>
    </div>

</div>

@* ─── Kart 6 · Bireysel CTA ─── *@
<div class="bg-[#F2F8FF] border border-[#2E6DF8] rounded-2xl overflow-hidden">

    <div class="flex items-center bg-[linear-gradient(120.44deg,#2E6DF8_70.34%,#1B4092_100.84%)] px-4 py-3 gap-3">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
            <circle cx="10" cy="10" r="9" stroke="#FFFFFF" stroke-width="1.67"/>
            <path d="M10 5.83V10.83" stroke="#FFFFFF" stroke-width="1.67" stroke-linecap="round"/>
            <circle cx="10" cy="14.17" r="1" fill="#FFFFFF"/>
        </svg>
        <span class="font-[Poppins] font-medium text-[14px] text-white flex-1">@Model.BireyselCtaUyariMetni</span>
    </div>

    <div class="bg-white flex flex-col items-center px-4 pt-5 pb-4 gap-4">
        <p class="font-[Poppins] font-[250] text-center text-[14px] text-[#003F75] leading-[21px]">@Model.BireyselCtaAciklama</p>

        <p class="font-[Poppins] font-semibold text-[18px] text-[#003F75] text-center">@Model.BireyselCtaBaslikSatir1 @Model.BireyselCtaBaslikSatir2</p>

        <div class="flex flex-col w-full gap-[10px]">
            @foreach (var madde in Model.BireyselCtaChecklistMaddeleri)
            {
                <div class="flex items-center gap-2">
                    <img src="~/icons/check-circle-broken.svg" class="w-5 h-5 shrink-0" alt="">
                    <span class="font-[Poppins] font-[250] text-[14px] text-[#3AD7B3]">@madde</span>
                </div>
            }
        </div>

        <p class="font-[Poppins] font-[250] text-center text-[14px] leading-[21px] text-[#003F75]">@Model.BireyselCtaAltAciklama</p>

        <a href="@Model.BireyselCtaButonHref"
           class="font-[Poppins] flex items-center justify-center w-[280px] h-[44px] bg-[#0056B3] rounded-[40px] font-medium text-[14px] text-white no-underline">
            @Model.BireyselCtaButonMetni
        </a>

        <p class="font-[Poppins] font-[250] text-center text-[14px] leading-[21px] text-[#003F75]">@Model.BireyselCtaButonAltiNot</p>
    </div>

</div>
