@model MyApp.Web.ViewModels.InterestRateTrendViewModel
@{ Layout = null; }
@{
    var opts = new (string Type, string Label)[]
    {
        ("IHTIYAC", "İhtiyaç Kredisi"),
        ("TASIT",   "Taşıt Kredisi"),
        ("KONUT",   "Konut Kredisi"),
        ("TICARI",  "Ticari Kredi")
    };
}

<div id="card-faiz-trendi" class="bg-[#F2F8FF] border border-[#DCE3FB] rounded-2xl">

    <div class="flex flex-col gap-1.5 px-4 py-3 border-b border-black/10">
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
                <img src="/icons/primary/activity.svg" width="20" height="20" alt="">
                <span class="font-[Poppins] text-[15px] font-semibold leading-6 text-[#003F75]">Faiz Oranı Trendi</span>
            </div>
            <div x-data="{ open: false }" class="relative">
                <button @@click="open = !open" type="button"
                        class="flex items-center gap-1 bg-white border border-[#E5E7EB] shadow-[0px_1px_3px_rgba(0,0,0,0.1),0px_1px_2px_-1px_rgba(0,0,0,0.1)] rounded-[10px] px-2.5 py-1.5">
                    <span class="font-[Poppins] text-[12px] font-normal leading-[18px] text-[#003F75]">@Model.ProductLabel</span>
                    <img src="/icons/navy/chevron-down.svg" width="12" height="12" alt="">
                </button>
                <div x-show="open" @@click.outside="open = false" x-transition
                     class="absolute right-0 top-full mt-1 z-50 bg-white border border-[#E5E7EB] rounded-[10px] shadow-lg overflow-hidden min-w-[140px]">
                    @foreach (var opt in opts)
                    {
                        var cls = Model.CreditType == opt.Type
                            ? "block px-4 py-2 text-[12px] font-[Poppins] font-semibold text-[#003F75] bg-[#F2F8FF] cursor-pointer"
                            : "block px-4 py-2 text-[12px] font-[Poppins] text-black/60 hover:bg-[#F2F8FF] cursor-pointer";
                        <button type="button"
                                hx-get="/KrediRaporlari/KurDetay?handler=FaizTrendi&kredi=@opt.Type"
                                hx-target="#card-faiz-trendi"
                                hx-swap="outerHTML show:none"
                                @@click="open = false"
                                class="w-full text-left @cls">@opt.Label</button>
                    }
                </div>
            </div>
        </div>
        <p class="font-[Poppins] italic font-light text-[12px] leading-[18px] text-black/50">
            Faiz oranı trendi, bankaların geçen hafta müşterilere fiilen kullandırılan kredilerin ağırlıklı ortalamasıdır.
        </p>
    </div>

    <div class="flex flex-col gap-3 rounded-b-2xl bg-[#122B62] px-4 pt-4 pb-0" style="overflow:visible;">

        <div class="flex justify-between items-start">
            <div class="flex flex-col gap-0.5">
                <span class="font-['Poppins'] text-[12px] font-light leading-[18px] text-white opacity-80">@Model.RateLabel</span>
                <div class="flex items-end gap-1.5">
                    <span class="font-['Poppins'] text-[28px] font-bold leading-[42px] text-white">@Model.RateValue</span>
                    <span class="font-['Poppins'] text-[13px] font-light leading-[20px] text-white pb-1">@Model.PeriodSuffix</span>
                </div>
            </div>
            <div class="flex flex-col items-end gap-0.5">
                <div class="flex items-center gap-1">
                    <img src="/icons/green/line-chart-up-02.svg" width="14" height="14" alt="">
                    <span class="font-['Poppins'] text-[14px] font-semibold leading-[22px] text-[#46CA88]">@Model.AnnualRateValue</span>
                </div>
                <span class="font-['Poppins'] text-[12px] font-light leading-[18px] text-[#46CA88] opacity-75">Son 3 Ay</span>
            </div>
        </div>

        <div class="w-full" style="height:80px; overflow:visible; margin:0 -16px; width:calc(100% + 32px); position:relative; z-index:10;">
            <div id="faiz-trendi-chart"></div>
        </div>

        <div class="flex items-center justify-between flex-wrap gap-2 pb-4" style="margin-top:-4px;">
            <span class="font-['Poppins'] text-[11px] font-light leading-[16px] text-white px-3 py-1 bg-white/25 border border-black/25 rounded-full">
                @Model.MarketAverageLabel
            </span>
            <span class="flex items-center gap-1 font-['Poppins'] text-[11px] font-semibold leading-[16px] text-white px-[10px] py-1 bg-[rgba(70,202,136,0.6)] border border-black/25 rounded-full">
                <img src="/icons/white/sparkle.svg" width="12" height="12" alt="">
                @Model.OpportunityLabel
            </span>
        </div>

    </div>
</div>

<style>
    #faiz-trendi-chart .apexcharts-tooltip {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        overflow: visible !important;
    }
</style>

<script>
(function () {
    @{
        var culture = new System.Globalization.CultureInfo("tr-TR");
        var now = DateTime.Now;
        var monthLabels = new[] {
            now.AddMonths(-2).ToString("MMMM yyyy", culture),
            now.AddMonths(-1).ToString("MMMM yyyy", culture),
            now.ToString("MMMM yyyy", culture)
        };
    }
    var chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData));
    var chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthLabels));

    function renderFaizChart() {
        var el = document.getElementById('faiz-trendi-chart');
        if (!el || typeof ApexCharts === 'undefined') return;
        if (el._apex) { el._apex.destroy(); el._apex = null; }

        var chart = new ApexCharts(el, {
            series: [{ data: chartData }],
            chart: {
                type: 'area',
                height: 80,
                sparkline: { enabled: true },
                background: 'transparent',
                animations: { enabled: true, speed: 500 }
            },
            stroke: { curve: 'smooth', width: 2.5, colors: ['#46CA88'] },
            fill: {
                type: 'gradient',
                gradient: {
                    opacityFrom: 0.28,
                    opacityTo: 0,
                    colorStops: [
                        { offset: 0, color: '#46CA88', opacity: 0.28 },
                        { offset: 100, color: '#46CA88', opacity: 0 }
                    ]
                }
            },
            markers: {
                size: 4,
                colors: ['#46CA88'],
                strokeColors: '#FFFFFF',
                strokeWidth: 1.5,
                hover: { size: 6 }
            },
            xaxis: { categories: chartLabels },
            yaxis: { min: function (min) { return min * 0.97; } },
            tooltip: {
                custom: function (opts) {
                    var val = opts.series[opts.seriesIndex][opts.dataPointIndex];
                    var label = chartLabels[opts.dataPointIndex];
                    return '<div style="' +
                        'background:#FFFFFF;' +
                        'border-radius:10px;' +
                        'padding:8px 13px 9px;' +
                        'font-family:Poppins,sans-serif;' +
                        'box-shadow:0 4px 20px rgba(0,0,0,0.22),0 1px 4px rgba(0,0,0,0.10);' +
                        'min-width:110px;pointer-events:none;' +
                        '">' +
                        '<div style="font-size:11px;font-weight:400;color:#6B7280;margin-bottom:2px;">' + label + '</div>' +
                        '<div style="font-size:19px;font-weight:700;color:#003F75;line-height:1.2;">%' + val.toFixed(2).replace('.', ',') + '</div>' +
                        '<div style="font-size:10px;font-weight:400;color:#9CA3AF;margin-top:3px;">Aylık Faiz Oranı</div>' +
                        '</div>';
                }
            },
            dataLabels: { enabled: false }
        });

        chart.render();
        el._apex = chart;
    }

    renderFaizChart();
    if (typeof ApexCharts === 'undefined') {
        window.addEventListener('load', renderFaizChart, { once: true });
    }
})();
</script>
