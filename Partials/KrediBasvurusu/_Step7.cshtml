@model MyApp.Web.ViewModels.FindeksOtpViewModel
@* ══════════════════════════════════════
   ADIM 6 — Raporunu Oluşturuyoruz (Findeks OTP)
══════════════════════════════════════ *@
<div x-data="{
         otp: ['','','','','',''],
         seconds: 121,
         get isComplete() { return this.otp.every(v => v !== ''); },
         get timeLabel() {
             const m = String(Math.floor(this.seconds / 60)).padStart(2, '0');
             const s = String(this.seconds % 60).padStart(2, '0');
             return m + ':' + s;
         },
         onInput(e, i) {
             const v = e.target.value.replace(/\D/g, '');
             this.otp[i] = v.slice(-1);
             e.target.value = this.otp[i];
             if (this.otp[i] && i < 5) e.target.parentElement.children[i + 1].focus();
         },
         onBack(e, i) {
             if (!this.otp[i] && i > 0) {
                 this.otp[i - 1] = '';
                 e.target.parentElement.children[i - 1].focus();
             }
         }
     }"
     x-init="setInterval(() => { if (seconds > 0) seconds--; }, 1000)"
     class="box-border w-full max-w-[420px] bg-white border border-[#E2EAF5] shadow-[0_4px_24px_rgba(0,86,179,0.10)] rounded-[20px] overflow-hidden flex flex-col">

    @* Kart başlığı — sadece logo + kapat *@
    <div class="box-border flex justify-between items-center px-4 py-3 h-[57px] border-b border-black/[0.08] shrink-0">
        <div class="w-8"></div>
        <img src="~/images/ik_logo.png" alt="İnteraktif Kredi" class="h-[25px] object-contain">
        <a href="/anasayfa" class="w-8 h-8 rounded-full flex items-center justify-center no-underline">
            <img src="~/icons/slate/x-close.svg" width="16" height="16" alt="">
        </a>
    </div>

    @* İçerik *@
    <div class="flex flex-col items-center px-6 pb-6">

        @* Yeşil onay ikonu (3 katmanlı) *@
        <div class="mt-6 relative w-[64px] h-[64px]">
            <div class="absolute inset-0 bg-[rgba(70,202,136,0.18)] rounded-full"></div>
            <div class="absolute inset-[9px] bg-[rgba(70,202,136,0.30)] rounded-full"></div>
            <div class="absolute inset-[14px] bg-[#46CA88] rounded-full flex items-center justify-center">
                <img src="~/icons/white/check.svg" width="14" height="18" alt="">
            </div>
        </div>

        @* Başlık *@
        <h2 class="mt-4 font-[Poppins] font-medium text-[18px] leading-[27px] text-center text-black m-0">
            Raporunu Oluşturuyoruz
        </h2>

        @* Açıklama *@
        <p class="mt-3 font-[Poppins] font-light text-[14px] leading-6 text-center text-black m-0">
            Ödemen başarıyla alındı. @Model.Mesaj
        </p>

        @* OTP kutuları *@
        <div class="mt-6 flex justify-center gap-2">
            @for (int i = 0; i < 6; i++) {
                <input type="text" maxlength="1" inputmode="numeric"
                       @@input="onInput($event, @(i))"
                       @@keydown.backspace="onBack($event, @(i))"
                       :class="otp[@(i)] !== ''
                           ? 'border-[#2E6DF8] shadow-[0_2px_10px_rgba(46,109,248,0.20)]'
                           : 'border-[#D1DDF5] shadow-[0_1px_3px_rgba(0,0,0,0.08)]'"
                       class="w-[46px] h-[54px] box-border bg-white border-2 rounded-[10px] text-center font-[Poppins] font-bold text-[22px] text-[#003F75] outline-none shrink-0">
            }
        </div>

        @* Findeks bilgi notu *@
        <div class="mt-4 w-full flex items-start gap-3 bg-[#F0F0F0] rounded-[10px] px-3 py-[13px]">
            <div class="w-[18px] h-[18px] shrink-0 mt-[1px] bg-[#2E6DF8] border border-[#5389FF] rounded-[4px] flex items-center justify-center">
                <img src="~/icons/white/alert-circle.svg" width="10" height="10" alt="" style="filter: brightness(0) invert(1);">
            </div>
            <p class="font-[Poppins] font-medium text-[12px] leading-[18px] text-black m-0">
                <strong>Findeks</strong>, Türkiye'de bankalar ve finans kuruluşları tarafından kullanılan resmi kredi bilgi sistemidir.
            </p>
        </div>

        @* Geri sayım *@
        <p class="mt-3 font-[Poppins] font-normal text-[12px] leading-[18px] text-center text-black m-0">
            Kalan süre: <span x-text="timeLabel"></span>
        </p>

        @* Doğrula formu *@
        <form hx-post="/KrediBasvurusu?handler=VerifyOtp"
              hx-swap="none"
              data-verify-trigger
              class="w-full mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Pin" :value="otp.join('')">

            <button type="submit"
                    :disabled="!isComplete"
                    :class="isComplete ? 'opacity-100 cursor-pointer' : 'opacity-50 cursor-not-allowed'"
                    class="flex justify-center items-center w-full h-[54px] bg-linear-to-r from-[#0056B3] to-[#2E6DF8] rounded-[59px] border-none font-[Poppins] font-semibold text-[15px] text-white">
                Doğrula ve Raporu Gör
            </button>
        </form>

    </div>
</div>
