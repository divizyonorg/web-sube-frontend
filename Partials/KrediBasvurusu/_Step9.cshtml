@* ══════════════════════════════════════
   ADIM 9 — Yükleniyor → Raporun Hazır!
══════════════════════════════════════ *@
<style>
    @@keyframes dotBounce {
        0%, 80%, 100% { transform: translateY(0); opacity: 1; }
        40%            { transform: translateY(-8px); opacity: 0.5; }
    }
    .dot-bounce { animation: dotBounce 1.2s ease-in-out infinite; }
    .dot-bounce-1 { animation-delay: 0s; }
    .dot-bounce-2 { animation-delay: 0.2s; }
    .dot-bounce-3 { animation-delay: 0.4s; }
</style>

<div x-data="{
         ready: false,
         init() { setTimeout(() => this.ready = true, 2000); }
     }">

    @* ── Yükleme Ekranı (ilk 2 saniye) ── *@
    <div x-show="!ready"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="box-border w-full max-w-[420px] bg-white border border-[#E2EAF5] shadow-[0_4px_24px_rgba(0,86,179,0.10)] rounded-[20px] overflow-hidden flex flex-col">

        @* İlerleme çubuğu — Adım 3/3 (tümü mavi) *@
        <div class="flex flex-col px-6 pt-5 pb-0 gap-2 shrink-0">
            <span class="font-[Poppins] font-normal text-[12px] leading-[18px] text-[#333333]">
                Adım 3/3: Ödemeni Tamamla
            </span>
            <div class="flex flex-row gap-1 w-full">
                <div class="flex-1 h-[6px] bg-[#006EFF] rounded-full"></div>
                <div class="flex-1 h-[6px] bg-[#006EFF] rounded-full"></div>
                <div class="flex-1 h-[6px] bg-[#006EFF] rounded-full"></div>
            </div>
        </div>

        @* İçerik — dikey ortala *@
        <div class="flex flex-col items-center justify-center px-6 py-12 gap-5">

            @* Yeşil check ikonu (3 katmanlı) *@
            <div class="relative w-[80px] h-[80px] shrink-0">
                <div class="absolute -inset-[7.5px] bg-[rgba(70,202,136,0.15)] opacity-[0.17] rounded-full"></div>
                <div class="absolute inset-[11px] bg-[rgba(70,202,136,0.25)] rounded-full"></div>
                <div class="absolute inset-[19px] bg-[#46CA88] rounded-full flex items-center justify-center">
                    <img src="~/icons/white/check-circle.svg" width="24" height="24" alt="">
                </div>
            </div>

            @* Başlık *@
            <h2 class="font-[Poppins] font-medium text-[18px] leading-[27px] text-center text-black m-0">
                Ödemen alındı,<br>
                Kredi Güven Raporu'n oluşturuluyor
            </h2>

            @* Alt başlık *@
            <p class="font-[Poppins] font-light text-[14px] leading-[22px] text-center text-[#666666] m-0">
                Raporun saniyeler içinde hazır olacak.<br>
                Lütfen bu sayfadan ayrılma.
            </p>

            @* Animasyonlu mavi noktalar *@
            <div class="flex flex-row items-center gap-[15px] mt-2">
                <div class="w-[8px] h-[8px] bg-[#2E6DF8] rounded-full dot-bounce dot-bounce-1"></div>
                <div class="w-[8px] h-[8px] bg-[#2E6DF8] rounded-full dot-bounce dot-bounce-2"></div>
                <div class="w-[8px] h-[8px] bg-[#2E6DF8] rounded-full dot-bounce dot-bounce-3"></div>
            </div>

        </div>
    </div>

    @* ── Final Ekran (2 saniye sonra) ── *@
    <div x-show="ready"
         x-transition:enter="transition ease-out duration-400"
         x-transition:enter-start="opacity-0 translate-y-3"
         x-transition:enter-end="opacity-100 translate-y-0"
         class="box-border w-full max-w-[420px] bg-white border border-[#E2EAF5] shadow-[0_4px_24px_rgba(0,86,179,0.10)] rounded-[20px] overflow-hidden flex flex-col">

        @* Kart başlığı — mavi gradient *@
        <div class="box-border flex justify-between items-center px-4 py-3 shrink-0 bg-linear-to-br from-[#0041C2] to-[#006EFF] border-b border-white/[0.15]">
            <div class="flex flex-col gap-0">
                <span class="font-[Poppins] font-bold text-[13px] leading-5 text-white">
                    Kredi Güven Raporu™
                </span>
                <span class="font-[Poppins] font-light text-[10px] leading-[15px] text-white/75">
                    Findeks destekli • @DateTime.Now.ToString("dd.MM.yyyy")
                </span>
            </div>
            <img src="~/images/IKLogo-blue.svg" alt="İnteraktif Kredi"
                 class="w-[70px] h-[25px] object-contain opacity-85"
                 style="filter:brightness(0) invert(1);">
        </div>

        @* İçerik alanı *@
        <div class="flex flex-col items-center px-5 pt-8 pb-8 gap-9">

            @* Yeşil daire + check ikonu *@
            <div class="flex flex-col items-center gap-3 w-full">
                <div class="w-[80px] h-[80px] bg-[rgba(34,197,94,0.15)] rounded-full flex items-center justify-center shrink-0">
                    <img src="~/icons/green/check-circle.svg" width="40" height="40" alt="">
                </div>
                <h2 class="font-[Poppins] font-semibold text-[22px] leading-[33px] text-center text-[#003F75] m-0">
                    Raporun Hazır!
                </h2>
                <p class="font-[Poppins] font-normal text-[14px] leading-[22px] text-center text-[#739FCC] m-0">
                    Kredi notun hesaplandı ve sana özel teklifler belirlendi
                </p>
            </div>

            @* Butonlar *@
            <div class="flex flex-col items-center gap-[12px] w-full">

                <a href="/KrediRaporlari"
                   class="box-border flex flex-row justify-between items-center px-6 w-full h-[77px] bg-linear-to-r from-[#0056B3] to-[#2E6DF8] rounded-[59px] no-underline">
                    <span class="font-[Poppins] font-semibold text-[15px] leading-[22px] text-white flex-1 text-center">
                        Kredi Güven Raporunu Görüntüle
                    </span>
                    <img src="~/icons/white/chevron-right.svg" width="20" height="20" alt="">
                </a>

                <a href="/SanaOzelTeklifler"
                   class="box-border flex justify-center items-center w-full h-[57px] border border-[#D1DDF5] rounded-[59px] no-underline">
                    <span class="font-[Poppins] font-medium text-[15px] text-[#0056B3]">
                        Tüm Teklifleri Gör
                    </span>
                </a>

                <a href="/Anasayfa"
                   class="box-border flex justify-center items-center w-full h-[57px] border border-[#D1DDF5] rounded-[59px] no-underline">
                    <span class="font-[Poppins] font-medium text-[15px] text-[#0056B3]">
                        Anasayfa
                    </span>
                </a>

                <button hx-get="/KrediBasvurusu?handler=Step1"
                        hx-target="#wizard-container"
                        hx-swap="innerHTML"
                        class="flex flex-row items-center gap-2 bg-transparent border-none cursor-pointer p-0 mt-2">
                    <img src="~/icons/slate/chevron-right.svg" width="14" height="14" alt="">
                    <span class="font-[Poppins] font-normal text-[13px] leading-5 text-[#739FCC]">
                        Yeni Başvuru Yap
                    </span>
                </button>

            </div>

        </div>
    </div>

</div>
