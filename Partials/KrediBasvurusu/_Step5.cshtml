@* ══════════════════════════════════════
   ADIM 5 — Kredi Profili Netleştiriliyor
══════════════════════════════════════ *@
<style>
    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .fade-in { animation: fadeSlideIn 0.45s ease forwards; }
</style>

<div class="box-border w-full max-w-[420px] bg-white border border-[#E2EAF5] rounded-[20px] overflow-hidden flex flex-col">

    @* Kart başlığı — sadece logo *@
    <div class="box-border flex justify-center items-center px-4 h-[50px] border-b border-black/[0.08] shrink-0">
        <img src="~/images/IKLogo-blue.svg" width="70" height="25" alt="İnteraktif Kredi" class="object-contain">
    </div>

    @* İlerleme çubuğu *@
    <div class="flex flex-col px-6 pt-5 gap-2 shrink-0">
        <div class="flex flex-row gap-1 w-full">
            <div class="flex-1 h-[6px] bg-[#006EFF] rounded-full"></div>
            <div class="flex-1 h-[6px] bg-[#006EFF] rounded-full"></div>
            <div class="flex-1 h-[6px] bg-[#D9D9D9] rounded-full"></div>
        </div>
    </div>

    @* İçerik alanı *@
    <div class="flex flex-col items-center px-6 pb-8">

        @* Yeşil onay ikonu *@
        <div class="mt-6 relative w-[80px] h-[80px] shrink-0">
            <div class="absolute -inset-[2px] bg-[rgba(70,202,136,0.15)] opacity-50 rounded-full"></div>
            <div class="absolute inset-[10px] bg-[rgba(70,202,136,0.25)] rounded-full"></div>
            <div class="absolute inset-[18px] bg-[#46CA88] rounded-full flex items-center justify-center">
                <img src="~/icons/white/check.svg" width="22" height="16" alt="">
            </div>
        </div>

        @* Başlık *@
        <h2 class="mt-5 font-[Poppins] font-medium text-[18px] leading-[27px] text-center text-black m-0">
            Kredi profilini netleştiriyoruz
        </h2>

        @* Madde listesi — CSS animation-delay ile sıralı beliriyor *@
        <div class="mt-5 w-full flex flex-col gap-4">

            <div class="flex items-center gap-3 opacity-0 fade-in" style="animation-delay: 0.3s;">
                <div class="w-8 h-8 shrink-0 rounded-full bg-[rgba(70,202,136,0.15)] flex items-center justify-center">
                    <img src="~/icons/green/check.svg" width="16" height="12" alt="">
                </div>
                <span class="font-[Poppins] font-light text-[14px] leading-[21px] text-black">
                    Bilgilerin değerlendiriliyor.
                </span>
            </div>

            <div class="flex items-center gap-3 opacity-0 fade-in" style="animation-delay: 1.1s;">
                <div class="w-8 h-8 shrink-0 rounded-full bg-[rgba(70,202,136,0.15)] flex items-center justify-center">
                    <img src="~/icons/green/check.svg" width="16" height="12" alt="">
                </div>
                <span class="font-[Poppins] font-light text-[14px] leading-[21px] text-black">
                    Bankaların kredi kriterleriyle eşleştiriliyor.
                </span>
            </div>

            <div class="flex items-center gap-3 opacity-0 fade-in" style="animation-delay: 1.9s;">
                <div class="w-8 h-8 shrink-0 rounded-full bg-[rgba(70,202,136,0.15)] flex items-center justify-center">
                    <img src="~/icons/green/check.svg" width="16" height="12" alt="">
                </div>
                <span class="font-[Poppins] font-light text-[14px] leading-[21px] text-black">
                    Sana uygun kredi senaryoları hazırlanıyor.
                </span>
            </div>

        </div>

        @* Ödemeni Tamamla butonu — en son beliriyor *@
        <button hx-get="/KrediBasvurusu?handler=Step6"
                hx-target="#wizard-container"
                hx-swap="innerHTML"
                class="mt-6 w-full h-[54px] bg-linear-to-r from-[#0056B3] to-[#2E6DF8] rounded-[59px] border-none cursor-pointer font-[Poppins] font-semibold text-[15px] text-white opacity-0 fade-in"
                style="animation-delay: 2.8s;">
            Ödemeni Tamamla
        </button>

    </div>
</div>
