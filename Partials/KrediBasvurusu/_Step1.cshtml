@* ══════════════════════════════════════
   ADIM 1 — Giriş Kartı
══════════════════════════════════════ *@
<div class="w-full max-w-[420px] bg-white border border-[#E2EAF5] rounded-[24px] overflow-hidden flex flex-col">

    @* Kart başlığı — Step2 ile aynı yapı *@
    <div class="box-border flex justify-between items-center px-4 py-3 h-[57px] border-b border-black/[0.08] shrink-0">
        <div class="w-8"></div>
        <img src="~/images/IKLogo-blue.svg" width="70" height="25" alt="İnteraktif Kredi" class="object-contain">
        <button type="button"
        onclick="showKrediConfirm()"
        class="w-11 h-11 rounded-full flex items-center justify-center border-none bg-transparent cursor-pointer p-0">
    <img src="~/icons/slate/x-close.svg" width="20" height="20" alt="">
</button>
    </div>

    @* Başlık ve alt başlık *@
    <div class="px-6 pt-6 flex flex-col gap-2">
        <h2 class="font-[Poppins] font-semibold text-[20px] leading-8 text-center text-[#003F75] m-0">
            Senin için en doğru finansal rotayı çizelim
        </h2>
        <p class="font-[Poppins] font-[250] text-[14px] leading-[21px] text-center text-[#739FCC] m-0">
            Birkaç kısa soruyla ihtiyacını anlayalım
        </p>
    </div>

    @* Seçim butonları *@
    <div class="px-6 mt-6 flex flex-col gap-3">

        <button hx-get="/KrediBasvurusu?handler=Step2"
                hx-target="#wizard-container"
                hx-swap="innerHTML"
                class="flex items-center px-4 py-4 gap-3 w-full bg-[linear-gradient(135deg,#0056B3_0%,#2E6DF8_100%)] rounded-[15px] border-none cursor-pointer shadow-[0_4px_14px_rgba(0,86,179,0.25)]">
            <div class="w-[50px] h-[50px] flex items-center justify-center shrink-0 bg-white/20 rounded-[12px]">
                <img src="~/icons/black/coins-hand-light.svg" width="28" height="28" alt="" style="filter:brightness(0) invert(1);">
            </div>
            <span class="font-[Poppins] font-semibold text-[15px] leading-[22px] text-white flex-1 text-left">
                Hemen krediye ihtiyacım var
            </span>
        </button>

        <button hx-get="/KrediBasvurusu?handler=Step2"
                hx-target="#wizard-container"
                hx-swap="innerHTML"
                class="flex items-center px-4 py-4 gap-3 w-full bg-[linear-gradient(135deg,#0056B3_0%,#2E6DF8_100%)] rounded-[15px] border-none cursor-pointer shadow-[0_4px_14px_rgba(0,86,179,0.25)]">
            <div class="w-[50px] h-[50px] flex items-center justify-center shrink-0 bg-white/20 rounded-[12px]">
                <img src="~/icons/black/user-check.svg" width="28" height="28" alt="" style="filter:brightness(0) invert(1);">
            </div>
            <span class="font-[Poppins] font-semibold text-[15px] leading-[22px] text-white flex-1 text-left">
                Sadece kredi profilimi öğrenmek istiyorum
            </span>
        </button>

    </div>

    @* Bilgi notu *@
    <div class="px-6 mt-5 pb-7">
        <p class="font-[Poppins] font-normal text-[11px] leading-[17px] text-center text-[#A8BFDA] m-0">
            Bu bilgiler kredi notunu etkilemez.<br>
            Sadece sana özel öneriler sunmamıza yardımcı olur.
        </p>
    </div>

</div>
