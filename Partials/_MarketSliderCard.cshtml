@model MyApp.Web.ViewModels.MarketSliderCardViewModel
@{ Layout = null; }
@{
    var clampedPercent = Math.Clamp(Model.SliderPercent, 0, 100);
}

<div x-data="{ pos: 50 }"
     x-init="setTimeout(() => pos = @clampedPercent, 60)"
     class="relative w-full bg-white rounded-b-2xl overflow-hidden"
     style="height: 162px;">

    @* Badge — thumb ile hizalı, animasyonlu *@
    <div :style="`position: absolute; top: 18px; display: flex; align-items: center; border-radius: 9999px; padding: 8px 20px; background-color: @Model.StatusBgColor; left: calc(16px + (100% - 32px) * ${pos} / 100); transform: translateX(-50%); transition: left 0.8s cubic-bezier(0.4,0,0.2,1); white-space: nowrap;`">
        <span class="font-['Poppins'] text-[15px] font-semibold leading-[22px]"
              style="color: @Model.StatusTextColor;">@Model.StatusLabel</span>
    </div>

    @* Slider — left:16px right:16px, top:78px *@
    <div class="absolute" style="left: 16px; right: 16px; top: 78px;">
        <div class="relative w-full rounded-full" style="height: 20px; background: linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%);">
            <div class="absolute rounded-full bg-white border border-[#E5E7EB]"
                 :style="`width: 10px; height: 28px; top: -4px; left: calc(${pos}% - 5px); transition: left 0.8s cubic-bezier(0.4,0,0.2,1); box-shadow: 0px 4px 6px -1px rgba(0,0,0,0.1), 0px 2px 4px -2px rgba(0,0,0,0.1);`"></div>
        </div>
        <div class="flex justify-between mt-2 px-1">
            <span class="font-['Poppins'] text-[11px] font-normal leading-[16px]" style="color: #122B62; opacity: 0.75;">@Model.LeftLabel</span>
            <span class="font-['Poppins'] text-[11px] font-normal leading-[16px]" style="color: #2E6DF8; opacity: 0.75;">@Model.MiddleLabel</span>
            <span class="font-['Poppins'] text-[11px] font-normal leading-[16px]" style="color: #37C6B3; opacity: 0.75;">@Model.RightLabel</span>
        </div>
    </div>

    @* AI etiketi *@
    <div class="absolute flex items-center gap-1.5" style="left: 16px; top: 130px;">
        <img src="/icons/primary/sparkle-ai.svg" width="12" height="12" alt="">
        <span class="font-['Poppins'] italic text-[12px] font-normal leading-[18px] text-[#2E6DF8]">@Model.AiText</span>
    </div>

</div>
