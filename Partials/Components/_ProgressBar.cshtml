@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MyApp.Web.ViewModels.Components.ProgressBarViewModel
@{ Layout = null; }

<div style="display:flex; flex-direction:column; align-items:flex-start; padding:12px 8px 0px; gap:8px; width:567px; height:64px;">

    <div style="position:relative; width:551px; height:20px; border-radius:9999px; flex:none; order:0; align-self:stretch; flex-grow:0;"
         role="progressbar"
         aria-valuemin="0"
         aria-valuemax="@Model.Max"
         aria-valuenow="@Model.Value">

        <div style="position:absolute; width:551px; height:20px; left:0; top:0; background:linear-gradient(90deg, #122B62 0%, #2E6DF8 50%, #36FC99 100%); border-radius:9999px;"></div>

        <div style="position:absolute; width:10px; height:25px; top:-2.5px; left:@(Model.Value * 100 / Model.Max)%; background:#FFFFFF; box-shadow:0px 1px 4px rgba(0,0,0,0.2); border-radius:6px;"></div>
    </div>

    <div style="display:flex; flex-direction:row; justify-content:space-between; align-items:flex-start; padding:0px 24px; width:551px; height:12px; flex:none; order:1; align-self:stretch; flex-grow:0;">
        <span style="font-family:'Poppins'; font-weight:400; font-size:8px; line-height:12px; color:#122B62; opacity:0.75;">@Model.LeftLabel</span>
        <span style="font-family:'Poppins'; font-weight:400; font-size:8px; line-height:12px; color:#2E6DF8; opacity:0.75;">@Model.MidLabel</span>
        <span style="font-family:'Poppins'; font-weight:400; font-size:8px; line-height:12px; color:#37C6B3; opacity:0.75;">@Model.RightLabel</span>
    </div>

</div>
