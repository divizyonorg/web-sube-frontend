@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MyApp.Web.ViewModels.Components.DropdownMenuViewModel
@{ Layout = null; }

<div class="flex flex-col items-start px-[25px] pt-[25px] pb-[25px] gap-4 w-full bg-white border border-[#E5E7EB] rounded-[14px]">

    @* Başlık satırı — spec: icon absolute left:0 top:3.5px, title absolute left:28px top:1px *@
    <div class="relative w-full h-[27px]">
        <div class="absolute left-0 top-[3.5px] w-5 h-5">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1.67" y="1.67" width="16.66" height="16.66" stroke="#0056B3" stroke-width="1.67"/>
                <rect x="7.58" y="5.83" width="4.84" height="5" stroke="#0056B3" stroke-width="1.67"/>
                <line x1="10" y1="14.17" x2="10" y2="14.17" stroke="#0056B3" stroke-width="1.67" stroke-linecap="round"/>
            </svg>
        </div>
        <span class="absolute left-7 top-[1px] font-[Poppins] font-semibold text-[18px] leading-[27px] text-[#101828]">@Model.Title</span>
    </div>

    @* Accordion öğe listesi — spec: gap:8px *@
    <div class="flex flex-col gap-2 w-full">
        @foreach (var item in Model.Items)
        {
            <div x-data="{ open: false }" class="border border-[#F3F4F6] rounded-[14px] p-[1px] w-full">

                @* Spec: padding:16px 20px, height:56px, justify-between *@
                <button type="button" @@click="open = !open"
                        class="flex flex-row justify-between items-center px-5 py-4 h-[56px] w-full">
                    <div class="flex flex-row items-start">
                        <span class="font-[Poppins] font-medium text-[16px] leading-[24px] text-[#1E2939]">@item.Question</span>
                    </div>
                    <div class="w-5 h-5 flex-shrink-0 transition-all"
                         :class="open ? 'rotate-180' : ''">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M5 7.5L10 12.5L15 7.5" stroke="#0056B3" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </button>

                @if (!string.IsNullOrEmpty(item.Answer))
                {
                    <div x-show="open" x-cloak x-transition
                         class="px-5 pb-4 font-[Poppins] text-sm leading-6 text-gray-500">
                        @item.Answer
                    </div>
                }
            </div>
        }
    </div>

</div>
