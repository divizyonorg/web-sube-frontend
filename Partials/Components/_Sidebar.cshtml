@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MyApp.Web.ViewModels.Components.SidebarViewModel
@{ Layout = null; }

<style>
    /* Sidebar genişlik geçişi */
    .sb-wrap  { width: 260px; transition: width 0.2s ease; }
    .sb-mini  { width: 72px; }

    .sb-inner { width: 259px; transition: width 0.2s ease; }
    .sb-mini .sb-inner { width: 71px; }

    /* Toggle butonu hizalaması */
    .sb-toggle { padding: 20px 20px 8px 219px; width: 259px; }
    .sb-mini .sb-toggle { padding: 20px 25.5px 8px; width: 71px; justify-content: center; }

    /* Search — mini'de gizle */
    .sb-search { display: flex; }
    .sb-mini .sb-search { display: none; }

    /* Nav linkleri */
    .sb-link-full { display: flex; }
    .sb-mini .sb-link-full { display: none; }

    .sb-link-icon { display: none; }
    .sb-mini .sb-link-icon { display: flex; }

    /* VIP kartı — mini'de gizle */
    .sb-vip { display: flex; }
    .sb-mini .sb-vip { display: none; }

    /* Tema toggle — expanded versiyonu */
    .sb-theme-full { display: flex; }
    .sb-mini .sb-theme-full { display: none; }

    /* Tema toggle — mini versiyonu */
    .sb-theme-mini { display: none; }
    .sb-mini .sb-theme-mini { display: flex; }
</style>

<div x-data="{ expanded: true, theme: 'light' }"
     :class="expanded ? 'sb-wrap' : 'sb-wrap sb-mini'"
     class="sb-wrap"
     style="box-sizing:border-box; height:100%; flex-shrink:0; overflow:hidden;
            background:rgba(255,255,255,0.00001);
            border-right:1px solid rgba(46,109,248,0.25);
            box-shadow:2px 0px 12px rgba(0,0,0,0.06);">

    <div class="sb-inner"
         style="display:flex; flex-direction:column; align-items:flex-start; padding:0;
                height:100%; background:#E6F7FF; overflow:hidden;">

        @* ── Collapse toggle ──────────────────────────────────── *@
        <button type="button"
                @@click="expanded = !expanded"
                class="sb-toggle"
                style="display:flex; flex-direction:column; align-items:flex-start; height:56px;
                       border-radius:14px; background:transparent; border:none; cursor:pointer;
                       box-sizing:border-box; flex-shrink:0;">
            <img src="~/icons/dark/layout-alt-02.svg" width="20" height="20" alt="">
        </button>

        @* ── Search ───────────────────────────────────────────── *@
        <div class="sb-search"
             style="flex-direction:column; align-items:flex-start;
                    padding:0 12px; width:259px; height:42.89px; flex-shrink:0;">
            <div style="display:flex; flex-direction:row; align-items:center;
                        padding:8px 12px; gap:8px; width:235px; height:34.89px;
                        background:#FFFFFF; border:1px solid #DCE3FB;
                        border-radius:9999px; box-sizing:border-box;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                     xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
                    <circle cx="6.5" cy="6.5" r="4.5" stroke="#7A94B8" stroke-width="1.333"/>
                    <path d="M10.5 10.5L13.5 13.5" stroke="#7A94B8" stroke-width="1.333" stroke-linecap="round"/>
                </svg>
                <input type="text"
                       placeholder="@Model.SearchPlaceholder"
                       style="background:transparent; border:none; outline:none;
                              font-family:'Poppins'; font-weight:400; font-size:13px;
                              line-height:17px; color:#7A94B8; width:100%;" />
            </div>
        </div>

        @* ── Navigation ───────────────────────────────────────── *@
        <nav style="display:flex; flex-direction:column; align-items:flex-start;
                    padding:4px 8px; gap:2px; width:100%; flex:1 1 0; overflow-y:auto; overscroll-behavior:contain;">
            @foreach (var item in Model.Items)
            {
                var isActive    = item.IsActive;
                var iconVariant = isActive ? "white" : "dark";

                var fullStyle = isActive
                    ? "flex-direction:row;align-items:center;padding:10px 12px;gap:12px;width:243px;height:38px;background:linear-gradient(90deg,#0056B3 0%,#2E6DF8 100%);box-shadow:0px 1px 3px rgba(0,0,0,0.1),0px 1px 2px -1px rgba(0,0,0,0.1);border-radius:14px;text-decoration:none;box-sizing:border-box;"
                    : "flex-direction:row;align-items:center;padding:10px 12px;gap:12px;width:243px;height:38px;border-radius:14px;text-decoration:none;box-sizing:border-box;";

                var iconStyle = isActive
                    ? "flex-direction:row;justify-content:center;align-items:center;padding:10px 18.5px;width:55px;height:38px;background:linear-gradient(90deg,#0056B3 0%,#2E6DF8 100%);box-shadow:0px 1px 3px rgba(0,0,0,0.1),0px 1px 2px -1px rgba(0,0,0,0.1);border-radius:14px;text-decoration:none;box-sizing:border-box;"
                    : "flex-direction:row;justify-content:center;align-items:center;padding:10px 18.5px;width:55px;height:38px;border-radius:14px;text-decoration:none;box-sizing:border-box;";

                var labelStyle = isActive
                    ? "font-family:'Poppins';font-weight:600;font-size:13.5px;line-height:18px;color:#FFFFFF;white-space:nowrap;"
                    : "font-family:'Poppins';font-weight:400;font-size:13.5px;line-height:18px;color:#003F75;white-space:nowrap;";

                @* Expanded link — ikon + etiket *@
                <a href="@item.Href" class="sb-link-full" style="@fullStyle">
                    <img src="~/icons/@(iconVariant)/@(item.IconFile).svg"
                         width="18" height="18" alt="" style="flex-shrink:0;display:block;">
                    <span style="@labelStyle">@item.Label</span>
                </a>

                @* Mini link — yalnızca ikon *@
                <a href="@item.Href" class="sb-link-icon" style="@iconStyle">
                    <img src="~/icons/@(iconVariant)/@(item.IconFile).svg"
                         width="18" height="18" alt="" style="flex-shrink:0;display:block;">
                </a>
            }
        </nav>

        @* ── VIP Kartı ────────────────────────────────────────── *@
        <div class="sb-vip"
             style="flex-direction:column;align-items:flex-start;
                    padding:0 8px;width:259px;height:116.19px;flex-shrink:0;">
            <div style="position:relative;width:243px;height:108.19px;
                        background:linear-gradient(135deg,#1B4092 0%,#2E6DF8 100%);
                        border-radius:14px;overflow:hidden;box-sizing:border-box;align-self:stretch;">

                <div style="position:absolute;display:flex;flex-direction:row;align-items:center;
                            gap:8px;width:219px;height:16px;left:12px;top:12px;">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                         xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
                        <path d="M1.33 11.33L4 4l4 4 4-4 2.67 7.33z"
                              stroke="#FFD700" stroke-width="1.33"
                              stroke-linejoin="round" stroke-linecap="round"/>
                        <path d="M3.33 14h9.34" stroke="#FFD700" stroke-width="1.33" stroke-linecap="round"/>
                    </svg>
                    <span style="font-family:'Poppins';font-weight:700;font-size:12px;line-height:16px;color:#FFFFFF;">
                        @Model.VipCard.Title
                    </span>
                </div>

                <p style="position:absolute;width:219px;left:12px;top:32px;margin:0;
                          font-family:'Poppins';font-weight:300;font-size:11px;
                          line-height:14px;color:rgba(255,255,255,0.75);">
                    @Model.VipCard.Description
                </p>

                <a href="@Model.VipCard.ButtonHref"
                   style="position:absolute;display:flex;align-items:center;justify-content:center;
                          width:219px;height:27.59px;left:12px;top:68.59px;
                          background:#FFFFFF;border-radius:10px;text-decoration:none;">
                    <span style="font-family:'Poppins';font-weight:600;font-size:12px;
                                 line-height:16px;color:#0056B3;">
                        @Model.VipCard.ButtonText
                    </span>
                </a>

                <svg width="40" height="40" viewBox="0 0 40 40" fill="none"
                     xmlns="http://www.w3.org/2000/svg"
                     style="position:absolute;left:195px;top:8px;opacity:0.1;">
                    <path d="M3.33 28.33L10 10l10 10 10-10 6.67 18.33z"
                          stroke="#FFFFFF" stroke-width="3.33"
                          stroke-linejoin="round" stroke-linecap="round"/>
                    <path d="M8.33 35h23.34" stroke="#FFFFFF" stroke-width="3.33" stroke-linecap="round"/>
                </svg>
            </div>
        </div>

        @* ── Tema değiştirici — expanded ──────────────────────── *@
        <div class="sb-theme-full"
             style="flex-direction:column;align-items:flex-start;
                    padding:9px 12px 0;width:259px;height:47px;
                    border-top:1px solid rgba(46,109,248,0.1);
                    box-sizing:border-box;flex-shrink:0;">
            <div style="display:flex;flex-direction:row;align-items:center;padding:3px;gap:2px;
                        width:235px;height:30px;background:#DCE3FB;border-radius:9999px;align-self:stretch;">
                <button type="button"
                        @@click="theme = 'light'"
                        :style="{ background: theme==='light' ? '#FFFFFF' : 'transparent',
                                  boxShadow: theme==='light' ? '0px 1px 3px rgba(0,0,0,0.1),0px 1px 2px -1px rgba(0,0,0,0.1)' : 'none' }"
                        style="display:flex;justify-content:center;align-items:center;
                               padding:5px 49.75px;width:113.5px;height:24px;
                               border-radius:9999px;border:none;cursor:pointer;
                               box-sizing:border-box;flex-grow:1;
                               transition:background 0.15s,box-shadow 0.15s;">
                    <img src="~/icons/sun/sun.svg" width="14" height="14" alt="" style="display:block;">
                </button>
                <button type="button"
                        @@click="theme = 'dark'"
                        :style="{ background: theme==='dark' ? '#FFFFFF' : 'transparent',
                                  boxShadow: theme==='dark' ? '0px 1px 3px rgba(0,0,0,0.1),0px 1px 2px -1px rgba(0,0,0,0.1)' : 'none' }"
                        style="display:flex;justify-content:center;align-items:center;
                               padding:5px 49.75px;width:113.5px;height:24px;
                               border-radius:9999px;border:none;cursor:pointer;
                               box-sizing:border-box;flex-grow:1;
                               transition:background 0.15s,box-shadow 0.15s;">
                    <img src="~/icons/moon/moon-01.svg" width="14" height="14" alt="" style="display:block;">
                </button>
            </div>
        </div>

        @* ── Tema değiştirici — mini ───────────────────────────── *@
        <div class="sb-theme-mini"
             style="flex-direction:row;justify-content:center;align-items:flex-start;
                    padding:8px 13.5px;width:71px;height:47px;
                    border-top:1px solid rgba(46,109,248,0.1);
                    box-sizing:border-box;flex-shrink:0;">
            <div style="display:flex;flex-direction:row;align-items:center;padding:3px;gap:2px;
                        width:44px;height:30px;background:#DCE3FB;border-radius:9999px;">
                <button type="button"
                        @@click="theme = 'light'"
                        :style="{ background: theme==='light' ? '#FFFFFF' : 'transparent',
                                  boxShadow: theme==='light' ? '0px 1px 3px rgba(0,0,0,0.1),0px 1px 2px -1px rgba(0,0,0,0.1)' : 'none' }"
                        style="display:flex;justify-content:center;align-items:center;
                               height:24px;border-radius:9999px;border:none;cursor:pointer;
                               flex:1;transition:background 0.15s,box-shadow 0.15s;">
                    <img src="~/icons/sun/sun.svg" width="12" height="12" alt="" style="display:block;">
                </button>
                <button type="button"
                        @@click="theme = 'dark'"
                        :style="{ background: theme==='dark' ? '#FFFFFF' : 'transparent',
                                  boxShadow: theme==='dark' ? '0px 1px 3px rgba(0,0,0,0.1),0px 1px 2px -1px rgba(0,0,0,0.1)' : 'none' }"
                        style="display:flex;justify-content:center;align-items:center;
                               height:24px;border-radius:9999px;border:none;cursor:pointer;
                               flex:1;transition:background 0.15s,box-shadow 0.15s;">
                    <img src="~/icons/moon/moon-01.svg" width="12" height="12" alt="" style="display:block;">
                </button>
            </div>
        </div>

    </div>
</div>
