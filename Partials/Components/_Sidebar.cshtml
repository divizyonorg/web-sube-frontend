@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MyApp.Web.ViewModels.Components.SidebarViewModel
@{ Layout = null; }

<style>
    /* Sidebar genişlik geçişi */
    .sb-wrap  { width: 260px; transition: width 0.2s ease; }
    .sb-mini  { width: 72px; }

    .sb-inner { transition: width 0.2s ease; }
    .sb-mini .sb-inner { width: 71px; }

    /* Ok butonu — search satırında, mobilde gizli */
    .sb-toggle-arrow { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    @@media (max-width: 767px) { .sb-toggle-arrow { display: none !important; } }

    /* Search pill — mini'de gizle, arrow satırda kalır */
    .sb-search-pill { display: flex; flex: 1; min-width: 0; }
    .sb-mini .sb-search-pill { display: none; }

    /* Toggle satırı — mini modda ikon nav ile hizala */
    .sb-mini .sb-toggle-row { justify-content: center; }

    /* Nav linkleri */
    .sb-link-full { display: flex; }
    .sb-mini .sb-link-full { display: none; }

    .sb-link-icon { display: none; }
    .sb-mini .sb-link-icon { display: flex; }

    /* VIP kartı — mini'de gizle */
    .sb-vip { display: flex; }
    .sb-mini .sb-vip { display: none; }

    /* Mobil kapatma butonu */
    .sb-close-mobile { display: none; }

    /* Yatay scrollbar engelle */
    .sb-wrap, .sb-inner, .sb-inner nav { overflow-x: hidden; }

    /* Active state — CSS sınıfı ile yönetilir (HTMX navigasyonu sonrası JS günceller) */
    .sb-nav-item.is-active {
        background: rgba(0, 86, 179, 0.08) !important;
        box-shadow: none !important;
    }
    .sb-nav-item.is-active:hover {
        background: rgba(0, 86, 179, 0.13) !important;
    }
    .sb-nav-item:not(.is-active) {
        background: transparent !important;
        box-shadow: none !important;
    }
    .sb-nav-item:not(.is-active):hover {
        background: rgba(0, 86, 179, 0.14) !important;
        box-shadow: none !important;
    }
    .sb-nav-item.is-active .sb-nav-label {
        font-weight: 600 !important;
        color: #0056B3 !important;
    }
    .sb-nav-item:not(.is-active) .sb-nav-label {
        font-weight: 400 !important;
        color: #003F75 !important;
    }
    .sb-nav-item:not(.is-active):hover .sb-nav-label {
        font-weight: 600 !important;
        color: #0056B3 !important;
    }
    .sb-nav-item.is-active img { filter: none; }
    .sb-nav-item:not(.is-active) img { filter: none; }
    .sb-nav-item:not(.is-active):hover img { filter: none; }
    .sb-kredi-btn:hover { background: #004494 !important; }
</style>

<div x-data="{ expanded: localStorage.getItem('sb-expanded') !== 'false', theme: 'light' }"
     :class="expanded ? 'sb-wrap' : 'sb-wrap sb-mini'"
     class="sb-wrap"
     style="position:relative; box-sizing:border-box; height:100%; flex-shrink:0; overflow:visible;
            background:rgba(255,255,255,0.00001);
            box-shadow:2px 0px 12px rgba(0,0,0,0.06);">

    <div class="sb-inner w-full"
         style="display:flex; flex-direction:column; align-items:flex-start; padding:12px 0 0;
                height:100%; background:#E6F7FF; overflow:hidden;">

        @* ── Search + Toggle Arrow ─────────────────────────────── *@
        <div class="sb-toggle-row"
             style="display:flex; flex-direction:row; align-items:center;
                    padding:0 10px; gap:6px; width:100%; height:42.89px;
                    flex-shrink:0; box-sizing:border-box;">

            @* Search pill — mini'de gizlenir *@
            <div class="sb-search-pill"
                 style="flex-direction:row; align-items:center;
                        padding:8px 12px; gap:8px; height:34.89px;
                        background:#FFFFFF; border:1px solid #DCE3FB;
                        border-radius:9999px; box-sizing:border-box;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                     xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
                    <circle cx="6.5" cy="6.5" r="4.5" stroke="#7A94B8" stroke-width="1.333"/>
                    <path d="M10.5 10.5L13.5 13.5" stroke="#7A94B8" stroke-width="1.333" stroke-linecap="round"/>
                </svg>
                <input type="text"
                       placeholder="@Model.SearchPlaceholder"
                       style="background:transparent; border:none; outline:none;
                              font-family:'Poppins'; font-weight:400; font-size:13px;
                              line-height:17px; color:#7A94B8; width:100%;" />
            </div>

            @* Toggle arrow — search barın sağında, flex ile konumlandırılmış *@
            <button type="button"
                    class="sb-toggle-arrow"
                    @@click="expanded = !expanded; localStorage.setItem('sb-expanded', expanded)"
                    style="width:34.89px; height:34.89px; border-radius:50%;
                           background:#FFFFFF; border:1px solid rgba(46,109,248,0.3);
                           box-shadow:0 1px 4px rgba(0,0,0,0.10);
                           cursor:pointer; padding:0;">
                <svg width="14" height="14" viewBox="0 0 12 12" fill="none"
                     :style="expanded ? '' : 'transform:rotate(180deg)'"
                     style="display:block; pointer-events:none; transition:transform 0.2s ease; margin:auto;">
                    <path d="M7.5 9L4.5 6L7.5 3" stroke="#0056B3" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>

        @* ── Kredi Başvurusu CTA ───────────────────────────────── *@
        <div style="padding:6px 8px 2px; width:100%; box-sizing:border-box; flex-shrink:0;">

            @* Expanded — ikon + yazı + ok *@
            <button type="button"
                    class="sb-link-full sb-kredi-btn w-full"
                    @@click="$store.krediModal.open = true; $store.layout.mobileMenuOpen = false"
                    style="flex-direction:row; align-items:center; justify-content:space-between;
                           padding:10px 12px; gap:10px; height:42px;
                           background:#0056B3;
                           border-radius:14px; border:none; cursor:pointer; box-sizing:border-box;
                           box-shadow:0 2px 8px rgba(0,86,179,0.30); transition:background 0.15s ease;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <img src="~/icons/white/loan-app.svg" width="18" height="18" alt="" style="flex-shrink:0;">
                    <span style="font-family:'Poppins'; font-weight:600; font-size:13px; line-height:18px;
                                 color:#FFFFFF; white-space:nowrap;">Kredi Başvurusu</span>
                </div>
                <img src="~/icons/white/chevron-right.svg" width="14" height="14" alt="" style="flex-shrink:0; opacity:0.8;">
            </button>

            @* Mini — yalnızca ikon *@
            <button type="button"
                    class="sb-link-icon sb-kredi-btn"
                    @@click="$store.krediModal.open = true; $store.layout.mobileMenuOpen = false"
                    style="flex-direction:row; justify-content:center; align-items:center;
                           width:55px; height:42px;
                           background:#0056B3;
                           border-radius:14px; border:none; cursor:pointer; box-sizing:border-box;
                           box-shadow:0 2px 8px rgba(0,86,179,0.30); transition:background 0.15s ease;">
                <img src="~/icons/white/loan-app.svg" width="18" height="18" alt="" style="flex-shrink:0;">
            </button>

        </div>

        @* ── Navigation ───────────────────────────────────────── *@
        <nav style="display:flex; flex-direction:column; align-items:flex-start;
                    padding:4px 8px; gap:2px; width:100%; flex:1 1 0; overflow-y:auto; overscroll-behavior:contain;">
            @foreach (var item in Model.Items)
            {
                var isActive  = item.IsActive;
                var activeClass = isActive ? "is-active" : "";

                @* Expanded link — ikon + etiket *@
                <a href="@item.Href"
                   data-href="@item.Href"
                   class="sb-link-full sb-nav-item w-full @activeClass"
                   @@click="$store.layout.mobileMenuOpen = false"
                   style="flex-direction:row;align-items:center;padding:10px 12px;gap:12px;height:38px;border-radius:14px;text-decoration:none;box-sizing:border-box;">
                    <img src="~/icons/dark/@(item.IconFile).svg"
                         width="18" height="18" alt="" style="flex-shrink:0;display:block;">
                    <span class="sb-nav-label"
                          style="font-family:'Poppins';font-size:13.5px;line-height:18px;white-space:nowrap;">@item.Label</span>
                </a>

                @* Mini link — yalnızca ikon *@
                <a href="@item.Href"
                   data-href="@item.Href"
                   class="sb-link-icon sb-nav-item @activeClass"
                   @@click="$store.layout.mobileMenuOpen = false"
                   style="flex-direction:row;justify-content:center;align-items:center;padding:10px 18.5px;width:55px;height:38px;border-radius:14px;text-decoration:none;box-sizing:border-box;">
                    <img src="~/icons/dark/@(item.IconFile).svg"
                         width="18" height="18" alt="" style="flex-shrink:0;display:block;">
                </a>
            }
        </nav>

        @* ── VIP Kartı ────────────────────────────────────────── *@
        <div class="sb-vip w-full"
             style="flex-direction:column;align-items:flex-start;
                    padding:0 8px;height:116.19px;flex-shrink:0;">
            <div style="position:relative;height:108.19px;
                        background:linear-gradient(135deg,#1B4092 0%,#2E6DF8 100%);
                        border-radius:14px;overflow:hidden;box-sizing:border-box;align-self:stretch;">

                <div style="position:absolute;display:flex;flex-direction:row;align-items:center;
                            gap:8px;width:219px;height:16px;left:12px;top:12px;">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                         xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
                        <path d="M1.33 11.33L4 4l4 4 4-4 2.67 7.33z"
                              stroke="#FFD700" stroke-width="1.33"
                              stroke-linejoin="round" stroke-linecap="round"/>
                        <path d="M3.33 14h9.34" stroke="#FFD700" stroke-width="1.33" stroke-linecap="round"/>
                    </svg>
                    <span style="font-family:'Poppins';font-weight:700;font-size:12px;line-height:16px;color:#FFFFFF;">
                        @Model.VipCard.Title
                    </span>
                </div>

                <p style="position:absolute;width:219px;left:12px;top:32px;margin:0;
                          font-family:'Poppins';font-weight:300;font-size:11px;
                          line-height:14px;color:rgba(255,255,255,0.75);">
                    @Model.VipCard.Description
                </p>

                <a href="@Model.VipCard.ButtonHref"
                   @@click="$store.layout.mobileMenuOpen = false"
                   style="position:absolute;display:flex;align-items:center;justify-content:center;
                          width:219px;height:27.59px;left:12px;top:68.59px;
                          background:#FFFFFF;border-radius:10px;text-decoration:none;">
                    <span style="font-family:'Poppins';font-weight:600;font-size:12px;
                                 line-height:16px;color:#0056B3;">
                        @Model.VipCard.ButtonText
                    </span>
                </a>

                <svg width="40" height="40" viewBox="0 0 40 40" fill="none"
                     xmlns="http://www.w3.org/2000/svg"
                     style="position:absolute;left:195px;top:8px;opacity:0.1;">
                    <path d="M3.33 28.33L10 10l10 10 10-10 6.67 18.33z"
                          stroke="#FFFFFF" stroke-width="3.33"
                          stroke-linejoin="round" stroke-linecap="round"/>
                    <path d="M8.33 35h23.34" stroke="#FFFFFF" stroke-width="3.33" stroke-linecap="round"/>
                </svg>
            </div>
        </div>


    </div>
</div>

<script>
    (function () {
        function updateSidebarActive() {
            var path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.sb-nav-item[data-href]').forEach(function (el) {
                el.classList.toggle('is-active', el.dataset.href.toLowerCase() === path);
            });
        }
        document.addEventListener('htmx:afterSettle', updateSidebarActive);
    })();
</script>
