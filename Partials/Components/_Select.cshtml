@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MyApp.Web.ViewModels.Components.SelectViewModel
@{ Layout = null; }

<div style="display:flex; flex-direction:column; gap:6px; width:100%;">

    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label for="@Model.Name"
               style="display:block; font-family:'Poppins',sans-serif; font-size:11px; font-weight:500;
                      color:#7A94B8; text-transform:uppercase; letter-spacing:0.08em;">
            @Model.Label
        </label>
    }

    <div style="position:relative; width:100%;">
        <select id="@Model.Name"
                name="@Model.Name"
                @(Model.AlpineModel != null ? Html.Raw($"x-model=\"{Model.AlpineModel}\"") : null)
                style="width:100%; padding:10px 36px 10px 12px; border:1px solid #DCE3FB; border-radius:8px;
                       font-family:'Poppins',sans-serif; font-size:13px; color:#1A1A2E; background:#FFFFFF;
                       -webkit-appearance:none; -moz-appearance:none; appearance:none;
                       cursor:pointer; outline:none; box-sizing:border-box; transition:border-color 0.15s;"
                onfocus="this.style.borderColor='#0056B3'" onblur="this.style.borderColor='#DCE3FB'">
            <option value="">@(Model.Placeholder ?? "")</option>
            @foreach (var option in Model.Options)
            {
                if (option.Value == Model.SelectedValue)
                {
                    <option value="@option.Value" selected="selected">@option.Label</option>
                }
                else
                {
                    <option value="@option.Value">@option.Label</option>
                }
            }
        </select>

        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
             style="position:absolute; right:10px; top:50%; transform:translateY(-50%); pointer-events:none;">
            <path d="M4 6L8 10L12 6" stroke="#7A94B8" stroke-width="1.5"
                  stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </div>

</div>
